---
import SEO from '../components/kb/SEO.astro';
import Header from '../components/kb/Header.astro';
import Footer from '../components/kb/Footer.astro';
import WebMcp from '../components/WebMcp.astro';
import '../styles/kb.css';

interface BreadcrumbItem {
  name: string;
  item: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  breadcrumbItems?: BreadcrumbItem[];
  faq?: FaqItem[];
  lang?: string;
  alternates?: AlternateLink[];
}

const props = Astro.props;
const lang = props.lang ?? 'en';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...props} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/logo.png" sizes="any" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <WebMcp />
  </head>
  <body class="kb-body min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
