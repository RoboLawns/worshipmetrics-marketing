---
import BrandLockup from "./BrandLockup.astro";

const APP_URL = "https://app.worshipmetrics.com";
const IOS_APP_URL = "https://apps.apple.com/us/app/worship-metrics/id6754773170";
const ANDROID_APP_URL = "https://play.google.com/store/apps/details?id=com.worshipmetrics.kiosk";
const APP_STORE_BADGE = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/homepage/Download_on_the_App_Store_Badge.svg.png";
const GOOGLE_PLAY_BADGE = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/homepage/Google_Play_Store_badge_EN.svg.png";
const year = new Date().getFullYear();

const cols = [
  {
    heading: "Stream",
    links: [
      { label: "Live Streaming", href: "/live-streaming" },
      { label: "Worship Clips", href: "/solutions/worship-clips" },
      { label: "Slides & Signage", href: "/signage-display" },
      { label: "Replace Your Stack", href: "/replace-your-stack" },
    ],
  },
  {
    heading: "People",
    links: [
      { label: "Volunteers", href: "/volunteers" },
      { label: "AV Team", href: "/av-team" },
      { label: "Team Chat", href: "/team-chat" },
      { label: "AV Club", href: "/av-club" },
    ],
  },
  {
    heading: "Plan",
    links: [
      { label: "Services", href: "/services" },
    ],
  },
  {
    heading: "Pulse",
    links: [
      { label: "Attendance", href: "/platform/attendance" },
      { label: "AV Monitoring", href: "/av-monitoring" },
    ],
  },
  {
    heading: "System",
    links: [
      { label: "Tech Manager", href: "/tech-manager" },
      { label: "System Documentation", href: "/system-documentation" },
      { label: "Integrations", href: "/integrations" },
      { label: "Worship Metrics Tablet", href: "/tablet" },
      { label: "Compare Hardware", href: "/hardware" },
    ],
  },
  {
    heading: "Support",
    links: [
      { label: "Luminos AI", href: "/luminos-ai-assistant" },
      { label: "Knowledge Base", href: "/kb" },
      { label: "Professional Services", href: "/professional-services" },
      { label: "Contact / 910-WORSHIP", href: "/contact" },
    ],
  },
  {
    heading: "Connect",
    links: [
      { label: "Signal and Sanctuary", href: "/signal-and-sanctuary" },
      { label: "Pilot Program", href: "/pilot-program" },
      { label: "Book a Call", href: "/discovery-call" },
      { label: "About", href: "/about" },
      { label: "Pricing", href: "/pricing" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms of Service", href: "/terms" },
      { label: "Returns Policy", href: "/returns" },
    ],
  },
];
---

<style>
  footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 3.5rem 1.5rem 2rem;
  }
  .footer-app-band {
    max-width: 80rem; margin: 0 auto 2rem;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(43, 127, 240, 0.25);
    background: linear-gradient(135deg, #0B0D10 0%, #1C4685 55%, #0B0D10 100%);
    box-shadow: 0 12px 36px rgba(11, 13, 16, 0.08);
  }
  .footer-app-copy p:first-child {
    font-family: var(--font-mono-brand);
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
    color: #9CC6F8; margin-bottom: 0.5rem;
  }
  .footer-app-copy h3 {
    font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 800; line-height: 1.15;
    color: #fff; margin-bottom: 0.5rem;
  }
  .footer-app-copy p:last-child {
    font-size: 0.92rem; line-height: 1.7; color: rgba(226, 232, 240, 0.82); max-width: 40rem;
  }
  .footer-app-badges {
    display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end;
  }
  .footer-app-badges a { display: inline-flex; transition: opacity 0.15s, transform 0.15s; }
  .footer-app-badges a:hover { opacity: 0.92; transform: translateY(-1px); }
  .footer-app-badges img { height: 3.5rem; width: auto; display: block; }
  .footer-inner {
    max-width: 80rem; margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr repeat(8, 1fr);
    gap: 2rem;
  }
  @media (max-width: 1200px) {
    .footer-inner { grid-template-columns: 1fr repeat(4, 1fr); }
    .brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 900px) {
    .footer-app-band { grid-template-columns: 1fr; }
    .footer-app-badges { justify-content: flex-start; }
    .footer-inner { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 639px) {
    .footer-inner { grid-template-columns: repeat(2, 1fr); }
    .footer-app-badges img { height: 3rem; }
  }

  .brand-col { display: flex; flex-direction: column; gap: 0.75rem; }
  .brand-logo { display: flex; align-items: center; text-decoration: none; }
  .brand-tag  { font-size: 0.82rem; color: #8494b0; line-height: 1.6; max-width: 18rem; }
  .brand-btns { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.25rem; }
  .brand-support { font-size: 0.78rem; color: #5a6a8a; line-height: 1.6; max-width: 18rem; }
  .brand-support a { color: var(--primary); text-decoration: none; font-weight: 600; }
  .brand-support a:hover { color: var(--primary-dark); }

  .col-heading { font-family: var(--font-mono-brand); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--primary); margin-bottom: 0.75rem; }
  .col-links   { display: flex; flex-direction: column; gap: 0.45rem; }
  .col-links a { font-size: 0.82rem; color: #8494b0; text-decoration: none; transition: color 0.15s; }
  .col-links a:hover { color: var(--primary); }

  .footer-bottom {
    max-width: 80rem; margin: 2.5rem auto 0;
    padding-top: 1.5rem; border-top: 1px solid var(--border);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
  }
  .footer-bottom p { font-size: 0.75rem; color: #8494b0; }
  .footer-bottom a { color: #8494b0; text-decoration: none; }
  .footer-bottom a:hover { color: var(--primary); }
  .footer-phone-wrap { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; }
  .footer-phone-note { color: #9aa8bf; }
</style>

<footer>
  <div class="footer-app-band">
    <div class="footer-app-copy">
      <p>WorshipMetrics apps</p>
      <h3>Keep your team aligned from anywhere your Sunday depends on.</h3>
      <p>
        Download the mobile apps for attendance workflows, volunteer coordination, and the service-day tasks that should not stay trapped at one booth computer.
      </p>
    </div>
    <div class="footer-app-badges">
      <a href={IOS_APP_URL} aria-label="Download WorshipMetrics on the App Store">
        <img src={APP_STORE_BADGE} alt="Download on the App Store" loading="lazy" decoding="async" width="120" height="40" />
      </a>
      <a href={ANDROID_APP_URL} aria-label="Get WorshipMetrics on Google Play">
        <img src={GOOGLE_PLAY_BADGE} alt="Get it on Google Play" loading="lazy" decoding="async" width="646" height="250" />
      </a>
    </div>
  </div>

  <div class="footer-inner">
    <div class="brand-col">
      <a href="/" class="brand-logo" aria-label="WorshipMetrics home">
        <BrandLockup width={142} />
      </a>
      <p class="brand-tag">Your live stream, handled. Real humans, seven days a week.</p>
      <div class="brand-btns">
        <a href={`${APP_URL}/sign-up`} class="btn-primary" style="justify-content:center;font-size:0.8rem;padding:0.5rem 1rem;" data-wm-track="cta_click" data-wm-track-label="footer_get_started_free" data-wm-track-location="footer">Get started free</a>
        <a href="/discovery-call" class="btn-outline" style="justify-content:center;font-size:0.8rem;padding:0.5rem 1rem;" data-wm-track="cta_click" data-wm-track-label="footer_book_call" data-wm-track-location="footer">Book a call</a>
      </div>
      <p class="brand-support">Need help? Submit a ticket, start a chat, or call <a href="tel:+19109677447">910-WORSHIP</a> and talk to a real person who knows the product.</p>
    </div>

    {cols.map(({ heading, links }) => (
      <div>
        <p class="col-heading">{heading}</p>
        <div class="col-links">
          {links.map(({ label, href }) => <a href={href}>{label}</a>)}
        </div>
      </div>
    ))}
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} WorshipMetrics. All rights reserved.</p>
    <p>
      <a href="mailto:paul@worshipmetrics.com">paul@worshipmetrics.com</a>
      &nbsp;&middot;&nbsp;
      <span class="footer-phone-wrap">
        <a href="tel:+19109677447">910-WORSHIP (910-967-7447)</a>
      </span>
    </p>
  </div>
</footer>
