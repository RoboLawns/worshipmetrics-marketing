---
/**
 * Lifestyle + screenshot carousel.
 * Shows the real-world context and the actual app UI side by side in one frame,
 * without cropping: screenshots render object-contain inside a fixed 16:9 stage,
 * lifestyle photos render object-cover (photos tolerate a gentle crop; UI doesn't).
 *
 * slides: { src, alt, label?, kind?: "screenshot" | "lifestyle" }
 * kind defaults to "screenshot" (object-contain). Pass eager for above-the-fold heroes.
 */
interface Slide {
  src: string;
  alt: string;
  label?: string;
  kind?: "screenshot" | "lifestyle";
}

const { slides = [], eager = false } = Astro.props as { slides: Slide[]; eager?: boolean };

const defaultLabel = (slide: Slide, index: number) =>
  slide.label ?? (slide.kind === "lifestyle" ? "In the room" : "In the app");
---

<div class="wm-carousel" data-wm-carousel>
  <div class="wm-carousel-track" data-wm-carousel-track tabindex="0" aria-roledescription="carousel">
    {slides.map((slide, index) => (
      <figure class="wm-carousel-slide" data-kind={slide.kind ?? "screenshot"} aria-label={`${index + 1} of ${slides.length}: ${defaultLabel(slide, index)}`}>
        <img
          src={slide.src}
          alt={slide.alt}
          loading={eager && index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      </figure>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button type="button" class="wm-carousel-arrow is-prev" data-wm-carousel-prev aria-label="Previous image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button type="button" class="wm-carousel-arrow is-next" data-wm-carousel-next aria-label="Next image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
      <div class="wm-carousel-tabs" role="tablist" aria-label="Choose image">
        {slides.map((slide, index) => (
          <button type="button" class:list={["wm-carousel-tab", index === 0 && "is-active"]} data-wm-carousel-tab={index} role="tab" aria-selected={index === 0 ? "true" : "false"}>
            {defaultLabel(slide, index)}
          </button>
        ))}
      </div>
    </>
  )}
</div>

<style>
  .wm-carousel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(226 232 240);
    border-radius: 1.75rem;
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    box-shadow: 0 24px 60px rgb(15 23 42 / 0.12);
  }

  .wm-carousel-track {
    display: flex;
    aspect-ratio: 16 / 9;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .wm-carousel-track::-webkit-scrollbar { display: none; }
  .wm-carousel-track:focus-visible { outline: 2px solid rgb(99 102 241); outline-offset: -2px; }

  .wm-carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .wm-carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wm-carousel-slide[data-kind="lifestyle"] img {
    object-fit: cover;
  }

  .wm-carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: none;
    border-radius: 999px;
    background: rgb(15 23 42 / 0.55);
    color: white;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.15s, background-color 0.15s;
  }
  .wm-carousel-arrow:hover { opacity: 1; background: rgb(15 23 42 / 0.8); }
  .wm-carousel-arrow svg { width: 1.1rem; height: 1.1rem; }
  .wm-carousel-arrow.is-prev { left: 0.75rem; }
  .wm-carousel-arrow.is-next { right: 0.75rem; }

  .wm-carousel-tabs {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.35rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(15 23 42 / 0.6);
    backdrop-filter: blur(6px);
    max-width: calc(100% - 1.25rem);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .wm-carousel-tabs::-webkit-scrollbar { display: none; }
  .wm-carousel-tab { flex-shrink: 0; }

  .wm-carousel-tab {
    border: none;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    background: transparent;
    color: rgb(203 213 225);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .wm-carousel-tab:hover { color: white; }
  .wm-carousel-tab.is-active { background: white; color: rgb(30 41 59); }
</style>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-wm-carousel]");

  carousels.forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-wm-carousel-track]");
    if (!track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 2) return;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-wm-carousel-tab]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-wm-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-wm-carousel-next]");

    let autoTimer: number | null = null;

    const currentIndex = () => Math.round(track.scrollLeft / track.clientWidth);

    const goTo = (index: number) => {
      const clamped = ((index % slides.length) + slides.length) % slides.length;
      track.scrollTo({ left: clamped * track.clientWidth, behavior: "smooth" });
    };

    const syncTabs = () => {
      const index = currentIndex();
      tabs.forEach((tab, tabIndex) => {
        tab.classList.toggle("is-active", tabIndex === index);
        tab.setAttribute("aria-selected", tabIndex === index ? "true" : "false");
      });
    };

    const stopAuto = () => {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    };

    // Gentle auto-advance so visitors discover the second slide;
    // stops permanently on any interaction.
    autoTimer = window.setInterval(() => {
      if (document.hidden) return;
      goTo(currentIndex() + 1);
    }, 5000);

    ["pointerdown", "wheel", "keydown", "touchstart"].forEach((eventName) => {
      root.addEventListener(eventName, stopAuto, { passive: true });
    });

    track.addEventListener("scroll", () => {
      window.requestAnimationFrame(syncTabs);
    }, { passive: true });

    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); goTo(currentIndex() - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); goTo(currentIndex() + 1); }
    });

    tabs.forEach((tab, index) => tab.addEventListener("click", () => goTo(index)));
    prev?.addEventListener("click", () => { stopAuto(); goTo(currentIndex() - 1); });
    next?.addEventListener("click", () => { stopAuto(); goTo(currentIndex() + 1); });
  });
</script>
