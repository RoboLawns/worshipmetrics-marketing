---
import type { IntegrationCategoryKey, IntegrationStatus } from "../../data/integrations";
import { STATUS_META } from "../../data/integrations";

interface Item {
  brand: string;
  name: string;
  status: IntegrationStatus;
  logoUrl?: string;
}

interface CategoryItem {
  key: IntegrationCategoryKey;
  title: string;
  tagline: string;
  count: number;
  items: Item[];
}

interface Props {
  categories: CategoryItem[];
}

const { categories } = Astro.props;
---

<div class="mx-auto max-w-6xl px-4 pb-20 pt-6 sm:px-6 lg:px-8" id="integrations-grid-root">
  {categories.map((category, index) => (
    <section class="pt-12" data-category-section={category.key}>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <p class="eyebrow">{String(index + 1).padStart(2, "0")}</p>
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{category.title}</h2>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">{category.tagline}</p>
        </div>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {category.items.map((item) => (
          <article
            class="card flex min-h-[170px] flex-col justify-between p-6"
            data-integration-card
            data-category={category.key}
            data-search={`${item.brand} ${item.name}`.toLowerCase()}
          >
            <div>
              {item.logoUrl && <img src={item.logoUrl} alt={item.brand} loading="lazy" decoding="async" class="mb-3 block h-auto max-h-[30px] w-auto max-w-[140px] object-contain" />}
              <p class="eyebrow !text-slate-400">{item.brand}</p>
              <h3 class="mt-2 text-lg font-bold leading-snug tracking-tight text-slate-900">{item.name}</h3>
            </div>
            <p class="mt-5 inline-flex items-center gap-2 text-[0.8rem] font-medium text-slate-600">
              <span class:list={["h-2 w-2 flex-shrink-0 rounded-full", STATUS_META[item.status].dotClass]}></span>
              <span>{STATUS_META[item.status].label}</span>
            </p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <div class="empty-state mx-auto mt-12 hidden max-w-2xl rounded-2xl border border-slate-200 bg-slate-50 p-10 text-center [&.visible]:block" id="integrations-empty-state">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">We don&apos;t have that one yet.</h2>
    <p class="mt-3 text-base leading-relaxed text-slate-600">If you run a piece of gear we haven&apos;t listed, tell us. The device catalog grows every release, and your request moves the list.</p>
    <a href="/contact" class="btn-primary mt-6">Request an integration &rarr;</a>
  </div>
</div>
