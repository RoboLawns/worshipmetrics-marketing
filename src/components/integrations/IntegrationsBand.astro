---
// LogoWall — hairline-ruled grid of partner tiles in one rounded container.
import { homepageCategoryCounts, homepageIntegrationTiles } from "../../data/integrations";
---

<section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Works with your gear</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The booth you have is the booth we support.</h2>
    </div>
    <div class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <div class="-mb-px -mr-px grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
        {homepageIntegrationTiles.map((tile) => (
          <div class="flex min-h-[120px] flex-col items-center justify-center gap-1.5 border-b border-r border-slate-200 p-4 text-center transition hover:bg-slate-50">
            {tile.logoUrl
              ? <img src={tile.logoUrl} alt={tile.brand} loading="lazy" decoding="async" class="block h-auto max-h-9 w-auto max-w-[140px] object-contain" />
              : <p class="text-base font-bold tracking-tight text-slate-900">{tile.brand}</p>}
            <p class="eyebrow !text-[0.65rem] !text-slate-400">{tile.meta}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="eyebrow mt-6 text-center">
      {homepageCategoryCounts.map(({ label, count }) => `${count} ${label}`).join(" · ")}
    </p>
  </div>
</section>
