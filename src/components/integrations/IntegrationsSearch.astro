---
import type { IntegrationCategoryKey } from "../../data/integrations";

interface CategoryItem {
  key: IntegrationCategoryKey;
  title: string;
  count: number;
}

interface Props {
  categories: CategoryItem[];
  totalDevices: number;
}

const { categories, totalDevices } = Astro.props;
---

<style>
  .pill {
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-soft);
    padding: 0.5rem 1rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .pill:hover { border-color: var(--primary-border); color: var(--primary); }
  .pill.active {
    border-color: var(--primary);
    background: var(--primary);
    color: #fff;
  }
  .pill .pill-count { opacity: 0.6; margin-left: 0.35rem; }
</style>

<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
  <div class="card p-4">
    <div class="flex flex-wrap items-center gap-4">
      <label class="flex min-w-0 flex-1 basis-60 items-center gap-3 rounded-[0.625rem] border border-slate-200 bg-slate-50 px-4 py-3">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="flex-shrink-0 text-indigo-600">
          <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
        </svg>
        <input id="integrations-search" type="search" placeholder="Search brands and devices" class="w-full border-0 bg-transparent text-sm text-slate-900 outline-none placeholder:text-slate-400" />
      </label>
      <p class="eyebrow whitespace-nowrap"><span id="integrations-visible-count">{totalDevices}</span> showing</p>
    </div>
    <div id="integrations-pills" class="mt-4 flex flex-wrap gap-2">
      <button type="button" class="pill active" data-filter="all">All <span class="pill-count">{totalDevices}</span></button>
      {categories.map(({ key, title, count }) => (
        <button type="button" class="pill" data-filter={key}>{title} <span class="pill-count">{count}</span></button>
      ))}
    </div>
  </div>
</div>
