---
interface Props {
  totalDevices: number;
  totalCategories: number;
  heroImage: string;
}
const { totalDevices, totalCategories, heroImage } = Astro.props;
---

<section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
    <div>
      <p class="eyebrow inline-flex rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
        Integrations &amp; AV services
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        The gear you own, <span class="title-accent">connected.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        We start with software that helps your team document, manage, and automate the gear you already own. When you need more than software, we&apos;re the AV integration partner that shows up &mdash; built for churches, not for enterprise budgets.
      </p>
      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <a href="/discovery-call" class="btn-primary" data-wm-track="cta_click" data-wm-track-label="integrations_hero_call" data-wm-track-location="integrations_hero">Talk about your setup</a>
        <a href="/tech-manager" class="btn-outline">Download Tech Manager</a>
      </div>
      <p class="eyebrow mt-6">{totalDevices}+ devices &middot; {totalCategories} categories &middot; Central Control</p>
    </div>
    <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
      <img src={heroImage} alt="WorshipMetrics tech support and AV integration" loading="eager" decoding="async" class="aspect-[4/3] w-full object-cover" />
    </div>
  </div>
</section>
