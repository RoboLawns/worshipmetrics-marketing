---
/**
 * Worship Metrics primary lockup — Brand Kit v1.0 (Lockup M2 + thin beat icon).
 * Geometry is locked artwork from the brand kit; never re-type the wordmark.
 * Four renditions: "on-light" (default, ink + blue), "on-dark" (near-white + blue),
 * and the mono pair — "mono-white" / "mono-ink" — where the whole lockup collapses
 * to one ink, beat included (video overlays, merch, engraving, one-colour print).
 * Min rendered width per brand guide: 140px absolute, 160px preferred.
 */
interface Props {
  variant?: "on-light" | "on-dark" | "mono-white" | "mono-ink";
  width?: number;
  class?: string;
}

const { variant = "on-light", width = 150, class: className } = Astro.props;

const BLUE = "#2B7FF0";
const INK: Record<string, { worship: string; beat: string; metrics: string }> = {
  "on-light": { worship: "#0B0D10", beat: BLUE, metrics: BLUE },
  "on-dark": { worship: "#E9EEF4", beat: BLUE, metrics: BLUE },
  "mono-white": { worship: "#FFFFFF", beat: "#FFFFFF", metrics: "#FFFFFF" },
  "mono-ink": { worship: "#0B0D10", beat: "#0B0D10", metrics: "#0B0D10" },
};
const c = INK[variant] ?? INK["on-light"];

// Brand Kit v1.0: 140px absolute minimum. Clamp and warn at build time.
const MIN_WIDTH = 140;
if (width < MIN_WIDTH && import.meta.env.DEV) {
  console.warn(`[BrandLockup] width ${width}px is below the brand minimum of ${MIN_WIDTH}px — clamping. Preferred minimum is 160px.`);
}
const renderWidth = Math.max(width, MIN_WIDTH);
const height = Math.round(renderWidth * (72 / 320));
---

<svg
  viewBox="0 14 320 72"
  width={renderWidth}
  height={height}
  role="img"
  aria-label="Worship Metrics"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <text
    x="139" y="59" text-anchor="end"
    font-family="Archivo, sans-serif" font-size="34" font-weight="800" letter-spacing="-1"
    fill={c.worship}
  >worship</text>
  <path
    d="M145 48 H151 L158.6 27.8 L167.8 64.6 L175.4 48 H181"
    fill="none" stroke={c.beat} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"
  />
  <text
    x="187" y="59" text-anchor="start"
    font-family="Archivo, sans-serif" font-size="34" font-weight="800" letter-spacing="-1"
    fill={c.metrics}
  >metrics</text>
</svg>
