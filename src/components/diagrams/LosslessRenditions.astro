---
/**
 * Lossless — two renditions, one stream.
 * Console PCM in, FLAC + AAC packaged into a single manifest,
 * each device negotiating the best it can play.
 */
const LABEL = "Diagram of a planned capability: uncompressed audio leaves the mixing console, WorshipMetrics packages a lossless FLAC track and an AAC fallback into a single stream, and each viewer's device automatically plays the best rendition it can decode.";
---

<svg
  viewBox="0 0 980 360"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="hidden h-auto w-full md:block"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Console -->
  <text x="20" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">YOUR CONSOLE</text>
  <g transform="translate(20, 106)">
    <rect x="0" y="0" width="182" height="120" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <!-- faders -->
    {[0, 1, 2, 3].map((i) => (
      <g transform={`translate(${24 + i * 36}, 24)`}>
        <rect x="0" y="0" width="18" height="56" rx="4" fill="#F2F4F7" />
        <rect x="0" y={12 + (i % 3) * 10} width="18" height="8" rx="3" fill="#2B7FF0" />
      </g>
    ))}
    <text x="24" y="102" font-family="Archivo, sans-serif" font-size="12" fill="#3F4854">Full-quality mix, untouched</text>
  </g>

  <!-- PCM arrow -->
  <path d="M206 166 H286" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" />
  <path d="M278 159 L288 166 L278 173" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="208" y="138" width="76" height="22" rx="5" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <text x="218" y="153" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SRT · PCM</text>

  <!-- Packaging -->
  <text x="298" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">PACKAGED ONCE</text>
  <rect x="806" y="330" width="154" height="22" rx="6" fill="#FEF3C7" stroke="#FCD34D" stroke-width="1.5" />
  <text x="820" y="345" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600" letter-spacing="0.8" fill="#92400E">PLANNED CAPABILITY</text>
  <g transform="translate(298, 88)">
    <rect x="0" y="0" width="238" height="156" rx="16" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <text x="20" y="30" font-family="Archivo, sans-serif" font-size="13.5" font-weight="700" fill="#0B0D10">One CMAF manifest</text>
    <!-- FLAC track -->
    <rect x="20" y="46" width="198" height="44" rx="9" fill="#0B0D10" />
    <text x="34" y="66" font-family="Archivo, sans-serif" font-size="12.5" font-weight="700" fill="#ffffff">FLAC &mdash; lossless</text>
    <text x="34" y="81" font-family="IBM Plex Mono, monospace" font-size="9" letter-spacing="0.4" fill="#6AA9F4">16-BIT / 44.1 KHZ &middot; ~0.8 MBPS</text>
    <!-- AAC track -->
    <rect x="20" y="98" width="198" height="44" rx="9" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.5" />
    <text x="34" y="118" font-family="Archivo, sans-serif" font-size="12.5" font-weight="700" fill="#0B0D10">AAC &mdash; fallback</text>
    <text x="34" y="133" font-family="IBM Plex Mono, monospace" font-size="9" letter-spacing="0.4" fill="#78828F">256 KBPS &middot; PLAYS ANYWHERE</text>
  </g>

  <!-- Split arrows -->
  <path d="M540 140 C 592 140, 600 108, 660 108" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M654 102 L662 108 L654 114" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M540 192 C 592 192, 600 224, 660 224" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M654 218 L662 224 L654 230" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Listeners -->
  <text x="672" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">EVERY LISTENER, AUTOMATICALLY</text>
  <g transform="translate(672, 74)">
    <rect x="0" y="0" width="288" height="68" rx="12" fill="#0B0D10" />
    <text x="22" y="28" font-family="Archivo, sans-serif" font-size="13.5" font-weight="700" fill="#ffffff">Devices that decode FLAC</text>
    <text x="22" y="48" font-family="Archivo, sans-serif" font-size="12" fill="#9CC6F8">Hear exactly what left the console.</text>
  </g>
  <g transform="translate(672, 190)">
    <rect x="0" y="0" width="288" height="68" rx="12" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="22" y="28" font-family="Archivo, sans-serif" font-size="13.5" font-weight="700" fill="#0B0D10">Everything else</text>
    <text x="22" y="48" font-family="Archivo, sans-serif" font-size="12" fill="#78828F">Gets the 256 kbps AAC rendition.</text>
  </g>

  <!-- Footnote -->
  <text x="20" y="300" font-family="Archivo, sans-serif" font-size="13" fill="#3F4854">No second encoder, no separate feed, and nothing for the viewer to configure &mdash; the player negotiates it.</text>
  <text x="20" y="326" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">Your archive keeps the lossless track, so every future clip starts from the master rather than a copy.</text>
</svg>

<!-- Portrait: console → one manifest → the two kinds of listener. -->
<svg
  viewBox="0 0 360 710"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="mx-auto block h-auto w-full max-w-[460px] md:hidden"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="10" y="4" width="166" height="24" rx="6" fill="#FEF3C7" stroke="#FCD34D" stroke-width="1.5" />
  <text x="24" y="20" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600" letter-spacing="0.8" fill="#92400E">PLANNED CAPABILITY</text>

  <!-- Console -->
  <text x="10" y="52" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">YOUR CONSOLE</text>
  <g transform="translate(10, 62)">
    <rect x="0" y="0" width="340" height="108" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    {[0, 1, 2, 3].map((i) => (
      <g transform={`translate(${26 + i * 40}, 22)`}>
        <rect x="0" y="0" width="20" height="56" rx="4" fill="#F2F4F7" />
        <rect x="0" y={12 + (i % 3) * 10} width="20" height="8" rx="3" fill="#2B7FF0" />
      </g>
    ))}
    <text x="200" y="52" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">Full-quality mix,</text>
    <text x="200" y="70" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">untouched</text>
  </g>

  <!-- PCM arrow -->
  <rect x="134" y="180" width="92" height="24" rx="6" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <text x="180" y="196" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SRT · PCM</text>
  <path d="M180 210 V 228" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" />
  <path d="M173 222 L180 230 L187 222" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Packaging -->
  <text x="10" y="254" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">PACKAGED ONCE</text>
  <g transform="translate(10, 264)">
    <rect x="0" y="0" width="340" height="158" rx="16" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <text x="22" y="32" font-family="Archivo, sans-serif" font-size="15" font-weight="700" fill="#0B0D10">One CMAF manifest</text>
    <rect x="22" y="46" width="296" height="48" rx="10" fill="#0B0D10" />
    <text x="38" y="68" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill="#ffffff">FLAC &mdash; lossless</text>
    <text x="38" y="85" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="0.4" fill="#6AA9F4">16-BIT / 44.1 KHZ &middot; ~0.8 MBPS</text>
    <rect x="22" y="102" width="296" height="48" rx="10" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.5" />
    <text x="38" y="124" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill="#0B0D10">AAC &mdash; fallback</text>
    <text x="38" y="141" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="0.4" fill="#78828F">256 KBPS &middot; PLAYS ANYWHERE</text>
  </g>
  <path d="M180 422 V 444" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" />
  <path d="M173 438 L180 446 L187 438" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Listeners -->
  <text x="10" y="470" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">EVERY LISTENER, AUTOMATICALLY</text>
  <g transform="translate(10, 480)">
    <rect x="0" y="0" width="340" height="70" rx="12" fill="#0B0D10" />
    <text x="22" y="30" font-family="Archivo, sans-serif" font-size="14.5" font-weight="700" fill="#ffffff">Devices that decode FLAC</text>
    <text x="22" y="52" font-family="Archivo, sans-serif" font-size="13" fill="#9CC6F8">Hear exactly what left the console.</text>
  </g>
  <g transform="translate(10, 562)">
    <rect x="0" y="0" width="340" height="70" rx="12" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="22" y="30" font-family="Archivo, sans-serif" font-size="14.5" font-weight="700" fill="#0B0D10">Everything else</text>
    <text x="22" y="52" font-family="Archivo, sans-serif" font-size="13" fill="#78828F">Gets the 256 kbps AAC rendition.</text>
  </g>

  <!-- Footnote -->
  <text x="10" y="662" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">No second encoder, no separate feed, and</text>
  <text x="10" y="680" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">nothing for the viewer to configure &mdash; the</text>
  <text x="10" y="698" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">player negotiates it.</text>
</svg>
