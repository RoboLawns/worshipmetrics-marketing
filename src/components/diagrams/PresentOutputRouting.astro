---
/**
 * Present — one plan, every screen.
 * The service plan feeds one browser tab, which paints a different set of
 * layers to each output. Inline SVG so it inherits the page's brand fonts.
 */
const outputs = [
  { y: 40, title: "Main screen", sub: "Program", tag: "Media + slide + prop" },
  { y: 142, title: "Stage display", sub: "Musicians' monitor", tag: "Next slide · notes · chords" },
  { y: 244, title: "Lobby screen", sub: "Signage", tag: "Announcements only" },
  { y: 346, title: "Stream & NDI", sub: "To the booth", tag: "Clean key with alpha" },
];
---

<svg
  viewBox="0 0 980 470"
  width="100%"
  role="img"
  aria-label="Diagram: the service plan feeds Present in one browser tab, which paints different layers to the main screen, stage display, lobby screen, and the stream or NDI output."
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Service plan -->
  <g transform="translate(20, 168)">
    <rect x="0" y="0" width="180" height="134" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="18" y="30" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">SERVICE PLAN</text>
    <text x="18" y="54" font-family="Archivo, sans-serif" font-size="15" font-weight="700" fill="#0B0D10">Sunday Morning</text>
    <rect x="18" y="70" width="106" height="7" rx="3.5" fill="#C5DDFB" />
    <rect x="18" y="86" width="132" height="7" rx="3.5" fill="#C5DDFB" />
    <rect x="18" y="102" width="86" height="7" rx="3.5" fill="#C5DDFB" />
  </g>

  <!-- Plan → Present connector -->
  <path d="M200 235 H278" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M272 229 L280 235 L272 241" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Present engine -->
  <g transform="translate(284, 150)">
    <rect x="0" y="0" width="186" height="170" rx="16" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <rect x="26" y="26" width="38" height="38" rx="9" fill="#0B0D10" />
    <path d="M34 49 h5 l5.6-14 l6.8 26 l5.6-12 h5" fill="none" stroke="#2B7FF0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    <text x="26" y="94" font-family="Archivo, sans-serif" font-size="19" font-weight="800" letter-spacing="-0.4" fill="#0B0D10">Present</text>
    <text x="26" y="116" font-family="Archivo, sans-serif" font-size="13" fill="#3F4854">One browser tab</text>
    <text x="26" y="142" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.2" fill="#2B7FF0">NO CAPTURE CARD</text>
  </g>

  <!-- Present → outputs connectors -->
  {outputs.map(({ y }) => (
    <g>
      <path d={`M470 235 C 540 235, 560 ${y + 43}, 630 ${y + 43}`} fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
      <path d={`M624 ${y + 37} L632 ${y + 43} L624 ${y + 49}`} fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  ))}

  <!-- Outputs -->
  {outputs.map(({ y, title, sub, tag }) => (
    <g transform={`translate(636, ${y})`}>
      <rect x="0" y="0" width="324" height="86" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
      <rect x="18" y="26" width="34" height="26" rx="4" fill="#F2F4F7" stroke="#E3E7ED" stroke-width="1.5" />
      <rect x="24" y="32" width="22" height="10" rx="2" fill="#C5DDFB" />
      <text x="68" y="34" font-family="Archivo, sans-serif" font-size="15" font-weight="700" fill="#0B0D10">{title}</text>
      <text x="68" y="52" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">{sub}</text>
      <text x="68" y="72" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.1" fill="#2B7FF0">{tag.toUpperCase()}</text>
    </g>
  ))}

  <!-- Footnote -->
  <text x="20" y="342" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">Each output paints only</text>
  <text x="20" y="362" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">the layers it should.</text>
  <text x="20" y="392" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.2" fill="#78828F">THAT'S A LOOK</text>
</svg>
