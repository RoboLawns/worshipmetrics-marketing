---
/**
 * Patch — the label that makes support specific.
 * Map cable ID → physical label → the instruction a volunteer can act on.
 */
const LABEL = "Diagram: a cable documented in the Signal Map as SDI-002 carries a matching physical label, so support can say reseat SDI-002 on the back of the switcher instead of check your connections.";
---

<svg
  viewBox="0 0 980 320"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="hidden h-auto w-full md:block"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- 01 — In the Signal Map -->
  <text x="20" y="26" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">01 · IN THE SIGNAL MAP</text>
  <g transform="translate(20, 44)">
    <rect x="0" y="0" width="286" height="196" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <!-- device A -->
    <rect x="22" y="30" width="106" height="52" rx="8" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="34" y="52" font-family="Archivo, sans-serif" font-size="11.5" font-weight="700" fill="#0B0D10">PTZ — Stage</text>
    <text x="34" y="68" font-family="IBM Plex Mono, monospace" font-size="8" font-weight="600" letter-spacing="0.8" fill="#78828F">SDI OUT</text>
    <circle cx="134" cy="56" r="3.5" fill="#2B7FF0" />
    <!-- device B -->
    <rect x="158" y="112" width="106" height="52" rx="8" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="170" y="134" font-family="Archivo, sans-serif" font-size="11.5" font-weight="700" fill="#0B0D10">Switcher</text>
    <text x="170" y="150" font-family="IBM Plex Mono, monospace" font-size="8" font-weight="600" letter-spacing="0.8" fill="#78828F">IN 2</text>
    <circle cx="152" cy="138" r="3.5" fill="#2B7FF0" />
    <!-- cable run -->
    <path d="M134 56 H146 V138 H152" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="52" y="88" width="72" height="22" rx="5" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="1.5" />
    <text x="62" y="103" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SDI-002</text>
  </g>

  <!-- 02 — On the cable -->
  <text x="347" y="26" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">02 · ON THE CABLE</text>
  <g transform="translate(347, 44)">
    <rect x="0" y="0" width="286" height="196" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <!-- cable -->
    <path d="M28 118 C 90 74, 190 162, 258 108" fill="none" stroke="#0B0D10" stroke-width="9" stroke-linecap="round" opacity="0.86" />
    <path d="M28 118 C 90 74, 190 162, 258 108" fill="none" stroke="#3F4854" stroke-width="3.5" stroke-linecap="round" />
    <!-- connector ends -->
    <rect x="16" y="108" width="20" height="20" rx="4" fill="#78828F" />
    <rect x="250" y="98" width="20" height="20" rx="4" fill="#78828F" />
    <!-- wrap label -->
    <g transform="translate(112, 82) rotate(9)">
      <rect x="0" y="0" width="76" height="30" rx="5" fill="#ffffff" stroke="#2B7FF0" stroke-width="2" />
      <text x="12" y="20" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SDI-002</text>
    </g>
    <text x="24" y="170" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">The printed patch sheet gives you</text>
    <text x="24" y="188" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">every label, ready to wrap.</text>
  </g>

  <!-- 03 — On the call -->
  <text x="674" y="26" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">03 · ON THE CALL</text>
  <g transform="translate(674, 44)">
    <rect x="0" y="0" width="286" height="196" rx="14" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <rect x="22" y="26" width="30" height="30" rx="7" fill="#0B0D10" />
    <path d="M29 44 h4 l4.4-11 l5.4 21 l4.4-10 h4" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="62" y="40" font-family="Archivo, sans-serif" font-size="12.5" font-weight="700" fill="#0B0D10">910-WORSHIP</text>
    <text x="62" y="55" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600" letter-spacing="1" fill="#78828F">SEES YOUR MAP</text>
    <rect x="22" y="76" width="242" height="74" rx="10" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.5" />
    <text x="38" y="102" font-family="Archivo, sans-serif" font-size="13.5" fill="#0B0D10">“Reseat the cable labeled</text>
    <text x="38" y="122" font-family="Archivo, sans-serif" font-size="13.5" font-weight="700" fill="#1D66D6">SDI-002</text>
    <text x="99" y="122" font-family="Archivo, sans-serif" font-size="13.5" fill="#0B0D10">on the back of</text>
    <text x="38" y="142" font-family="Archivo, sans-serif" font-size="13.5" fill="#0B0D10">the switcher.”</text>
    <text x="22" y="176" font-family="Archivo, sans-serif" font-size="12.5" fill="#3F4854">Not “check your connections.”</text>
  </g>

  <!-- Connectors -->
  <path d="M312 142 H337" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M331 136 L339 142 L331 148" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M639 142 H664" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M658 136 L666 142 L658 148" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Footnote -->
  <text x="20" y="278" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">A volunteer who has never opened the rack can follow that instruction on their first Sunday.</text>
</svg>

<!-- Portrait: map → cable → call, stacked. -->
<svg
  viewBox="0 0 360 676"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="mx-auto block h-auto w-full max-w-[460px] md:hidden"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- 01 — In the Signal Map -->
  <text x="10" y="16" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">01 · IN THE SIGNAL MAP</text>
  <g transform="translate(10, 26)">
    <rect x="0" y="0" width="340" height="164" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="24" y="24" width="126" height="56" rx="9" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="38" y="48" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill="#0B0D10">PTZ &mdash; Stage</text>
    <text x="38" y="66" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="0.8" fill="#78828F">SDI OUT</text>
    <circle cx="156" cy="52" r="4" fill="#2B7FF0" />

    <rect x="190" y="84" width="126" height="56" rx="9" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="204" y="108" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill="#0B0D10">Switcher</text>
    <text x="204" y="126" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="0.8" fill="#78828F">IN 2</text>
    <circle cx="184" cy="112" r="4" fill="#2B7FF0" />

    <path d="M156 52 H172 V112 H184" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="46" y="98" width="86" height="26" rx="6" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="1.5" />
    <text x="58" y="116" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SDI-002</text>
  </g>
  <path d="M180 196 V 216" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" />
  <path d="M174 210 L180 218 L186 210" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- 02 — On the cable -->
  <text x="10" y="242" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">02 · ON THE CABLE</text>
  <g transform="translate(10, 252)">
    <rect x="0" y="0" width="340" height="150" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <path d="M30 76 C 106 34, 226 122, 310 66" fill="none" stroke="#0B0D10" stroke-width="10" stroke-linecap="round" opacity="0.86" />
    <path d="M30 76 C 106 34, 226 122, 310 66" fill="none" stroke="#3F4854" stroke-width="4" stroke-linecap="round" />
    <rect x="16" y="65" width="22" height="22" rx="4" fill="#78828F" />
    <rect x="302" y="55" width="22" height="22" rx="4" fill="#78828F" />
    <g transform="translate(128, 42) rotate(9)">
      <rect x="0" y="0" width="90" height="34" rx="6" fill="#ffffff" stroke="#2B7FF0" stroke-width="2" />
      <text x="14" y="23" font-family="IBM Plex Mono, monospace" font-size="12.5" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SDI-002</text>
    </g>
    <text x="22" y="122" font-family="Archivo, sans-serif" font-size="13.5" fill="#78828F">The printed patch sheet gives you</text>
    <text x="22" y="140" font-family="Archivo, sans-serif" font-size="13.5" fill="#78828F">every label, ready to wrap.</text>
  </g>
  <path d="M180 408 V 428" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" />
  <path d="M174 422 L180 430 L186 422" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- 03 — On the call -->
  <text x="10" y="454" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">03 · ON THE CALL</text>
  <g transform="translate(10, 464)">
    <rect x="0" y="0" width="340" height="156" rx="14" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <rect x="22" y="22" width="34" height="34" rx="8" fill="#0B0D10" />
    <path d="M30 41 h4.5 l5-12.5 l6 24 l5-11.5 h4.5" fill="none" stroke="#2B7FF0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="68" y="38" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill="#0B0D10">910-WORSHIP</text>
    <text x="68" y="54" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="1" fill="#78828F">SEES YOUR MAP</text>
    <rect x="22" y="70" width="296" height="60" rx="10" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.5" />
    <text x="38" y="94" font-family="Archivo, sans-serif" font-size="14" fill="#0B0D10">&ldquo;Reseat the cable labeled</text>
    <text x="38" y="116" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill="#1D66D6">SDI-002</text>
    <text x="102" y="116" font-family="Archivo, sans-serif" font-size="14" fill="#0B0D10">on the switcher.&rdquo;</text>
    <text x="22" y="148" font-family="Archivo, sans-serif" font-size="13" fill="#3F4854">Not &ldquo;check your connections.&rdquo;</text>
  </g>

  <!-- Footnote -->
  <text x="10" y="646" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">A volunteer who has never opened the rack</text>
  <text x="10" y="664" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">can follow that on their first Sunday.</text>
</svg>
