---
/**
 * Interactive connection graph: one question, and the wires that feed the answer.
 * Sources light up and pulse toward Luminos; the output switches between chat and phone.
 * No-JS: the first scenario renders lit. Reduced motion: no pulse.
 */

const sources = [
  { id: "machines",  y: 20,  label: "Your machines",      meta: "CPU · RAM · DISK · EVERY 15s",   short: "CPU · RAM · DISK" },
  { id: "devices",   y: 72,  label: "Your devices",       meta: "CAMERAS · CONSOLES · SWITCHERS", short: "CAMERAS · CONSOLES" },
  { id: "map",       y: 124, label: "Your Signal Map",    meta: "PORTS · LABELED CABLE RUNS",     short: "PORTS · CABLE RUNS" },
  { id: "timeline",  y: 176, label: "The last 30 minutes", meta: "HEALTH BEFORE IT BROKE",        short: "HEALTH BEFORE IT BROKE" },
  { id: "history",   y: 228, label: "30 days of history",  meta: "EVERY SERVICE · EVERY SCORE",   short: "EVERY SERVICE · SCORE" },
  { id: "tickets",   y: 280, label: "Every past fix",      meta: "WHAT WAS TRIED · WHAT WORKED",  short: "WHAT WAS TRIED" },
];

const scenarios = [
  {
    id: "drops",
    who: "Tech director · Sunday, 11:04am",
    q: "Why does our stream keep dropping?",
    uses: ["machines", "timeline", "history", "tickets"],
    out: "chat",
    answer: {
      lead: "Your encoder PC climbs to 88% processor load about twelve minutes into each service.",
      detail: "Same pattern as the three drops last month. In March, pre-converting the 4K bumper to 1080p fixed it &mdash; and that file is back at 4K in this week&rsquo;s plan.",
      tag: "Answered in chat · 4 seconds",
    },
  },
  {
    id: "camera",
    who: "Volunteer · Thursday rehearsal",
    q: "Camera 2 isn't showing up. What do I check?",
    uses: ["devices", "map", "timeline"],
    out: "phone",
    answer: {
      lead: "Camera 2 last responded Thursday at 4:12pm.",
      detail: "It runs on the cable labeled <strong>SDI-002</strong> into switcher input 2, powered from rack switch port 7 &mdash; and that port reports no draw. Check the port first; the camera was healthy until power stopped.",
      tag: "Answered on the phone · before rehearsal ended",
    },
  },
  {
    id: "turnover",
    who: "Pastor · the week after",
    q: "Our AV volunteer moved away. Where do we start?",
    uses: ["map", "devices", "history", "tickets"],
    out: "chat",
    answer: {
      lead: "Everything he documented is still here.",
      detail: "34 devices, 41 labeled cable runs, and the notes from every fix he made. The three things that have failed before are on the checklist he left &mdash; and the answer that worked comes with the alert.",
      tag: "Two years of context · nobody had to hand it over",
    },
  },
];

const NODE_W = 236;
const HUB_X = 430, HUB_Y = 128, HUB_W = 156, HUB_H = 104;
const OUT_X = 672;
---

<div class="lcd" data-luminos-demo data-active="drops">
  <!-- Question picker -->
  <div class="lcd-pills" role="tablist" aria-label="Choose a question">
    {scenarios.map((s, i) => (
      <button type="button" class:list={["lcd-pill", i === 0 && "is-active"]} role="tab"
        aria-selected={i === 0 ? "true" : "false"} data-lcd-pick={s.id}>{s.q}</button>
    ))}
  </div>

  <!-- Who is asking -->
  {scenarios.map((s, i) => (
    <p class:list={["lcd-who", i !== 0 && "is-hidden"]} data-lcd-who={s.id}>{s.who}</p>
  ))}

  <!-- The connection graph -->
  <div class="lcd-graph">
    <svg class="lcd-svg-wide" viewBox="0 0 980 340" width="100%" role="img"
      aria-label="Connection diagram: six sources of context — your machines, devices, Signal Map, the last thirty minutes, thirty days of history, and every past fix — feed into Luminos, which answers in chat or on the phone. The sources used for the selected question are highlighted."
      xmlns="http://www.w3.org/2000/svg">

      <!-- wires (drawn first, behind nodes) -->
      {sources.map((s) => (
        <path
          class="lcd-wire"
          data-wire={s.id}
          d={`M${20 + NODE_W} ${s.y + 20} C ${330} ${s.y + 20}, ${360} ${HUB_Y + HUB_H / 2}, ${HUB_X} ${HUB_Y + HUB_H / 2}`}
          fill="none" stroke-linecap="round"
        />
      ))}
      <!-- hub to output -->
      <path class="lcd-wire lcd-wire-out" d={`M${HUB_X + HUB_W} ${HUB_Y + HUB_H / 2} H ${OUT_X - 10}`} fill="none" stroke-linecap="round" />
      <path class="lcd-arrow" d={`M${OUT_X - 16} ${HUB_Y + HUB_H / 2 - 6} L${OUT_X - 6} ${HUB_Y + HUB_H / 2} L${OUT_X - 16} ${HUB_Y + HUB_H / 2 + 6}`} fill="none" stroke-linecap="round" stroke-linejoin="round" />

      <!-- source nodes -->
      {sources.map((s) => (
        <g class="lcd-node" data-node={s.id} transform={`translate(20, ${s.y})`}>
          <rect width={NODE_W} height="40" rx="9" />
          <circle class="lcd-node-dot" cx="18" cy="20" r="4.5" />
          <text class="lcd-node-label" x="34" y="17">{s.label}</text>
          <text class="lcd-node-meta" x="34" y="31">{s.meta}</text>
        </g>
      ))}

      <!-- Luminos hub -->
      <g transform={`translate(${HUB_X}, ${HUB_Y})`}>
        <rect width={HUB_W} height={HUB_H} rx="16" fill="#0B0D10" />
        <path d="M50 50 h7 l10-23 l11 43 l10-20 h7" fill="none" stroke="#2B7FF0" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
        <text x={HUB_W / 2} y="86" text-anchor="middle" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill="#ffffff">Luminos</text>
      </g>

      <!-- outputs: chat + phone, one active at a time -->
      <g class="lcd-out" data-out="chat" transform={`translate(${OUT_X}, 116)`}>
        <rect width="288" height="128" rx="14" fill="#ffffff" stroke="#C5DDFB" stroke-width="2" />
        <rect x="20" y="22" width="150" height="10" rx="5" fill="#E3E7ED" />
        <rect x="20" y="42" width="210" height="10" rx="5" fill="#E3E7ED" />
        <rect x="20" y="62" width="120" height="10" rx="5" fill="#E3E7ED" />
        <rect x="20" y="92" width="120" height="20" rx="10" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.2" />
        <text x="32" y="106" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600" letter-spacing="0.8" fill="#1D66D6">IN THE APP</text>
      </g>
      <g class="lcd-out" data-out="phone" transform={`translate(${OUT_X}, 116)`}>
        <rect width="288" height="128" rx="14" fill="#0B0D10" />
        <g transform="translate(26, 34) scale(1.5)"><path d="M9 11 c0-2 2-4 4-4h3l2.4 6-2.9 2c1.9 3.4 4.8 6.3 8.2 8.2l2-2.9 6 2.4v3c0 2-2 4-4 4 C17.6 29.7 9 21.1 9 11 z" fill="none" stroke="#2B7FF0" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" /></g>
        <text x="130" y="58" font-family="Archivo, sans-serif" font-size="15" font-weight="800" fill="#ffffff">910-WORSHIP</text>
        <text x="130" y="78" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600" letter-spacing="0.8" fill="#9CC6F8">ALREADY KNOWS YOUR SYSTEM</text>
      </g>
    </svg>

    <!-- Portrait: the same graph, sources stacked above the hub. -->
    <svg class="lcd-svg-tall" viewBox="0 0 360 592" width="100%" role="img"
      aria-label="Connection diagram: six sources of context — your machines, devices, Signal Map, the last thirty minutes, thirty days of history, and every past fix — feed into Luminos, which answers in chat or on the phone. The sources used for the selected question are highlighted."
      xmlns="http://www.w3.org/2000/svg">

      <!-- wires -->
      {sources.map((s, i) => {
        const ny = 31 + i * 50;
        return (
          <path
            class="lcd-wire"
            data-wire={s.id}
            d={`M240 ${ny} C 322 ${ny}, 180 ${ny + (346 - ny) * 0.5}, 180 346`}
            fill="none" stroke-linecap="round"
          />
        );
      })}
      <path class="lcd-wire lcd-wire-out" d="M180 438 V 452" fill="none" stroke-linecap="round" />
      <path class="lcd-arrow" d="M172 446 L180 454 L188 446" fill="none" stroke-linecap="round" stroke-linejoin="round" />

      <!-- source nodes -->
      {sources.map((s, i) => (
        <g class="lcd-node" data-node={s.id} transform={`translate(10, ${10 + i * 50})`}>
          <rect width="230" height="42" rx="9" />
          <circle class="lcd-node-dot" cx="18" cy="21" r="4.5" />
          <text class="lcd-node-label" x="34" y="19">{s.label}</text>
          <text class="lcd-node-meta" x="34" y="33">{s.short}</text>
        </g>
      ))}

      <!-- Luminos hub -->
      <g transform="translate(110, 346)">
        <rect width="140" height="92" rx="16" fill="#0B0D10" />
        <path d="M44 44 h6 l9-21 l10 39 l9-18 h6" fill="none" stroke="#2B7FF0" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <text x="70" y="76" text-anchor="middle" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill="#ffffff">Luminos</text>
      </g>

      <!-- outputs -->
      <g class="lcd-out" data-out="chat" transform="translate(10, 462)">
        <rect width="340" height="120" rx="14" fill="#ffffff" stroke="#C5DDFB" stroke-width="2" />
        <rect x="22" y="24" width="160" height="10" rx="5" fill="#E3E7ED" />
        <rect x="22" y="44" width="240" height="10" rx="5" fill="#E3E7ED" />
        <rect x="22" y="64" width="128" height="10" rx="5" fill="#E3E7ED" />
        <rect x="22" y="88" width="128" height="22" rx="11" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.2" />
        <text x="36" y="103" font-family="IBM Plex Mono, monospace" font-size="11.5" font-weight="600" letter-spacing="0.8" fill="#1D66D6">IN THE APP</text>
      </g>
      <g class="lcd-out" data-out="phone" transform="translate(10, 462)">
        <rect width="340" height="120" rx="14" fill="#0B0D10" />
        <g transform="translate(26, 32) scale(1.5)"><path d="M9 11 c0-2 2-4 4-4h3l2.4 6-2.9 2c1.9 3.4 4.8 6.3 8.2 8.2l2-2.9 6 2.4v3c0 2-2 4-4 4 C17.6 29.7 9 21.1 9 11 z" fill="none" stroke="#2B7FF0" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round" /></g>
        <text x="128" y="56" font-family="Archivo, sans-serif" font-size="16" font-weight="800" fill="#ffffff">910-WORSHIP</text>
        <text x="128" y="78" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="0.6" fill="#9CC6F8">KNOWS YOUR SYSTEM</text>
      </g>
    </svg>
  </div>

  <!-- The answer -->
  <div class="lcd-answers" aria-live="polite">
    {scenarios.map((s, i) => (
      <div class:list={["lcd-answer", i !== 0 && "is-hidden"]} data-lcd-answer={s.id}>
        <div class="lcd-bubble">
          <p class="lcd-a-lead" set:html={s.answer.lead} />
          <p class="lcd-a-detail" set:html={s.answer.detail} />
        </div>
        <p class="lcd-tag">{s.answer.tag}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .lcd-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .lcd-pill {
    border: 1px solid var(--border); background: #fff; color: var(--text-soft);
    border-radius: 999px; padding: 0.55rem 1.1rem;
    font-family: var(--font-ui); font-size: 0.85rem; font-weight: 600;
    cursor: pointer; transition: border-color .15s, background .15s, color .15s;
  }
  .lcd-pill:hover { border-color: var(--primary-border); color: var(--primary); }
  .lcd-pill.is-active { background: var(--primary); border-color: var(--primary); color: #fff; }

  .lcd-who {
    text-align: center; margin-top: 1.5rem;
    font-family: var(--font-mono-brand); font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted);
  }
  .is-hidden { display: none; }

  .lcd-graph { margin-top: 1rem; }
  .lcd-graph svg { height: auto; }
  /* Below md the graph runs top-to-bottom and fits the screen; above it, the
     wide version scrolls as before. */
  .lcd-svg-wide { display: none; }
  .lcd-svg-tall { display: block; margin-inline: auto; max-width: 460px; }
  .lcd-svg-tall .lcd-node-label { font-size: 13.5px; }
  .lcd-svg-tall .lcd-node-meta { font-size: 10.5px; }
  @media (min-width: 768px) {
    .lcd-graph { overflow-x: auto; }
    .lcd-svg-wide { display: block; min-width: 720px; }
    .lcd-svg-tall { display: none; }
  }

  /* nodes */
  .lcd-node rect { fill: #fff; stroke: var(--border); stroke-width: 1.5; transition: stroke .3s, fill .3s; }
  .lcd-node-dot { fill: #E3E7ED; transition: fill .3s; }
  .lcd-node-label { font-family: Archivo, sans-serif; font-size: 12px; font-weight: 700; fill: #78828F; transition: fill .3s; }
  .lcd-node-meta { font-family: "IBM Plex Mono", monospace; font-size: 7.5px; font-weight: 600; letter-spacing: 0.7px; fill: #B6BECB; transition: fill .3s; }
  .lcd-node.is-used rect { stroke: var(--primary); fill: #F7FBFF; }
  .lcd-node.is-used .lcd-node-dot { fill: var(--primary); }
  .lcd-node.is-used .lcd-node-label { fill: #0B0D10; }
  .lcd-node.is-used .lcd-node-meta { fill: #1D66D6; }

  /* wires */
  .lcd-wire { stroke: #E3E7ED; stroke-width: 1.5; transition: stroke .3s, stroke-width .3s; }
  .lcd-wire.is-used { stroke: #9CC6F8; stroke-width: 2.5; }
  .lcd-wire-out, .lcd-arrow { stroke: var(--primary); stroke-width: 2.5; }
  .lcd-arrow { stroke-width: 2.5; }

  .lcd.is-live .lcd-wire.is-used {
    stroke-dasharray: 9 190;
    animation: lcd-flow 1.6s linear infinite;
  }
  @keyframes lcd-flow { to { stroke-dashoffset: -199; } }

  /* outputs */
  .lcd-out { opacity: 0; transition: opacity .3s; pointer-events: none; }
  .lcd-out.is-shown { opacity: 1; }

  /* answer */
  .lcd-answers { margin-top: 1.5rem; text-align: center; }
  .lcd-bubble {
    display: inline-block; text-align: left; max-width: 46rem;
    background: #0B0D10; border-radius: 1.1rem; padding: 1rem 1.35rem;
  }
  .lcd-a-lead { margin: 0; font-weight: 700; font-size: 1.02rem; color: #fff; line-height: 1.5; }
  .lcd-a-detail { margin: 0.55rem 0 0; font-size: 0.94rem; color: #C5DDFB; line-height: 1.6; }
  .lcd-tag {
    margin-top: 0.75rem;
    font-family: var(--font-mono-brand); font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .lcd.is-live .lcd-wire.is-used { animation: none; stroke-dasharray: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-luminos-demo]");
  if (root) {
    const USES: Record<string, string[]> = {
      drops: ["machines", "timeline", "history", "tickets"],
      camera: ["devices", "map", "timeline"],
      turnover: ["map", "devices", "history", "tickets"],
    };
    const OUT: Record<string, string> = { drops: "chat", camera: "phone", turnover: "chat" };

    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-lcd-pick]"));
    const nodes = Array.from(root.querySelectorAll<SVGGElement>("[data-node]"));
    const wires = Array.from(root.querySelectorAll<SVGPathElement>("[data-wire]"));
    const outs = Array.from(root.querySelectorAll<SVGGElement>("[data-out]"));
    const whos = Array.from(root.querySelectorAll<HTMLElement>("[data-lcd-who]"));
    const answers = Array.from(root.querySelectorAll<HTMLElement>("[data-lcd-answer]"));

    root.classList.add("is-live");

    const show = (id: string) => {
      const used = USES[id] || [];
      nodes.forEach((n) => n.classList.toggle("is-used", used.includes(n.dataset.node!)));
      wires.forEach((w) => w.classList.toggle("is-used", used.includes(w.dataset.wire!)));
      outs.forEach((o) => o.classList.toggle("is-shown", o.dataset.out === OUT[id]));
      whos.forEach((w) => w.classList.toggle("is-hidden", w.dataset.lcdWho !== id));
      answers.forEach((a) => a.classList.toggle("is-hidden", a.dataset.lcdAnswer !== id));
      pills.forEach((p) => {
        const on = p.dataset.lcdPick === id;
        p.classList.toggle("is-active", on);
        p.setAttribute("aria-selected", on ? "true" : "false");
      });
      root.dataset.active = id;
    };

    pills.forEach((p) => p.addEventListener("click", () => show(p.dataset.lcdPick!)));
    show("drops");
  }
</script>
