---
/**
 * Interactive: one ordinary question, and everything standing behind the answer.
 * Pick a question, watch the context assemble, read the answer that used it.
 * No-JS: everything renders expanded. Reduced motion: no stagger.
 */

const contextCards = [
  {
    id: "machines",
    label: "Your machines",
    detail: "Every booth computer reports in every 15 seconds — processor load and temperature, memory, disk space, displays, and network.",
  },
  {
    id: "devices",
    label: "Your devices",
    detail: "Cameras, consoles, switchers, and encoders — whether each one is reachable right now, confirmed by every machine on the network.",
  },
  {
    id: "map",
    label: "Your Signal Map",
    detail: "What is plugged into what, down to the port — and the label printed on the actual cable, so an instruction can name it.",
  },
  {
    id: "timeline",
    label: "The last 30 minutes",
    detail: "The half hour of system health leading up to whatever just happened, kept so the question can be answered after the fact.",
  },
  {
    id: "history",
    label: "30 days of history",
    detail: "Stream quality for every service, which problems repeated, and what the system quietly fixed on its own.",
  },
  {
    id: "tickets",
    label: "Every past fix",
    detail: "What broke before, what your team tried, and what actually worked — kept with the church, not in one volunteer's memory.",
  },
];

const scenarios = [
  {
    id: "drops",
    who: "Tech director, Sunday 11:04am",
    q: "Why does our stream keep dropping?",
    uses: ["machines", "timeline", "history", "tickets"],
    answer: {
      lead: "Your encoder PC climbs to 88% processor load about twelve minutes into each service.",
      detail: "That is the same pattern as the three drops last month. In March, pre-converting the 4K bumper video to 1080p fixed it and the drops stopped for six weeks. That file is back at 4K in this week&rsquo;s plan.",
      tag: "Answered in chat, 4 seconds",
    },
  },
  {
    id: "camera",
    who: "Volunteer, Thursday rehearsal",
    q: "Camera 2 isn't showing up. What do I check?",
    uses: ["devices", "map", "timeline"],
    answer: {
      lead: "Camera 2 &mdash; the stage-wide PTZ &mdash; last responded Thursday at 4:12pm.",
      detail: "It runs on the cable labeled <strong>SDI-002</strong> into switcher input 2, and it is powered from port 7 on the rack switch. That port is reporting no power draw. Check the port first &mdash; the camera itself was healthy right up until power stopped.",
      tag: "Answered on the phone, before rehearsal ended",
    },
  },
  {
    id: "turnover",
    who: "Pastor, the week after",
    q: "Our AV volunteer just moved away. Where do we even start?",
    uses: ["map", "devices", "history", "tickets"],
    answer: {
      lead: "Everything he documented is still here.",
      detail: "34 devices, 41 labeled cable runs, and the notes from every fix he made over two years. The three things that have failed before are all on the Sunday checklist he left behind &mdash; and if any of them happen again, the answer that worked last time comes with the alert.",
      tag: "The knowledge stayed with the church",
    },
  },
];
---

<div class="lcd" data-luminos-demo>
  <!-- Question picker -->
  <div class="lcd-pills" role="tablist" aria-label="Choose a question">
    {scenarios.map((s, i) => (
      <button
        type="button"
        class:list={["lcd-pill", i === 0 && "is-active"]}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        data-lcd-pick={s.id}
      >{s.q}</button>
    ))}
  </div>

  {scenarios.map((s, i) => (
    <div class:list={["lcd-scene", i !== 0 && "is-hidden"]} data-lcd-scene={s.id}>
      <!-- The question -->
      <div class="lcd-ask">
        <p class="lcd-who">{s.who}</p>
        <div class="lcd-bubble lcd-bubble-q">{s.q}</div>
      </div>

      <p class="lcd-step">What Luminos already knows &darr;</p>

      <!-- Context -->
      <div class="lcd-grid">
        {contextCards.map((c, ci) => (
          <div
            class:list={["lcd-card", s.uses.includes(c.id) && "is-used"]}
            data-lcd-card={c.id}
            style={`--i:${ci}`}
          >
            <div class="lcd-card-top">
              <span class="lcd-dot" aria-hidden="true"></span>
              <p class="lcd-card-label">{c.label}</p>
              {s.uses.includes(c.id) && <span class="lcd-used" aria-label="Used in this answer">used</span>}
            </div>
            <p class="lcd-card-detail">{c.detail}</p>
          </div>
        ))}
      </div>

      <!-- The answer -->
      <div class="lcd-answer" aria-live="polite">
        <div class="lcd-bubble lcd-bubble-a">
          <p class="lcd-a-lead" set:html={s.answer.lead} />
          <p class="lcd-a-detail" set:html={s.answer.detail} />
        </div>
        <p class="lcd-tag">{s.answer.tag}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .lcd { --lcd-stagger: 90ms; }

  .lcd-pills {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    justify-content: center; margin-bottom: 2rem;
  }
  .lcd-pill {
    border: 1px solid var(--border);
    background: #fff; color: var(--text-soft);
    border-radius: 999px; padding: 0.55rem 1.1rem;
    font-family: var(--font-ui); font-size: 0.85rem; font-weight: 600;
    cursor: pointer; transition: border-color .15s, background .15s, color .15s;
    max-width: 100%;
  }
  .lcd-pill:hover { border-color: var(--primary-border); color: var(--primary); }
  .lcd-pill.is-active { background: var(--primary); border-color: var(--primary); color: #fff; }

  .lcd-scene.is-hidden { display: none; }

  .lcd-ask { text-align: center; }
  .lcd-who {
    font-family: var(--font-mono-brand); font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .lcd-bubble {
    display: inline-block; text-align: left;
    border-radius: 1.1rem; padding: 0.9rem 1.25rem;
    font-size: 1rem; line-height: 1.55; max-width: 44rem;
  }
  .lcd-bubble-q {
    background: var(--bg-card-alt); color: var(--text);
    border: 1px solid var(--border); font-weight: 600;
  }

  .lcd-step {
    text-align: center; margin: 1.5rem 0 1rem;
    font-family: var(--font-mono-brand); font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--primary);
  }

  .lcd-grid {
    display: grid; gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .lcd-card {
    border: 1px solid var(--border); border-radius: 1rem;
    background: #fff; padding: 1rem 1.1rem;
    transition: border-color .25s, box-shadow .25s, opacity .25s, transform .25s;
  }
  .lcd-card.is-used {
    border-color: var(--primary-border);
    box-shadow: 0 8px 26px rgba(43,127,240,0.10);
  }
  .lcd-card-top { display: flex; align-items: center; gap: 0.5rem; }
  .lcd-dot {
    width: 0.5rem; height: 0.5rem; border-radius: 999px;
    background: var(--border); flex-shrink: 0; transition: background .25s;
  }
  .lcd-card.is-used .lcd-dot { background: var(--primary); }
  .lcd-card-label { font-size: 0.88rem; font-weight: 700; color: var(--text); margin: 0; }
  .lcd-used {
    margin-left: auto; font-family: var(--font-mono-brand);
    font-size: 0.58rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--primary); background: var(--primary-light);
    border-radius: 999px; padding: 0.15rem 0.45rem;
  }
  .lcd-card-detail {
    margin: 0.5rem 0 0; font-size: 0.8rem; line-height: 1.6; color: var(--text-muted);
  }

  .lcd-answer { margin-top: 1.75rem; text-align: center; }
  .lcd-bubble-a {
    background: #0B0D10; color: #fff; border: 1px solid #0B0D10;
  }
  .lcd-a-lead { margin: 0; font-weight: 700; font-size: 1.02rem; }
  .lcd-a-detail { margin: 0.55rem 0 0; font-size: 0.94rem; color: #C5DDFB; }
  .lcd-tag {
    margin-top: 0.75rem;
    font-family: var(--font-mono-brand); font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted);
  }

  /* Staged reveal — only applied once JS takes over */
  .lcd.is-staged .lcd-card { opacity: 0; transform: translateY(6px); }
  .lcd.is-staged .lcd-answer { opacity: 0; transform: translateY(6px); }
  .lcd.is-staged .lcd-scene.is-playing .lcd-card {
    animation: lcd-in .42s ease forwards;
    animation-delay: calc(var(--i) * var(--lcd-stagger));
  }
  .lcd.is-staged .lcd-scene.is-playing .lcd-answer {
    animation: lcd-in .5s ease forwards;
    animation-delay: calc(6 * var(--lcd-stagger) + 160ms);
  }
  @keyframes lcd-in { to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .lcd.is-staged .lcd-card,
    .lcd.is-staged .lcd-answer { opacity: 1; transform: none; animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-luminos-demo]");
  if (root) {
    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-lcd-pick]"));
    const scenes = Array.from(root.querySelectorAll<HTMLElement>("[data-lcd-scene]"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Only stage the reveal when JS is present, so no-JS readers see everything.
    root.classList.add("is-staged");

    const play = (id: string) => {
      scenes.forEach((s) => {
        const match = s.dataset.lcdScene === id;
        s.classList.toggle("is-hidden", !match);
        s.classList.remove("is-playing");
        if (match && !reduce) {
          // restart the CSS animation
          void s.offsetWidth;
          s.classList.add("is-playing");
        } else if (match) {
          s.classList.add("is-playing");
        }
      });
      pills.forEach((p) => {
        const on = p.dataset.lcdPick === id;
        p.classList.toggle("is-active", on);
        p.setAttribute("aria-selected", on ? "true" : "false");
      });
    };

    pills.forEach((p) => p.addEventListener("click", () => play(p.dataset.lcdPick!)));

    // Play the first scenario when it scrolls into view
    let started = false;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !started) {
          started = true;
          play(scenes[0].dataset.lcdScene!);
          io.disconnect();
        }
      });
    }, { threshold: 0.25 });
    io.observe(root);
  }
</script>
