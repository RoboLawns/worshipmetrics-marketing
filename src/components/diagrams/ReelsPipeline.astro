---
/**
 * Reels — Sunday's service to shareable clips.
 * The whole service in, moments found and tagged, your approval,
 * then three social formats out.
 */
const moments = [
  { x: 0, w: 44, fill: "#C5DDFB" },
  { x: 52, w: 30, fill: "#6AA9F4" },
  { x: 90, w: 52, fill: "#2B7FF0" },
  { x: 150, w: 26, fill: "#C5DDFB" },
  { x: 184, w: 40, fill: "#6AA9F4" },
];
const LABEL = "Diagram: the full service recording is transcribed, AI finds and tags candidate moments across the timeline, your team approves the ones worth posting, and each approved clip renders in vertical, square, and horizontal formats.";
const tags = ["Sermon", "Songs", "Scripture"];
---

<svg
  viewBox="0 0 980 320"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="hidden h-auto w-full md:block"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- 01 the service -->
  <text x="20" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">01 · THE WHOLE SERVICE</text>
  <g transform="translate(20, 96)">
    <rect x="0" y="0" width="224" height="132" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="22" y="24" width="180" height="52" rx="8" fill="#0B0D10" />
    <path d="M100 42 l22 12 l-22 12 z" fill="#ffffff" opacity="0.9" />
    <text x="22" y="98" font-family="Archivo, sans-serif" font-size="12.5" fill="#3F4854">Streamed or uploaded &mdash;</text>
    <text x="22" y="115" font-family="Archivo, sans-serif" font-size="12.5" fill="#3F4854">an hour or more of video.</text>
  </g>

  <!-- 02 moments found -->
  <text x="286" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">02 · MOMENTS FOUND</text>
  <g transform="translate(286, 96)">
    <rect x="0" y="0" width="248" height="132" rx="14" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <text x="20" y="30" font-family="Archivo, sans-serif" font-size="12.5" font-weight="700" fill="#0B0D10">Transcript + tagged bands</text>
    <!-- timeline -->
    <rect x="20" y="44" width="208" height="18" rx="5" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.2" />
    {moments.map(({ x, w, fill }) => (
      <rect x={20 + x} y="44" width={w} height="18" rx="5" fill={fill} />
    ))}
    <!-- tag chips -->
    {tags.map((t, i) => (
      <g transform={`translate(${20 + i * 72}, 78)`}>
        <rect x="0" y="0" width="66" height="22" rx="6" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.2" />
        <text x="10" y="15" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600" letter-spacing="0.5" fill="#1D66D6">{t.toUpperCase()}</text>
      </g>
    ))}
    <text x="20" y="118" font-family="Archivo, sans-serif" font-size="11.5" fill="#78828F">No scrubbing the whole hour.</text>
  </g>

  <!-- 03 you approve -->
  <text x="576" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">03 · YOU APPROVE</text>
  <g transform="translate(576, 96)">
    <rect x="0" y="0" width="164" height="132" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <g transform="translate(22, 26)">
      <rect x="0" y="0" width="120" height="30" rx="7" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.2" />
      <circle cx="18" cy="15" r="8" fill="#2B7FF0" />
      <path d="M14 15 l3 3 l5.5-6" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      <text x="36" y="20" font-family="Archivo, sans-serif" font-size="11.5" fill="#0B0D10">Keep</text>
    </g>
    <g transform="translate(22, 64)">
      <rect x="0" y="0" width="120" height="30" rx="7" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.2" />
      <circle cx="18" cy="15" r="8" fill="#E3E7ED" />
      <path d="M14.5 11.5 l7 7 M21.5 11.5 l-7 7" fill="none" stroke="#78828F" stroke-width="1.6" stroke-linecap="round" />
      <text x="36" y="20" font-family="Archivo, sans-serif" font-size="11.5" fill="#78828F">Pass</text>
    </g>
    <text x="22" y="118" font-family="Archivo, sans-serif" font-size="11.5" fill="#78828F">Nothing posts itself.</text>
  </g>

  <!-- 04 formats -->
  <text x="782" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">04 · READY TO POST</text>
  <g transform="translate(782, 96)">
    <rect x="0" y="0" width="178" height="132" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="22" y="24" width="38" height="66" rx="6" fill="#0B0D10" />
    <text x="24" y="104" font-family="IBM Plex Mono, monospace" font-size="7.5" font-weight="600" fill="#78828F">9:16</text>
    <rect x="70" y="38" width="48" height="48" rx="6" fill="#2B7FF0" />
    <text x="80" y="104" font-family="IBM Plex Mono, monospace" font-size="7.5" font-weight="600" fill="#78828F">1:1</text>
    <rect x="126" y="46" width="30" height="32" rx="6" fill="#6AA9F4" />
    <text x="128" y="104" font-family="IBM Plex Mono, monospace" font-size="7.5" font-weight="600" fill="#78828F">16:9</text>
    <text x="22" y="122" font-family="Archivo, sans-serif" font-size="11.5" fill="#78828F">Captioned and rendered.</text>
  </g>

  <!-- Connectors -->
  {[[250, 280], [540, 570], [746, 776]].map(([a, b]) => (
    <g>
      <path d={`M${a} 162 H${b}`} fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
      <path d={`M${b - 6} 156 L${b + 2} 162 L${b - 6} 168`} fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  ))}

  <!-- Footnote -->
  <text x="20" y="278" font-family="Archivo, sans-serif" font-size="13" fill="#3F4854">The bottleneck was never the editing &mdash; it was finding the forty-five seconds worth sharing.</text>
</svg>

<!-- Portrait: the four steps stacked. -->
<svg
  viewBox="0 0 360 748"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="mx-auto block h-auto w-full max-w-[460px] md:hidden"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <marker id="rp-m" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M1 1 L6 6 L1 11" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </marker>
  </defs>

  <!-- 01 the service -->
  <text x="10" y="16" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">01 · THE WHOLE SERVICE</text>
  <g transform="translate(10, 26)">
    <rect x="0" y="0" width="340" height="122" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="22" y="22" width="296" height="56" rx="8" fill="#0B0D10" />
    <path d="M160 42 l22 12 l-22 12 z" fill="#ffffff" opacity="0.9" />
    <text x="22" y="100" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">Streamed or uploaded &mdash; an hour</text>
    <text x="22" y="116" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">or more of video.</text>
  </g>
  <path d="M180 152 V 176" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" marker-end="url(#rp-m)" fill="none" />

  <!-- 02 moments found -->
  <text x="10" y="196" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">02 · MOMENTS FOUND</text>
  <g transform="translate(10, 206)">
    <rect x="0" y="0" width="340" height="144" rx="14" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <text x="22" y="30" font-family="Archivo, sans-serif" font-size="14.5" font-weight="700" fill="#0B0D10">Transcript + tagged bands</text>
    <rect x="22" y="44" width="296" height="22" rx="6" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.2" />
    {moments.map(({ x, w, fill }) => (
      <rect x={22 + x * 1.32} y="44" width={w * 1.32} height="22" rx="6" fill={fill} />
    ))}
    {tags.map((t, i) => (
      <g transform={`translate(${22 + i * 100}, 82)`}>
        <rect x="0" y="0" width="92" height="26" rx="7" fill="#ffffff" stroke="#C5DDFB" stroke-width="1.2" />
        <text x="46" y="17" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="0.5" fill="#1D66D6">{t.toUpperCase()}</text>
      </g>
    ))}
    <text x="22" y="130" font-family="Archivo, sans-serif" font-size="13" fill="#78828F">No scrubbing the whole hour.</text>
  </g>
  <path d="M180 354 V 378" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" marker-end="url(#rp-m)" fill="none" />

  <!-- 03 you approve -->
  <text x="10" y="398" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">03 · YOU APPROVE</text>
  <g transform="translate(10, 408)">
    <rect x="0" y="0" width="340" height="112" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <g transform="translate(22, 22)">
      <rect x="0" y="0" width="140" height="34" rx="8" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.2" />
      <circle cx="21" cy="17" r="9" fill="#2B7FF0" />
      <path d="M16.5 17 l3.4 3.4 l6.2-6.8" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="42" y="22" font-family="Archivo, sans-serif" font-size="13.5" fill="#0B0D10">Keep</text>
    </g>
    <g transform="translate(178, 22)">
      <rect x="0" y="0" width="140" height="34" rx="8" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.2" />
      <circle cx="21" cy="17" r="9" fill="#E3E7ED" />
      <path d="M17 13 l8 8 M25 13 l-8 8" fill="none" stroke="#78828F" stroke-width="1.8" stroke-linecap="round" />
      <text x="42" y="22" font-family="Archivo, sans-serif" font-size="13.5" fill="#78828F">Pass</text>
    </g>
    <text x="22" y="94" font-family="Archivo, sans-serif" font-size="13" fill="#78828F">Nothing posts itself.</text>
  </g>
  <path d="M180 524 V 548" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" marker-end="url(#rp-m)" fill="none" />

  <!-- 04 formats -->
  <text x="10" y="568" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">04 · READY TO POST</text>
  <g transform="translate(10, 578)">
    <rect x="0" y="0" width="340" height="112" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="50" y="18" width="38" height="66" rx="6" fill="#0B0D10" />
    <text x="59" y="98" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#78828F">9:16</text>
    <rect x="146" y="27" width="48" height="48" rx="6" fill="#2B7FF0" />
    <text x="159" y="98" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#78828F">1:1</text>
    <rect x="246" y="34" width="44" height="34" rx="6" fill="#6AA9F4" />
    <text x="253" y="98" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#78828F">16:9</text>
  </g>

  <!-- Footnote -->
  <text x="10" y="716" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">The bottleneck was never the editing &mdash; it was</text>
  <text x="10" y="736" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">finding the forty-five seconds worth sharing.</text>
</svg>
