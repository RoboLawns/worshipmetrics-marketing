---
/**
 * Present — the layer stack.
 * Exploded view of the four layers Present composes every frame from,
 * in paint order: media → slide → prop → announcement.
 * Inline SVG so it inherits the page's Archivo / IBM Plex Mono.
 */
const layers = [
  { oy: 110, name: "Announcement", tag: "Overlay" },
  { oy: 215, name: "Prop", tag: "Lower-third" },
  { oy: 320, name: "Slide", tag: "Lyrics · Scripture" },
  { oy: 425, name: "Media", tag: "Background" },
];
---

<svg
  viewBox="0 0 980 620"
  width="100%"
  role="img"
  aria-label="Exploded diagram of Present's four composition layers — media, slide, prop, and announcement — and the composed frame the room sees."
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="pls-media" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#142C55" />
      <stop offset="55%" stop-color="#0B0D10" />
      <stop offset="100%" stop-color="#1C4685" />
    </linearGradient>
    <linearGradient id="pls-media-flat" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#142C55" />
      <stop offset="55%" stop-color="#0B0D10" />
      <stop offset="100%" stop-color="#1C4685" />
    </linearGradient>
  </defs>

  <!-- paint-order caption -->
  <text x="60" y="40" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.8" fill="#78828F">PAINT ORDER</text>
  <path d="M60 52 L60 78 M55 72 L60 78 L65 72" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Layer 1 — Announcement -->
  <g transform="translate(60, 110) skewY(-8.37)">
    <rect x="0" y="0" width="340" height="120" rx="8" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="70" y="34" width="200" height="52" rx="8" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
    <rect x="86" y="50" width="120" height="8" rx="4" fill="#2B7FF0" opacity="0.75" />
    <rect x="86" y="66" width="168" height="6" rx="3" fill="#78828F" opacity="0.5" />
  </g>

  <!-- Layer 2 — Prop -->
  <g transform="translate(60, 215) skewY(-8.37)">
    <rect x="0" y="0" width="340" height="120" rx="8" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="18" y="80" width="176" height="26" rx="5" fill="#2B7FF0" />
    <rect x="30" y="90" width="86" height="7" rx="3.5" fill="#ffffff" opacity="0.9" />
    <rect x="296" y="14" width="30" height="30" rx="7" fill="#F2F4F7" stroke="#E3E7ED" stroke-width="1.5" />
    <path d="M303 32 h4 l4.4-11 l5.4 21 l4.4-10 h4" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </g>

  <!-- Layer 3 — Slide -->
  <g transform="translate(60, 320) skewY(-8.37)">
    <rect x="0" y="0" width="340" height="120" rx="8" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="85" y="34" width="170" height="11" rx="5.5" fill="#0B0D10" opacity="0.82" />
    <rect x="63" y="55" width="214" height="11" rx="5.5" fill="#0B0D10" opacity="0.82" />
    <rect x="103" y="76" width="134" height="11" rx="5.5" fill="#0B0D10" opacity="0.82" />
  </g>

  <!-- Layer 4 — Media -->
  <g transform="translate(60, 425) skewY(-8.37)">
    <rect x="0" y="0" width="340" height="120" rx="8" fill="url(#pls-media)" stroke="#E3E7ED" stroke-width="1.5" />
    <path d="M0 92 C 70 62, 118 104, 176 78 C 236 51, 288 92, 340 70 L340 112 a8 8 0 0 1 -8 8 L8 120 a8 8 0 0 1 -8 -8 Z" fill="#2B7FF0" opacity="0.28" />
    <circle cx="286" cy="34" r="17" fill="#2B7FF0" opacity="0.35" />
  </g>

  <!-- Layer labels -->
  {layers.map(({ oy, name, tag }) => (
    <g>
      <text x="424" y={oy + 56} font-family="Archivo, sans-serif" font-size="16" font-weight="700" fill="#0B0D10">{name}</text>
      <text x="424" y={oy + 76} font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.2" fill="#78828F">{tag.toUpperCase()}</text>
    </g>
  ))}

  <!-- Divider -->
  <line x1="566" y1="70" x2="566" y2="550" stroke="#E3E7ED" stroke-width="1.5" stroke-dasharray="4 6" />

  <!-- Composed result -->
  <text x="600" y="182" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.8" fill="#78828F">WHAT THE ROOM SEES</text>
  <g transform="translate(600, 200)">
    <rect x="0" y="0" width="340" height="191" rx="12" fill="url(#pls-media-flat)" stroke="#E3E7ED" stroke-width="1.5" />
    <path d="M0 146 C 70 116, 118 158, 176 132 C 236 105, 288 146, 340 124 L340 179 a12 12 0 0 1 -12 12 L12 191 a12 12 0 0 1 -12 -12 Z" fill="#2B7FF0" opacity="0.28" />
    <circle cx="286" cy="52" r="17" fill="#2B7FF0" opacity="0.35" />
    <rect x="85" y="52" width="170" height="11" rx="5.5" fill="#ffffff" opacity="0.95" />
    <rect x="63" y="73" width="214" height="11" rx="5.5" fill="#ffffff" opacity="0.95" />
    <rect x="103" y="94" width="134" height="11" rx="5.5" fill="#ffffff" opacity="0.95" />
    <rect x="18" y="151" width="176" height="26" rx="5" fill="#2B7FF0" />
    <rect x="30" y="161" width="86" height="7" rx="3.5" fill="#ffffff" opacity="0.9" />
    <rect x="296" y="14" width="30" height="30" rx="7" fill="#0B0D10" opacity="0.55" />
    <path d="M303 32 h4 l4.4-11 l5.4 21 l4.4-10 h4" fill="none" stroke="#6AA9F4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </g>
  <text x="600" y="424" font-family="Archivo, sans-serif" font-size="14" font-weight="400" fill="#3F4854">Every layer stays independent &mdash; swap the</text>
  <text x="600" y="446" font-family="Archivo, sans-serif" font-size="14" font-weight="400" fill="#3F4854">background mid-song without touching a lyric.</text>
</svg>
