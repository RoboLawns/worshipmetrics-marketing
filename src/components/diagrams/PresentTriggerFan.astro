---
/**
 * Present — one slide advance, five things happen.
 * Sits on the dark protocol-triggers section, so colours are tuned for
 * slate-950. Inline SVG so it inherits Archivo / IBM Plex Mono.
 */
const actions = [
  { y: 12, title: "Background changes", tag: "Set-background" },
  { y: 100, title: "Lower third appears", tag: "Show-overlay" },
  { y: 188, title: "House lights warm up", tag: "OSC" },
  { y: 276, title: "Switcher takes Camera 2", tag: "RossTalk" },
  { y: 364, title: "Audio bed fades in", tag: "Play-audio" },
];
const LABEL = "Diagram: one slide advance fires five actions at once — the background changes, a lower third appears, house lights warm up over OSC, the switcher takes camera two over RossTalk, and an audio bed fades in.";
---

<svg
  viewBox="0 0 940 470"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="hidden h-auto w-full md:block"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Trigger node -->
  <g transform="translate(20, 168)">
    <rect x="0" y="0" width="200" height="134" rx="16" fill="rgba(255,255,255,0.06)" stroke="#2B7FF0" stroke-width="2" />
    <rect x="24" y="24" width="60" height="34" rx="6" fill="#2B7FF0" opacity="0.22" stroke="#2B7FF0" stroke-width="1.5" />
    <path d="M40 41 h8 M56 35 l8 6 l-8 6" fill="none" stroke="#6AA9F4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="24" y="86" font-family="Archivo, sans-serif" font-size="17" font-weight="800" letter-spacing="-0.3" fill="#ffffff">One advance</text>
    <text x="24" y="108" font-family="Archivo, sans-serif" font-size="13" fill="#94A3B8">The volunteer clicks once</text>
  </g>

  <!-- Fan connectors -->
  {actions.map(({ y }) => (
    <path
      d={`M220 235 C 300 235, 330 ${y + 37}, 410 ${y + 37}`}
      fill="none"
      stroke="#2B7FF0"
      stroke-width="1.75"
      stroke-linecap="round"
      opacity="0.45"
    />
  ))}
  {actions.map(({ y }) => (
    <circle cx="410" cy={y + 37} r="3.5" fill="#6AA9F4" />
  ))}

  <!-- Action cards -->
  {actions.map(({ y, title, tag }) => (
    <g transform={`translate(426, ${y})`}>
      <rect x="0" y="0" width="494" height="74" rx="13" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
      <text x="24" y="32" font-family="Archivo, sans-serif" font-size="15.5" font-weight="700" fill="#E9EEF4">{title}</text>
      <text x="24" y="54" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.2" fill="#6AA9F4">{tag.toUpperCase()}</text>
      <circle cx="466" cy="37" r="4.5" fill="#34D399" />
    </g>
  ))}

  <!-- Footnote -->
  <text x="20" y="340" font-family="Archivo, sans-serif" font-size="13.5" fill="#94A3B8">No one is watching</text>
  <text x="20" y="360" font-family="Archivo, sans-serif" font-size="13.5" fill="#94A3B8">five other screens.</text>
  <text x="20" y="392" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.2" fill="#2B7FF0">THAT'S A MACRO</text>
</svg>

<!-- Portrait: the advance on top, the five actions it fires below. -->
<svg
  viewBox="0 0 360 596"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="mx-auto block h-auto w-full max-w-[460px] md:hidden"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Trigger node -->
  <g transform="translate(10, 10)">
    <rect x="0" y="0" width="340" height="104" rx="16" fill="rgba(255,255,255,0.06)" stroke="#2B7FF0" stroke-width="2" />
    <rect x="24" y="22" width="60" height="34" rx="6" fill="#2B7FF0" opacity="0.22" stroke="#2B7FF0" stroke-width="1.5" />
    <path d="M40 39 h8 M56 33 l8 6 l-8 6" fill="none" stroke="#6AA9F4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="102" y="36" font-family="Archivo, sans-serif" font-size="19" font-weight="800" letter-spacing="-0.3" fill="#ffffff">One advance</text>
    <text x="102" y="57" font-family="Archivo, sans-serif" font-size="14.5" fill="#94A3B8">The volunteer clicks once</text>
    <text x="24" y="88" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" letter-spacing="1.2" fill="#2B7FF0">THAT'S A MACRO</text>
  </g>

  <!-- Fan spine -->
  <path d="M180 118 V 138" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" opacity="0.6" />
  <path d="M173 132 L180 140 L187 132" fill="none" stroke="#6AA9F4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Action cards -->
  {actions.map(({ title, tag }, i) => (
    <g transform={`translate(10, ${150 + i * 72})`}>
      <rect x="0" y="0" width="340" height="62" rx="13" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
      <circle cx="316" cy="31" r="4.5" fill="#34D399" />
      <text x="22" y="27" font-family="Archivo, sans-serif" font-size="16.5" font-weight="700" fill="#E9EEF4">{title}</text>
      <text x="22" y="48" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" letter-spacing="1.1" fill="#6AA9F4">{tag.toUpperCase()}</text>
    </g>
  ))}

  <!-- Footnote -->
  <text x="10" y="580" font-family="Archivo, sans-serif" font-size="14.5" fill="#94A3B8">No one is watching five other screens.</text>
</svg>
