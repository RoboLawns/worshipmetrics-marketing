---
/**
 * Present — stage display anatomy.
 * Annotated callouts over the confidence monitor the platform sees.
 * Inline SVG so it inherits the page's Archivo / IBM Plex Mono.
 */
---

<svg
  viewBox="0 64 980 372"
  width="100%"
  role="img"
  aria-label="Annotated diagram of the Present stage display, labeling the song and section, the countdown clock, current lyrics, chord chart transposed to the band's key, the dimmed next slide, and notes carried from the service plan."
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Monitor frame -->
  <g transform="translate(250, 96)">
    <rect x="0" y="0" width="480" height="270" rx="14" fill="#0B0D10" stroke="#1E2733" stroke-width="2" />

    <!-- Song + section -->
    <text x="22" y="34" font-family="Archivo, sans-serif" font-size="13" font-weight="600" fill="#94A3B8">Great Are You Lord</text>
    <rect x="22" y="44" width="72" height="20" rx="5" fill="#2B7FF0" />
    <text x="34" y="58" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1" fill="#ffffff">CHORUS</text>

    <!-- Clock + timer -->
    <text x="458" y="34" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="600" fill="#E9EEF4">10:42</text>
    <text x="458" y="58" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#34D399">+02:14</text>

    <!-- Current lyrics -->
    <rect x="22" y="92" width="232" height="13" rx="6.5" fill="#ffffff" opacity="0.95" />
    <rect x="22" y="116" width="278" height="13" rx="6.5" fill="#ffffff" opacity="0.95" />
    <rect x="22" y="140" width="196" height="13" rx="6.5" fill="#ffffff" opacity="0.95" />

    <!-- Chord chart column -->
    <rect x="330" y="80" width="128" height="112" rx="8" fill="#111827" stroke="#2B7FF0" stroke-width="1.5" />
    <text x="344" y="100" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600" letter-spacing="1" fill="#6AA9F4">KEY OF G</text>
    <text x="344" y="124" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#E9EEF4">G   D   Em</text>
    <text x="344" y="146" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#E9EEF4">C   G   D</text>
    <text x="344" y="168" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="600" fill="#E9EEF4">Em  C   G</text>

    <!-- Next slide, dimmed -->
    <text x="22" y="196" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600" letter-spacing="1.1" fill="#4B5563">NEXT</text>
    <rect x="22" y="206" width="186" height="10" rx="5" fill="#ffffff" opacity="0.28" />
    <rect x="22" y="224" width="146" height="10" rx="5" fill="#ffffff" opacity="0.28" />

    <!-- Notes -->
    <rect x="252" y="206" width="206" height="44" rx="8" fill="#1C1917" stroke="#292524" stroke-width="1.5" />
    <text x="266" y="224" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600" letter-spacing="1.1" fill="#A8A29E">NOTE</text>
    <text x="266" y="240" font-family="Archivo, sans-serif" font-size="11.5" fill="#E7E5E4">Hold after chorus — pastor prays</text>
  </g>

  <!-- Left callouts -->
  <g font-family="Archivo, sans-serif">
    <text x="24" y="128" font-size="15" font-weight="700" fill="#0B0D10">Song &amp; section</text>
    <text x="24" y="148" font-size="12.5" fill="#78828F">Where you are, at a glance</text>
    <path d="M198 132 H236" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="240" cy="132" r="3" fill="#2B7FF0" />

    <text x="24" y="222" font-size="15" font-weight="700" fill="#0B0D10">Current lyrics</text>
    <text x="24" y="242" font-size="12.5" fill="#78828F">Large, from the live slide</text>
    <path d="M186 226 H236" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="240" cy="226" r="3" fill="#2B7FF0" />

    <text x="24" y="316" font-size="15" font-weight="700" fill="#0B0D10">Next slide</text>
    <text x="24" y="336" font-size="12.5" fill="#78828F">Dimmed, so it never confuses</text>
    <path d="M204 320 H236" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="240" cy="320" r="3" fill="#2B7FF0" />
  </g>

  <!-- Right callouts -->
  <g font-family="Archivo, sans-serif">
    <text x="756" y="128" font-size="15" font-weight="700" fill="#0B0D10">Clock &amp; countdown</text>
    <text x="756" y="148" font-size="12.5" fill="#78828F">Running over turns amber</text>
    <path d="M744 132 H716" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="712" cy="132" r="3" fill="#2B7FF0" />

    <text x="756" y="226" font-size="15" font-weight="700" fill="#2B7FF0">Chords in your key</text>
    <text x="756" y="246" font-size="12.5" fill="#3F4854">The chart transposes itself &mdash;</text>
    <text x="756" y="264" font-size="12.5" fill="#3F4854">no second binder to reprint</text>
    <path d="M744 230 H716" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" />
    <circle cx="712" cy="230" r="4" fill="#2B7FF0" />

    <text x="756" y="336" font-size="15" font-weight="700" fill="#0B0D10">Notes from the plan</text>
    <text x="756" y="356" font-size="12.5" fill="#78828F">Written Tuesday, read Sunday</text>
    <path d="M744 340 H716" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="712" cy="340" r="3" fill="#2B7FF0" />
  </g>

  <!-- Footnote -->
  <text x="250" y="410" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">ITS OWN EDITABLE LAYOUT &mdash; NEVER A MIRROR OF THE PROJECTOR</text>
</svg>
