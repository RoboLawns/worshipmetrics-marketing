---
/**
 * The church remembers, even when the person doesn't stay.
 * A two-lane timeline: people come and go on top, the system's memory
 * accumulates underneath and is still there for whoever asks next.
 */
const events = [
  { x: 60, label: "Marcus documents the booth", meta: "34 devices, 41 labeled cables", kind: "build" },
  { x: 268, label: "Stream drops mid-sermon", meta: "Cause found, fix recorded", kind: "fix" },
  { x: 476, label: "Camera 2 loses power", meta: "PoE port 7 — noted", kind: "fix" },
  { x: 684, label: "Marcus moves away", meta: "No handoff meeting", kind: "leave" },
  { x: 880, label: "Sarah asks her first question", meta: "Gets two years of context", kind: "ask" },
];
const FILL = { build: "#2B7FF0", fix: "#6AA9F4", leave: "#78828F", ask: "#0B0D10" };
const LABEL = "Timeline: a volunteer documents the church AV system, two problems are solved and recorded, the volunteer leaves without a handoff, and a new volunteer asking her first question still receives two years of accumulated context.";
/** Portrait: the memory bar runs down the page instead of across it. */
const P_TOP = 96, P_STEP = 74;
---

<svg
  viewBox="0 0 980 330"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="hidden h-auto w-full md:block"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- People lane -->
  <text x="20" y="26" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">THE PEOPLE</text>
  <path d="M60 62 H700" fill="none" stroke="#E3E7ED" stroke-width="2" stroke-linecap="round" />
  <path d="M700 62 H716" fill="none" stroke="#E3E7ED" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 5" />
  <rect x="52" y="46" width="150" height="32" rx="8" fill="#F2F4F7" stroke="#E3E7ED" stroke-width="1.2" />
  <text x="66" y="66" font-family="Archivo, sans-serif" font-size="12" font-weight="600" fill="#3F4854">Marcus &middot; 2 years</text>
  <g transform="translate(684, 46)">
    <rect x="0" y="0" width="16" height="32" rx="4" fill="#E3E7ED" />
  </g>
  <rect x="836" y="46" width="124" height="32" rx="8" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <text x="850" y="66" font-family="Archivo, sans-serif" font-size="12" font-weight="600" fill="#1D66D6">Sarah &middot; week one</text>

  <!-- Events -->
  {events.map(({ x, label, meta, kind }) => (
    <g>
      <line x1={x} y1="96" x2={x} y2="150" stroke="#E3E7ED" stroke-width="1.5" stroke-linecap="round" />
      <circle cx={x} cy="150" r="7" fill={FILL[kind]} />
      {kind === "leave" && <circle cx={x} cy="150" r="12" fill="none" stroke="#C5DDFB" stroke-width="1.5" stroke-dasharray="3 3" />}
    </g>
  ))}

  <!-- Memory lane -->
  <text x="20" y="196" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">WHAT THE CHURCH KEEPS</text>
  <!-- accumulating bar: grows and never resets -->
  <rect x="60" y="210" width="900" height="34" rx="10" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <rect x="60" y="210" width="208" height="34" rx="10" fill="#C5DDFB" opacity="0.55" />
  <rect x="60" y="210" width="416" height="34" rx="10" fill="#9CC6F8" opacity="0.45" />
  <rect x="60" y="210" width="624" height="34" rx="10" fill="#6AA9F4" opacity="0.4" />
  <rect x="60" y="210" width="900" height="34" rx="10" fill="#2B7FF0" opacity="0.18" />
  <text x="76" y="232" font-family="Archivo, sans-serif" font-size="12.5" font-weight="700" fill="#1D66D6">The Signal Map, the device history, every fix that worked</text>

  <!-- Event labels -->
  {events.map(({ x, label, meta }, i) => {
    const w = 176;
    const bx = Math.min(Math.max(x - w / 2, 20), 960 - w);
    return (
      <g transform={`translate(${bx}, 262)`}>
        <text x="0" y="12" font-family="Archivo, sans-serif" font-size="11.5" font-weight="700" fill="#0B0D10">{label}</text>
        <text x="0" y="28" font-family="Archivo, sans-serif" font-size="10.5" fill="#78828F">{meta}</text>
      </g>
    );
  })}

  <!-- Callout on the handoff gap -->
  <text x="612" y="128" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600" letter-spacing="0.8" fill="#78828F">NO HANDOFF</text>
  <text x="806" y="128" font-family="IBM Plex Mono, monospace" font-size="8.5" font-weight="600" letter-spacing="0.8" fill="#1D66D6">STILL ANSWERED</text>
</svg>

<!-- Portrait: the timeline runs down, the memory rail beside it. -->
<svg
  viewBox="0 0 360 590"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="mx-auto block h-auto w-full max-w-[460px] md:hidden"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- People -->
  <text x="10" y="16" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="1.2" fill="#78828F">THE PEOPLE</text>
  <rect x="10" y="26" width="152" height="30" rx="8" fill="#F2F4F7" stroke="#E3E7ED" stroke-width="1.2" />
  <text x="24" y="46" font-family="Archivo, sans-serif" font-size="12.5" font-weight="600" fill="#3F4854">Marcus &middot; 2 years</text>
  <rect x="196" y="26" width="154" height="30" rx="8" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <text x="210" y="46" font-family="Archivo, sans-serif" font-size="12.5" font-weight="600" fill="#1D66D6">Sarah &middot; week one</text>

  <!-- Memory rail: grows downward and never resets -->
  <text x="10" y="82" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="1.2" fill="#2B7FF0">WHAT THE CHURCH KEEPS</text>
  <rect x="10" y={P_TOP} width="26" height={P_STEP * 5 - 16} rx="10" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  {[1, 2, 3, 4].map((n) => (
    <rect x="10" y={P_TOP} width="26" height={P_STEP * n - 16} rx="10" fill={["#C5DDFB", "#9CC6F8", "#6AA9F4", "#2B7FF0"][n - 1]} opacity={[0.55, 0.45, 0.4, 0.28][n - 1]} />
  ))}

  <!-- Events -->
  {events.map(({ label, meta, kind }, i) => (
    <g>
      {i < events.length - 1 && (
        <line
          x1="23" y1={P_TOP + 18 + i * P_STEP} x2="23" y2={P_TOP + 18 + (i + 1) * P_STEP}
          stroke="#ffffff" stroke-width="1.5" stroke-dasharray={kind === "leave" ? "3 4" : "0"} opacity="0.8"
        />
      )}
      <circle cx="23" cy={P_TOP + 18 + i * P_STEP} r="8" fill={FILL[kind]} stroke="#ffffff" stroke-width="2" />
      {kind === "leave" && (
        <circle cx="23" cy={P_TOP + 18 + i * P_STEP} r="13" fill="none" stroke="#78828F" stroke-width="1.5" stroke-dasharray="3 3" />
      )}
      <text x="52" y={P_TOP + 15 + i * P_STEP} font-family="Archivo, sans-serif" font-size="14.5" font-weight="700" fill="#0B0D10">{label}</text>
      <text x="52" y={P_TOP + 34 + i * P_STEP} font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">{meta}</text>
    </g>
  ))}

  <!-- Callouts on the gap -->
  <text x="52" y={P_TOP + 52 + 3 * P_STEP} font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="0.8" fill="#78828F">NO HANDOFF</text>
  <text x="52" y={P_TOP + 52 + 4 * P_STEP} font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="0.8" fill="#1D66D6">STILL ANSWERED</text>

  <!-- What the rail holds -->
  <g transform="translate(10, 500)">
    <rect width="340" height="56" rx="12" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
    <text x="16" y="24" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill="#1D66D6">The Signal Map, the device history,</text>
    <text x="16" y="42" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill="#1D66D6">every fix that worked</text>
  </g>
</svg>
