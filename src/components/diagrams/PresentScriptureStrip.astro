---
/**
 * Present — scripture to slides in three steps.
 * Type a reference, choose the translation and split, get re-editable slides.
 */
---

<svg
  viewBox="0 0 980 268"
  width="100%"
  role="img"
  aria-label="Three-step diagram: type a scripture reference, choose a translation and verses per slide, and finished slides appear ready to present."
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Step 1 — type the reference -->
  <g transform="translate(20, 40)">
    <rect x="0" y="0" width="278" height="188" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="22" y="32" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">01 · TYPE IT</text>
    <rect x="22" y="52" width="234" height="46" rx="10" fill="#F7F9FB" stroke="#C5DDFB" stroke-width="1.5" />
    <text x="40" y="81" font-family="Archivo, sans-serif" font-size="17" font-weight="600" fill="#0B0D10">John 3:16</text>
    <rect x="132" y="64" width="1.5" height="22" fill="#2B7FF0" />
    <text x="22" y="128" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">Books, chapters, and ranges —</text>
    <text x="22" y="146" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">“Rom 8:28–39” works too.</text>
  </g>

  <!-- Step 2 — choose -->
  <g transform="translate(351, 40)">
    <rect x="0" y="0" width="278" height="188" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="22" y="32" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">02 · CHOOSE</text>
    <rect x="22" y="50" width="110" height="28" rx="7" fill="#2B7FF0" />
    <text x="40" y="69" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#ffffff">KJV</text>
    <rect x="142" y="50" width="54" height="28" rx="7" fill="#F2F4F7" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="158" y="69" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#78828F">WEB</text>
    <rect x="206" y="50" width="50" height="28" rx="7" fill="#F2F4F7" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="220" y="69" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" fill="#78828F">ASV</text>
    <rect x="22" y="94" width="234" height="34" rx="8" fill="#F7F9FB" stroke="#E3E7ED" stroke-width="1.5" />
    <circle cx="42" cy="111" r="7" fill="#2B7FF0" />
    <path d="M39 111 l2.5 2.5 l4.5-5" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <text x="58" y="116" font-family="Archivo, sans-serif" font-size="12.5" fill="#3F4854">One verse per slide</text>
    <text x="22" y="152" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">Verse numbers and reference</text>
    <text x="22" y="170" font-family="Archivo, sans-serif" font-size="12.5" fill="#78828F">style are yours to set.</text>
  </g>

  <!-- Step 3 — slides -->
  <g transform="translate(682, 40)">
    <rect x="0" y="0" width="278" height="188" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <text x="22" y="32" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">03 · DONE</text>
    <g transform="translate(22, 48)">
      <rect x="0" y="0" width="112" height="63" rx="7" fill="#0B0D10" />
      <rect x="12" y="16" width="76" height="7" rx="3.5" fill="#ffffff" opacity="0.92" />
      <rect x="12" y="30" width="88" height="7" rx="3.5" fill="#ffffff" opacity="0.92" />
      <text x="12" y="54" font-family="IBM Plex Mono, monospace" font-size="7" font-weight="600" letter-spacing="0.8" fill="#6AA9F4">JOHN 3:16</text>
    </g>
    <g transform="translate(144, 48)">
      <rect x="0" y="0" width="112" height="63" rx="7" fill="#0B0D10" />
      <rect x="12" y="16" width="88" height="7" rx="3.5" fill="#ffffff" opacity="0.92" />
      <rect x="12" y="30" width="64" height="7" rx="3.5" fill="#ffffff" opacity="0.92" />
      <text x="12" y="54" font-family="IBM Plex Mono, monospace" font-size="7" font-weight="600" letter-spacing="0.8" fill="#6AA9F4">JOHN 3:17</text>
    </g>
    <text x="22" y="140" font-family="Archivo, sans-serif" font-size="12.5" fill="#3F4854">Add to the live playlist, or save</text>
    <text x="22" y="158" font-family="Archivo, sans-serif" font-size="12.5" fill="#3F4854">it as a re-editable presentation.</text>
  </g>

  <!-- Connectors -->
  <path d="M306 134 H336" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M330 128 L338 134 L330 140" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M637 134 H667" fill="none" stroke="#C5DDFB" stroke-width="2" stroke-linecap="round" />
  <path d="M661 128 L669 134 L661 140" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Caption -->
  <text x="20" y="24" font-family="IBM Plex Mono, monospace" font-size="10" font-weight="600" letter-spacing="1.6" fill="#2B7FF0">SIX TRANSLATIONS INCLUDED · NO COPY-PASTE</text>
</svg>
