---
/**
 * Pricing — pick a platform tier, then add the support you want.
 * Makes the two independent choices visible instead of implied.
 */
const platform = [
  { y: 0, name: "Free", price: "$0", note: "AV monitoring, Signal Map, alerts", dark: false },
  { y: 62, name: "Assist", price: "$49/mo", note: "The full suite + 24/7 AI support", dark: false },
  { y: 124, name: "Stream", price: "$99/mo", note: "Adds cloud live streaming, per campus", dark: true },
];
const support = [
  { y: 0, name: "None", price: "included", note: "AI support and one free session", dark: false },
  { y: 62, name: "Care", price: "+$199/mo", note: "Weekday pro, priority queue", dark: false },
  { y: 124, name: "Sunday Assurance", price: "+$499/mo", note: "A pro watching every Sunday", dark: false },
  { y: 186, name: "Managed", price: "+$1,299/mo", note: "Fully handled, Stream included", dark: true },
];
---

<svg
  viewBox="0 0 980 340"
  width="100%"
  role="img"
  aria-label="Diagram: pricing is two independent choices — pick one platform tier from Free, Assist, or Stream, then optionally add one support level from Care, Sunday Assurance, or Managed. Any tier combines with any add-on."
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Column 1 -->
  <text x="20" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">STEP 1 · PICK ONE PLATFORM</text>
  {platform.map(({ y, name, price, note, dark }) => (
    <g transform={`translate(20, ${48 + y})`}>
      <rect x="0" y="0" width="392" height="52" rx="11" fill={dark ? "#0B0D10" : "#ffffff"} stroke={dark ? "#0B0D10" : "#E3E7ED"} stroke-width="1.5" />
      <text x="20" y="23" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill={dark ? "#ffffff" : "#0B0D10"}>{name}</text>
      <text x="20" y="40" font-family="Archivo, sans-serif" font-size="11.5" fill={dark ? "#9CC6F8" : "#78828F"}>{note}</text>
      <text x="372" y="31" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" fill={dark ? "#6AA9F4" : "#1D66D6"}>{price}</text>
    </g>
  ))}

  <!-- Plus -->
  <g transform="translate(444, 140)">
    <circle cx="26" cy="26" r="26" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="2" />
    <path d="M26 14 V38 M14 26 H38" fill="none" stroke="#2B7FF0" stroke-width="3" stroke-linecap="round" />
  </g>

  <!-- Column 2 -->
  <text x="548" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">STEP 2 · ADD HUMAN SUPPORT, IF YOU WANT IT</text>
  {support.map(({ y, name, price, note, dark }) => (
    <g transform={`translate(548, ${48 + y})`}>
      <rect x="0" y="0" width="412" height="52" rx="11" fill={dark ? "#0B0D10" : "#ffffff"} stroke={dark ? "#0B0D10" : "#E3E7ED"} stroke-width="1.5" />
      <text x="20" y="23" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill={dark ? "#ffffff" : "#0B0D10"}>{name}</text>
      <text x="20" y="40" font-family="Archivo, sans-serif" font-size="11.5" fill={dark ? "#9CC6F8" : "#78828F"}>{note}</text>
      <text x="392" y="31" text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="12" font-weight="600" fill={dark ? "#6AA9F4" : "#1D66D6"}>{price}</text>
    </g>
  ))}

  <!-- Footnote -->
  <text x="20" y="300" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">Any platform tier combines with any support level &mdash; and the free pledge never changes either way.</text>
</svg>
