---
/**
 * Cloud Control — the booth's switcher, reachable from anywhere.
 * OBS / vMix / ATEM ↔ Tech Manager → one secure outbound link →
 * preview & program eyes, full API control, and remote assistance.
 */
const remote = [
  { y: 52, label: "Preview & program, live", meta: "See what's on air and what's next" },
  { y: 116, label: "Full API control", meta: "Cut, transition, scenes, and inputs" },
  { y: 180, label: "Remote assistance", meta: "A trusted helper watches — or takes the wheel", dark: true },
];
const cloudSteps = ["No port forwarding", "Full API relayed live", "Preview & program mirrored"];
const LABEL = "Diagram: OBS, vMix, or a Blackmagic ATEM connects to Tech Manager in the booth, where local control is free on every plan. Tech Manager makes one secure outbound connection to the WorshipMetrics cloud, which relays the full API and mirrors preview and program — so a phone or laptop anywhere gets live preview and program monitoring, full switcher control, and a trusted helper can assist remotely. Cloud control comes with Assist and Stream.";
---

<svg
  viewBox="0 0 980 380"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="hidden h-auto w-full md:block"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Booth -->
  <text x="20" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">YOUR BOOTH</text>
  <g transform="translate(20, 96)">
    <rect x="0" y="0" width="210" height="148" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="20" y="20" width="30" height="30" rx="7" fill="#0B0D10" />
    <path d="M27 38 h4 l4.4-11 l5.4 21 l4.4-10 h4" fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="60" y="33" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill="#0B0D10">Tech Manager</text>
    <text x="60" y="49" font-family="Archivo, sans-serif" font-size="11.5" fill="#78828F">wired to your switcher</text>
    <g transform="translate(20, 66)">
      <rect x="0" y="0" width="44" height="24" rx="6" fill="#F4F6F9" stroke="#E3E7ED" stroke-width="1.2" />
      <text x="22" y="16" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" fill="#3F4854">OBS</text>
      <rect x="52" y="0" width="48" height="24" rx="6" fill="#F4F6F9" stroke="#E3E7ED" stroke-width="1.2" />
      <text x="76" y="16" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" fill="#3F4854">vMix</text>
      <rect x="108" y="0" width="52" height="24" rx="6" fill="#F4F6F9" stroke="#E3E7ED" stroke-width="1.2" />
      <text x="134" y="16" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" fill="#3F4854">ATEM</text>
    </g>
    <text x="20" y="118" font-family="Archivo, sans-serif" font-size="12" fill="#3F4854">Local control in the booth &mdash;</text>
    <text x="20" y="134" font-family="Archivo, sans-serif" font-size="12" font-weight="700" fill="#1D66D6">free on every plan.</text>
  </g>

  <!-- Link arrow -->
  <path d="M234 170 H300" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" />
  <path d="M292 163 L302 170 L292 177" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="228" y="142" width="86" height="22" rx="5" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <text x="238" y="157" font-family="IBM Plex Mono, monospace" font-size="9" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SECURE LINK</text>

  <!-- Cloud -->
  <text x="312" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">WORSHIPMETRICS</text>
  <g transform="translate(312, 96)">
    <rect x="0" y="0" width="212" height="148" rx="16" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <text x="22" y="34" font-family="Archivo, sans-serif" font-size="14" font-weight="700" fill="#0B0D10">One outbound link</text>
    {cloudSteps.map((t, i) => (
      <g transform={`translate(22, ${52 + i * 28})`}>
        <circle cx="5" cy="9" r="4" fill="#2B7FF0" />
        <text x="18" y="13" font-family="Archivo, sans-serif" font-size="12" fill="#3F4854">{t}</text>
      </g>
    ))}
  </g>

  <!-- Fan-out arrows -->
  {remote.map(({ y }) => (
    <path
      d={`M528 170 C 590 170, 600 ${y + 28}, 664 ${y + 28}`}
      fill="none"
      stroke="#C5DDFB"
      stroke-width="2"
      stroke-linecap="round"
    />
  ))}
  {remote.map(({ y }) => (
    <path d={`M658 ${y + 22} L666 ${y + 28} L658 ${y + 34}`} fill="none" stroke="#2B7FF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  ))}

  <!-- From anywhere -->
  <text x="676" y="24" font-family="IBM Plex Mono, monospace" font-size="9.5" font-weight="600" letter-spacing="1.3" fill="#78828F">FROM ANYWHERE &middot; ASSIST &amp; STREAM</text>
  {remote.map(({ y, label, meta, dark }) => (
    <g transform={`translate(676, ${y})`}>
      <rect x="0" y="0" width="284" height="56" rx="10" fill={dark ? "#0B0D10" : "#ffffff"} stroke={dark ? "#0B0D10" : "#E3E7ED"} stroke-width="1.5" />
      <circle cx="24" cy="28" r="5" fill={dark ? "#6AA9F4" : "#2B7FF0"} />
      <text x="42" y="25" font-family="Archivo, sans-serif" font-size="13" font-weight="700" fill={dark ? "#ffffff" : "#0B0D10"}>{label}</text>
      <text x="42" y="41" font-family="Archivo, sans-serif" font-size="11" fill={dark ? "#9CC6F8" : "#78828F"}>{meta}</text>
    </g>
  ))}

  <!-- Footnote -->
  <text x="20" y="356" font-family="Archivo, sans-serif" font-size="13" fill="#3F4854">A phone on the beach sees the same preview and program the booth sees &mdash; and can do something about it.</text>
</svg>

<!-- Portrait: booth → cloud → anywhere, top to bottom. -->
<svg
  viewBox="0 0 360 726"
  width="100%"
  role="img"
  aria-label={LABEL}
  class="mx-auto block h-auto w-full max-w-[460px] md:hidden"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Booth -->
  <text x="10" y="16" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">YOUR BOOTH</text>
  <g transform="translate(10, 26)">
    <rect x="0" y="0" width="340" height="140" rx="14" fill="#ffffff" stroke="#E3E7ED" stroke-width="1.5" />
    <rect x="20" y="20" width="34" height="34" rx="8" fill="#0B0D10" />
    <path d="M28 40 h4.5 l5-12.5 l6 24 l5-11.5 h4.5" fill="none" stroke="#2B7FF0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="66" y="36" font-family="Archivo, sans-serif" font-size="16" font-weight="700" fill="#0B0D10">Tech Manager</text>
    <text x="66" y="54" font-family="Archivo, sans-serif" font-size="13" fill="#78828F">wired to your switcher</text>
    <g transform="translate(20, 68)">
      <rect x="0" y="0" width="52" height="26" rx="6" fill="#F4F6F9" stroke="#E3E7ED" stroke-width="1.2" />
      <text x="26" y="17" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" fill="#3F4854">OBS</text>
      <rect x="60" y="0" width="56" height="26" rx="6" fill="#F4F6F9" stroke="#E3E7ED" stroke-width="1.2" />
      <text x="88" y="17" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" fill="#3F4854">vMix</text>
      <rect x="124" y="0" width="60" height="26" rx="6" fill="#F4F6F9" stroke="#E3E7ED" stroke-width="1.2" />
      <text x="154" y="17" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" fill="#3F4854">ATEM</text>
    </g>
    <text x="20" y="122" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">Local control &mdash; <tspan font-weight="700" fill="#1D66D6">free on every plan.</tspan></text>
  </g>

  <!-- Link arrow -->
  <rect x="128" y="176" width="104" height="24" rx="6" fill="#EFF6FE" stroke="#C5DDFB" stroke-width="1.5" />
  <text x="180" y="192" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10.5" font-weight="600" letter-spacing="0.6" fill="#1D66D6">SECURE LINK</text>
  <path d="M180 206 V 224" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" />
  <path d="M173 218 L180 226 L187 218" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Cloud -->
  <text x="10" y="250" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#2B7FF0">WORSHIPMETRICS</text>
  <g transform="translate(10, 260)">
    <rect x="0" y="0" width="340" height="130" rx="16" fill="#EFF6FE" stroke="#2B7FF0" stroke-width="2" />
    <text x="22" y="34" font-family="Archivo, sans-serif" font-size="16" font-weight="700" fill="#0B0D10">One outbound link</text>
    {cloudSteps.map((t, i) => (
      <g transform={`translate(22, ${50 + i * 26})`}>
        <circle cx="5" cy="9" r="4.5" fill="#2B7FF0" />
        <text x="20" y="14" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">{t}</text>
      </g>
    ))}
  </g>
  <path d="M180 390 V 414" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" />
  <path d="M173 408 L180 416 L187 408" fill="none" stroke="#2B7FF0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- From anywhere -->
  <text x="10" y="440" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" letter-spacing="1.3" fill="#78828F">FROM ANYWHERE &middot; ASSIST &amp; STREAM</text>
  {remote.map(({ label, meta, dark }, i) => (
    <g transform={`translate(10, ${450 + i * 66})`}>
      <rect x="0" y="0" width="340" height="58" rx="11" fill={dark ? "#0B0D10" : "#ffffff"} stroke={dark ? "#0B0D10" : "#E3E7ED"} stroke-width="1.5" />
      <circle cx="24" cy="29" r="5.5" fill={dark ? "#6AA9F4" : "#2B7FF0"} />
      <text x="44" y="26" font-family="Archivo, sans-serif" font-size="15" font-weight="700" fill={dark ? "#ffffff" : "#0B0D10"}>{label}</text>
      <text x="44" y="44" font-family="Archivo, sans-serif" font-size="12" fill={dark ? "#9CC6F8" : "#78828F"}>{meta}</text>
    </g>
  ))}

  <!-- Footnote -->
  <text x="10" y="680" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">The same preview and program the booth sees &mdash;</text>
  <text x="10" y="698" font-family="Archivo, sans-serif" font-size="13.5" fill="#3F4854">on any phone, anywhere.</text>
</svg>
