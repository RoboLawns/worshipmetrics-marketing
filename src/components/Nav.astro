---
import BrandLockup from "./BrandLockup.astro";

const APP_URL = "https://app.worshipmetrics.com";

const navItems = [
  {
    type: "dropdown",
    key: "present",
    label: "Present",
    icon: "/images/nav/pillars/present.png",
    overview: {
      href: "/present",
      label: "Present Overview",
      desc: "Worship presentation software — slides, lyrics, scripture, and stage display.",
    },
    items: [
      { href: "/church-lyrics-software", label: "Lyrics", desc: "Song slides built from your arrangements, with section colors and your church's brand" },
      { href: "/stage-display-software", label: "Stage Display", desc: "Current and next slide, chord charts in the right key, timers, and messages from the booth" },
    ],
  },
  {
    type: "dropdown",
    key: "produce",
    label: "Produce",
    icon: "/images/nav/pillars/produce.png",
    overview: {
      href: "/tech-manager",
      label: "Produce Overview",
      desc: "Run the booth: switcher, cameras, audio, and volunteer panels.",
    },
    items: [
      { href: "/tech-manager", label: "Tech Manager", desc: "The desktop app that powers the booth — and no encoder hardware to buy" },
      { href: "/av-team", label: "AV Team Panels", desc: "Role-based control panels that turn one operator into a real team" },
    ],
  },
  {
    type: "dropdown",
    key: "plan",
    label: "Plan",
    icon: "/images/nav/pillars/plan.png",
    overview: {
      href: "/services",
      label: "Plan Overview",
      desc: "Service prep, songs, and team assignments before Sunday starts.",
    },
    items: [
      { href: "/services", label: "Services", desc: "Plan the service, assign the team, schedule volunteers, and run Sunday from one workflow" },
      { href: "/songs", label: "Songs", desc: "Your song library — CCLI, keys, arrangements, and chord charts that transpose live" },
    ],
  },
  {
    type: "dropdown",
    key: "publish",
    label: "Publish",
    icon: "/images/nav/pillars/publish.png",
    overview: {
      href: "/live-streaming",
      label: "Publish Overview",
      desc: "One feed in — every destination, Reels, and signage out.",
    },
    items: [
      { href: "/live-streaming", label: "Live Streaming", desc: "Stream to YouTube, Facebook, your website, and any custom destination from one feed" },
      { href: "/church-livestream-analytics", label: "Stream Health", desc: "Live encoder telemetry on air, and a scored report after every stream" },
      { href: "/lossless-audio-streaming", label: "Lossless Audio", desc: "On the roadmap — CD-quality FLAC worship streams with a universal fallback" },
      { href: "/solutions/worship-clips", label: "Reels", desc: "Turn Sunday's service into shareable clips — we find the moments, you approve them" },
      { href: "/signage-display", label: "Slides & Signage", desc: "Digital signage that updates from a phone and keeps the campus informed" },
    ],
  },
  {
    type: "dropdown",
    key: "pulse",
    label: "Pulse",
    icon: "/images/nav/pillars/pulse.png",
    overview: {
      href: "/av-monitoring",
      label: "Pulse Overview",
      desc: "AV monitoring, alerts, and attendance in real time — free forever.",
    },
    items: [
      { href: "/av-monitoring", label: "AV Monitoring", desc: "System health, device status, and booth observability with instant alerts" },
      { href: "/platform/attendance", label: "Attendance", desc: "Count in-room and online together without a separate reporting stack" },
    ],
  },
  {
    type: "dropdown",
    key: "patch",
    label: "Patch",
    icon: "/images/nav/pillars/patch.png",
    overview: {
      href: "/system-documentation",
      label: "Patch Overview",
      desc: "Every device, wire, and signal path — documented and alive.",
    },
    items: [
      { href: "/system-documentation", label: "System Documentation", desc: "Device inventory, the living Signal Map, and patch sheets that survive volunteer turnover" },
    ],
  },
  {
    type: "dropdown",
    key: "people",
    label: "People",
    icon: "/images/nav/pillars/people.png",
    overview: {
      href: "/people",
      label: "People Overview",
      desc: "The congregation, the volunteers, and the team that carries Sunday.",
    },
    items: [
      { href: "/people", label: "People", desc: "Members, guests, and attenders in one directory with households and follow-up" },
      { href: "/volunteers", label: "Volunteers", desc: "Capabilities, scheduling, communications, and replacement workflows" },
      { href: "/team-chat", label: "Team Chat", desc: "Real-time communication built for the booth, not a separate app" },
      { href: "/av-team", label: "AV Team", desc: "Seven role-based control panels that turn one operator into a real team" },
      { href: "/av-club", label: "AV Club", desc: "How churches build volunteer and youth ministry through production roles" },
    ],
  },
  {
    type: "dropdown",
    key: "support",
    label: "Support",
    icon: "/images/nav/support.png",
    overview: {
      href: "/kb",
      label: "Support Overview",
      desc: "Help, training, and success resources for your church team.",
    },
    items: [
      { href: "/phone-support", label: "Phone Support — 910-WORSHIP", desc: "Journey answers around the clock with your system in front of it" },
      { href: "/luminos-ai-assistant", label: "Luminos AI", desc: "The in-app AI that diagnoses from your live system, not a script" },
      { href: "/kb", label: "Knowledge Base", desc: "Guides, troubleshooting, comparisons, and setup help for church teams" },
      { href: "/professional-services", label: "Professional Services", desc: "Consulting, training, installs, and production support" },
      { href: "/contact", label: "Contact", desc: "Email, phone, and practical help when you need it" },
    ],
  },
  {
    type: "link",
    key: "pricing",
    label: "Pricing",
    href: "/pricing",
  },
];

const dropdownMenus = navItems.filter((item) => item.type === "dropdown");
const simpleLinks = navItems.filter((item) => item.type === "link");
---

<style>
  .topbar {
    background: var(--bg-card-alt);
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    color: #5a6a8a;
  }
  .topbar-inner {
    max-width: 80rem; margin: 0 auto;
    padding: 0 1.5rem; height: 2rem;
    display: flex; align-items: center; justify-content: flex-end; gap: 1.25rem;
  }
  .topbar a {
    color: #5a6a8a; text-decoration: none; font-weight: 500;
    transition: color 0.15s;
  }
  .topbar a:hover { color: var(--primary); }
  .topbar-sep { color: var(--primary-border); }
  @media (max-width: 1199px) { .topbar { display: none; } }

  .nav-root {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 4px rgba(15,26,46,0.06);
  }
  .nav-inner {
    max-width: 80rem; margin: 0 auto;
    padding: 0 1.5rem; height: 4rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }

  .desktop-nav { display: none; align-items: center; gap: 0.1rem; }
  @media (min-width: 1200px) { .desktop-nav { display: flex; } }

  .nav-btn {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.4rem 0.45rem; border-radius: 0.5rem;
    font-size: 0.86rem; font-weight: 500; color: #4a5568; white-space: nowrap;
    background: none; border: none; cursor: pointer;
    text-decoration: none; transition: color 0.15s, background 0.15s;
  }
  .nav-btn:hover { color: var(--primary); background: var(--bg-card-alt); }
  .nav-btn svg { width: 0.85rem; height: 0.85rem; opacity: 0.6; transition: transform 0.2s; }
  .nav-btn-icon { width: 1.35rem; height: 1.35rem; border-radius: 0.3rem; flex-shrink: 0; }

  .dropdown-wrap { position: relative; }
  .dropdown-wrap::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 0.6rem; }
  .dropdown {
    position: absolute; left: 0; top: calc(100% + 0.4rem);
    min-width: 44rem; background: #fff;
    border: 1px solid var(--border); border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 16px 48px rgba(15,26,46,0.12);
    display: none; grid-template-columns: 1.1fr 2fr; gap: 0.75rem;
  }
  .dropdown.narrow { min-width: 28rem; grid-template-columns: 1fr 1fr; }
  .dropdown.right { left: auto; right: 0; }
  .dropdown-wrap:hover .dropdown,
  .dropdown-wrap:focus-within .dropdown { display: grid; }

  .drop-overview {
    background: var(--bg-card-alt); border: 1px solid var(--primary-border);
    border-radius: 0.75rem; padding: 1rem;
    text-decoration: none; display: flex; flex-direction: column; gap: 0.2rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .drop-overview:hover { background: #DFECFD; border-color: var(--primary); }
  .drop-overview .over-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--primary); }
  .drop-overview h3 { font-size: 0.9rem; font-weight: 700; color: var(--text); margin: 0.2rem 0 0; }
  .drop-overview p  { font-size: 0.78rem; color: #8494b0; line-height: 1.5; margin: 0; }

  .drop-items { display: flex; flex-direction: column; gap: 0.15rem; }
  .drop-item  {
    display: block; padding: 0.55rem 0.75rem;
    border-radius: 0.5rem; text-decoration: none;
    transition: background 0.15s;
  }
  .drop-item:hover { background: var(--bg-card-alt); }
  .drop-item .il { font-size: 0.875rem; font-weight: 600; color: var(--text); }
  .drop-item .id { font-size: 0.75rem; color: #8494b0; margin-top: 0.05rem; }

  .cta-area { display: none; align-items: center; gap: 0.5rem; }
  @media (min-width: 1200px) { .cta-area { display: flex; } }

  .mobile-toggle {
    display: flex; align-items: center; justify-content: center;
    width: 2.4rem; height: 2.4rem; border-radius: 0.5rem;
    border: 1.5px solid var(--border); background: #f7f8fc;
    color: var(--text); cursor: pointer;
  }
  @media (min-width: 1200px) { .mobile-toggle { display: none; } }

  .mobile-menu {
    display: none; flex-direction: column;
    padding: 0.75rem 1rem 1.25rem;
    border-top: 1px solid var(--border);
    background: #fff;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-menu.open { display: flex; }
  @media (min-width: 1200px) { .mobile-menu { display: none !important; } }

  .mob-accordion { border-bottom: 1px solid var(--bg-card-alt); }
  .mob-accordion:last-of-type { border-bottom: none; }

  .mob-acc-trigger {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%; background: none; border: none; cursor: pointer;
    padding: 0.65rem 0.5rem; text-align: left;
  }
  .mob-acc-trigger-left { display: flex; align-items: center; gap: 0.5rem; }
  .mob-acc-trigger-icon { width: 1.45rem; height: 1.45rem; border-radius: 0.3rem; flex-shrink: 0; }
  .mob-acc-trigger-label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--primary);
  }
  .mob-acc-chevron {
    width: 1rem; height: 1rem; color: var(--primary); opacity: 0.7;
    transition: transform 0.2s; flex-shrink: 0;
  }
  .mob-accordion.open .mob-acc-chevron { transform: rotate(180deg); }

  .mob-acc-body { display: none; padding-bottom: 0.5rem; }
  .mob-accordion.open .mob-acc-body { display: block; }

  .mob-link {
    display: flex; flex-direction: column; padding: 0.4rem 0.75rem;
    border-radius: 0.5rem; text-decoration: none; transition: background 0.15s;
  }
  .mob-link:hover { background: var(--bg-card-alt); }
  .mob-link .ml { font-size: 0.875rem; font-weight: 600; color: var(--text); }
  .mob-link .md { font-size: 0.75rem; color: #8494b0; }

  .mob-simple { padding: 0.5rem 0 0; }
  .mob-simple-link {
    display: block; padding: 0.5rem 0.75rem; border-radius: 0.5rem;
    text-decoration: none; font-size: 0.875rem; font-weight: 600; color: var(--text);
    transition: background 0.15s;
  }
  .mob-simple-link:hover { background: var(--bg-card-alt); }

  .mob-contact {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1rem;
    padding: 0.6rem 0.75rem 0;
    font-size: 0.78rem;
  }
  .mob-contact a { color: #5a6a8a; text-decoration: none; font-weight: 500; }
  .mob-contact a:hover { color: var(--primary); }

  .mob-ctas { display: flex; flex-direction: column; gap: 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--border); margin-top: 0.75rem; }
</style>

<div class="topbar">
  <div class="topbar-inner">
    <a href="/about">About</a>
    <span class="topbar-sep">|</span>
    <a href="/pricing">Pricing</a>
    <span class="topbar-sep">|</span>
    <a href="mailto:support@worshipmetrics.com">support@worshipmetrics.com</a>
    <span class="topbar-sep">|</span>
    <a href="tel:+19109677447">910-WORSHIP (910-967-7447) &middot; 7 days a week</a>
  </div>
</div>

<header class="nav-root">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="WorshipMetrics home">
      <BrandLockup width={150} />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        item.type === "dropdown" ? (
          <div class="dropdown-wrap">
            <button class="nav-btn" type="button" aria-haspopup="true">
              {item.icon && <img src={item.icon} alt="" class="nav-btn-icon" width="18" height="18" />}
              {item.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class={`dropdown ${item.key === "present" || item.key === "produce" || item.key === "plan" || item.key === "patch" || item.key === "pulse" ? "narrow" : ""} ${item.key === "pulse" || item.key === "patch" || item.key === "people" || item.key === "support" ? "right" : ""}`}>
              <a href={item.overview.href} class="drop-overview">
                <span class="over-label">{item.label}</span>
                <h3>{item.overview.label}</h3>
                <p>{item.overview.desc}</p>
              </a>
              <div class="drop-items">
                {item.items.map((entry) => (
                  <a href={entry.href} class="drop-item">
                    <div class="il">{entry.label}</div>
                    <div class="id">{entry.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class="nav-btn">
            {item.icon && <img src={item.icon} alt="" class="nav-btn-icon" width="18" height="18" />}
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="cta-area">
      <a href={`${APP_URL}/sign-in`} class="btn-primary" style="padding:0.45rem 1rem;font-size:0.82rem;white-space:nowrap;" data-wm-track="cta_click" data-wm-track-label="nav_sign_in" data-wm-track-location="nav">Sign In</a>
    </div>

    <button class="mobile-toggle" id="mobile-nav-toggle" aria-label="Toggle navigation" type="button">
      <svg id="icon-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="display:none">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    {dropdownMenus.map((menu) => (
      <div class="mob-accordion" data-accordion>
        <button class="mob-acc-trigger" type="button" data-acc-trigger>
          <span class="mob-acc-trigger-left">
            {menu.icon && <img src={menu.icon} alt="" class="mob-acc-trigger-icon" width="18" height="18" />}
            <span class="mob-acc-trigger-label">{menu.label}</span>
          </span>
          <svg class="mob-acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mob-acc-body">
          <a href={menu.overview.href} class="mob-link">
            <span class="ml">{menu.overview.label}</span>
            <span class="md">{menu.overview.desc}</span>
          </a>
          {menu.items.map((entry) => (
            <a href={entry.href} class="mob-link">
              <span class="ml">{entry.label}</span>
              <span class="md">{entry.desc}</span>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="mob-simple">
      {simpleLinks.map((item) => (
        <a href={item.href} class="mob-simple-link" style="display:flex;align-items:center;gap:0.5rem;">
          {item.icon && <img src={item.icon} alt="" width="18" height="18" style="border-radius:0.3rem;" />}
          {item.label}
        </a>
      ))}
    </div>

    <div class="mob-contact">
      <a href="mailto:support@worshipmetrics.com">support@worshipmetrics.com</a>
      <a href="tel:+19109677447">910-WORSHIP (910-967-7447)</a>
    </div>

    <div class="mob-ctas">
      <a href={`${APP_URL}/sign-in`} class="btn-primary" style="justify-content:center" data-wm-track="cta_click" data-wm-track-label="mobile_nav_sign_in" data-wm-track-location="mobile_nav">Sign In</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-nav-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const iconMenu = document.getElementById("icon-menu")!;
  const iconClose = document.getElementById("icon-close")!;

  toggle.addEventListener("click", () => {
    const open = menu.classList.toggle("open");
    iconMenu.style.display = open ? "none" : "";
    iconClose.style.display = open ? "" : "none";

    if (!open) {
      document.querySelectorAll("[data-accordion]").forEach((acc) => acc.classList.remove("open"));
    }
  });

  document.querySelectorAll("[data-acc-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const accordion = trigger.closest("[data-accordion]")!;
      const isOpen = accordion.classList.contains("open");

      document.querySelectorAll("[data-accordion]").forEach((acc) => acc.classList.remove("open"));
      if (!isOpen) accordion.classList.add("open");
    });
  });
</script>
