---
interface Item {
  question: string;
  href: string;
}

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = "Go deeper in the Knowledge Base" } = Astro.props;
---

<section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow text-center">From the Knowledge Base</p>
    <h2 class="mt-3 text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{heading}</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {items.map(({ question, href }) => (
        <a href={href} class="group flex items-start justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm transition hover:border-indigo-300 hover:bg-white">
          <span class="text-base font-semibold leading-snug text-slate-900 group-hover:text-indigo-700">{question}</span>
          <span aria-hidden="true" class="mt-0.5 flex-shrink-0 text-indigo-500 transition group-hover:translate-x-0.5">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
