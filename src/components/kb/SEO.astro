---
interface BreadcrumbItem {
  name: string;
  item: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  robots?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  breadcrumbItems?: BreadcrumbItem[];
  faq?: FaqItem[];
  lang?: string;
  alternates?: AlternateLink[];
}

const SITE_URL = 'https://worshipmetrics.com';
const DEFAULT_IMAGE = `${SITE_URL}/logo.png`;

const {
  title,
  description,
  canonical,
  image = DEFAULT_IMAGE,
  robots = 'index, follow',
  type = 'website',
  publishedAt,
  updatedAt,
  breadcrumbItems = [],
  faq = [],
  lang = 'en',
  alternates = [],
} = Astro.props;

const titleSuffix = lang === 'es' ? 'Base de Conocimiento WorshipMetrics' : 'WorshipMetrics Knowledge Base';

const normalizeCanonicalPath = (value: string) => {
  if (value === '/') return '/';
  if (/[?#]/.test(value) || /\.[a-z0-9]+$/i.test(value) || value.endsWith('/')) return value;
  return `${value}/`;
};

const canonicalUrl = canonical.startsWith('http') ? canonical : `${SITE_URL}${normalizeCanonicalPath(canonical)}`;
const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;
const pageTitle = `${title} | ${titleSuffix}`;

const jsonLd: unknown[] = [];

if (type === 'article') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: ogImage,
    datePublished: publishedAt?.toISOString(),
    dateModified: (updatedAt || publishedAt)?.toISOString(),
    author: {
      '@type': 'Organization',
      name: 'WorshipMetrics',
    },
    publisher: {
      '@type': 'Organization',
      name: 'WorshipMetrics',
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/logo.png`,
      },
    },
    mainEntityOfPage: canonicalUrl,
  });
}

if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((entry) => ({
      '@type': 'Question',
      name: entry.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: entry.answer,
      },
    })),
  });
}

if (breadcrumbItems.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  });
}
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((entry) => (
  <script type="application/ld+json" set:html={JSON.stringify(entry)}></script>
))}
