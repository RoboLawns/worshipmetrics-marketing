---
import Layout from "../layouts/Layout.astro";
import KBQuestions from "../components/KBQuestions.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";
import PatchCableLabel from "../components/diagrams/PatchCableLabel.astro";
import AppScreenshot from "../components/AppScreenshot.astro";
import { patchDevicesList, patchSignalMap, printableWiringDiagram, printablePatchSheet } from "../data/appScreenshots";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/lifestyle/av-device-system-layout.jpg`;
const DEVICE_IMAGE = "/images/app/worship-metrics-patch-devices-grid.jpg";
const WIRING_IMAGE = "/images/app/worship-metrics-patch-signal-map.jpg";
const PATCH_SHEET_LIFESTYLE = "/images/lifestyle/church-patch-sheet-clipboard.jpg";
const DIAGRAM_LIFESTYLE = "/images/lifestyle/church-wiring-diagram-clipboard.jpg";

const features = [
  {
    icon: "map",
    title: "A map that draws like a CAD tool",
    body: "A snap-to-grid canvas with drag-from-port wiring and smart orthogonal cable routing — bundles fan symmetrically, lines jump at crossings, and the whole layout stays legible as the system grows.",
  },
  {
    icon: "tag",
    title: "Every cable gets a permanent ID",
    body: "Draw a connection and it's labeled the moment it exists — SDI-001, DANTE-002, NET-014 — and never renumbered. Delete SDI-001 and SDI-002 keeps its name forever. Those IDs key the patch sheet, the printed diagram, and every support conversation.",
  },
  {
    icon: "circle-stack",
    title: "348 devices with factory port maps",
    body: "Add a Behringer WING or an ATEM and its real rear panel arrives already documented — nearly 2,000 factory port presets across 114 manufacturers, down to PoE class and wattage budgets.",
  },
  {
    icon: "sparkles",
    title: "AI research for unknown gear",
    body: "Gear the library doesn't know gets researched on demand: AI confirms the real port complement with live web search, flags its confidence, and is always visually distinct from human-verified entries.",
  },
  {
    icon: "wifi",
    title: "Verified against the live network",
    body: "Connect your UniFi controller and the map checks itself against reality: port-precise topology, live PoE draw per port, and negotiated versus maximum link speed — so a gigabit port stuck at 100 Mb is visible, not mysterious.",
  },
  {
    icon: "magnifying-glass",
    title: "Seven automated wiring audits",
    body: "Duplicate cables, self-loops, out-to-out direction conflicts, unmapped signals, connector mismatches, port-less endpoints, and duplicate device names — each finding jumps you straight to the offending cable.",
  },
  {
    icon: "no-symbol",
    title: "It knows AES50 dies at a switch",
    body: "The compatibility engine separates network signals that can ride a switch — Dante, AES67, NDI, Art-Net — from point-to-point links that can't, like AES50, Ultranet, and HDBaseT. The classic snake-into-the-switch disaster is prevented in the vocabulary itself.",
  },
  {
    icon: "document-arrow-up",
    title: "Import the integrator's drawing",
    body: "Upload the installer's schematic or proposal as a PDF or photo, and AI vision extracts the devices and wiring into your map — nothing writes until a human reviews and approves it.",
  },
  {
    icon: "printer",
    title: "Patch sheets & vector PDF diagrams",
    body: "The patch sheet prints portrait or landscape, in color or mono-laser black-and-white, with your church logo and per-room sections. The wiring diagram exports as a true vector PDF in integrator-proposal style.",
  },
  {
    icon: "book-open",
    title: "Documentation the AI actually reads",
    body: "Every Luminos chat and 910-WORSHIP call loads your live inventory — and can pull the full signal map with cable and port labels on demand. Documenting your system is what makes support this specific.",
  },
];

const capabilities = [
  {
    icon: "funnel",
    title: "Organize by device type",
    body: "View just your audio system, just your cameras, or just your lighting rig. Filter by device type so you only see the gear relevant to the question you're answering.",
  },
  {
    icon: "map-pin",
    title: "Organize by room",
    body: "Group devices into rooms — lobby, front stage, balcony booth, overflow room. Manage each space independently or see the full system map across your entire campus.",
  },
  {
    icon: "chat-bubble-left-right",
    title: "Syncs with Luminos AI",
    body: "The better you document your system, the smarter Luminos becomes. When something breaks, the AI already knows your signal chain, your device models, and your room layout — so troubleshooting starts in seconds, not hours.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WorshipMetrics System Documentation",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Windows, Mac",
  url: `${SITE_URL}/system-documentation`,
  image: HERO_IMAGE,
  description: "Document your church AV system with a guided wizard that builds automatic wiring diagrams. Organize devices by type and room, generate professional printouts for cable labeling, and sync everything with Luminos AI for smarter troubleshooting.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${SITE_URL}/pricing`,
  },
};
---

<Layout
  title="Church AV System Documentation & Signal Map"
  socialTitle="WorshipMetrics System Documentation"
  description="Document your church AV system with a guided wizard that builds automatic wiring diagrams. Organize devices by type and room, and sync with Luminos AI for smarter troubleshooting."
  canonical="/system-documentation"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO_IMAGE} />
  </Fragment>

  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
      <div>
        <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><img src="/images/nav/pillars/patch.png" alt="" class="h-9 w-9 rounded-lg" /> Patch</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Every cable, mapped. Every fix, faster.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          The Signal Map documents your whole system &mdash; devices, ports, and labeled cable runs. Knowledge stops living in one volunteer&apos;s head, new team members find their way around in minutes, and support can point to the exact cable.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`${APP_URL}/sign-up`} class="btn-primary" data-wm-track="cta_click" data-wm-track-label="system_docs_hero_sign_up_free" data-wm-track-location="system_docs_hero">Sign up free</a>
          <a href="/tech-manager" class="btn-outline">Download Tech Manager</a>
          <a href="/luminos-ai-assistant" class="btn-outline">See Luminos AI</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">System documentation is included in Tech Manager, free.</p>
      </div>

      <ImageCarousel
        eager
        slides={[
          { src: HERO_IMAGE, alt: "Church AV system laid out and documented", kind: "lifestyle" },
          { src: DEVICE_IMAGE, alt: "Device inventory with every piece of AV gear as cards with brand, model, and IP address in WorshipMetrics", label: "Devices" },
          { src: WIRING_IMAGE, alt: "Signal Map with labeled cable runs, port detail, and category filters in WorshipMetrics", label: "Signal Map" },
          { src: printableWiringDiagram.src, alt: printableWiringDiagram.alt, label: "Printed diagram" },
          { src: PATCH_SHEET_LIFESTYLE, alt: "A volunteer holding a freshly printed WorshipMetrics patch sheet beside the consoles in a church production booth", kind: "lifestyle", label: "On paper" },
        ]}
      />
    </div>
  </section>

  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">How it works</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Build a professional AV system map in minutes, not days.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Most churches either have no documentation at all, or a dusty PDF that hasn&apos;t been updated since the last install. System Documentation gives you a living map of every device, every connection, and every signal path — kept current and shared with your team.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {features.map(({ icon, title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <FeatureIcon name={icon} />
            <p class="mt-5 text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">{title}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Device library</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">348 devices pre-loaded. No guesswork.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          When you add a device to your system, we already know the specs. Select a Behringer Wing and the port count, protocols, and connection options populate automatically. The same goes for Blackmagic switchers, PTZ cameras, audio mixers, encoders, and hundreds more.
        </p>
        <ul class="mt-8 space-y-3">
          {[
            "A 422-entry device library with pre-loaded specs, and counting",
            "Automatic port mapping — no more counting XLR jacks on a spec sheet",
            "Protocol detection so you know what talks to what",
            "Device library grows as manufacturers release new gear",
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <div class="mt-8">
          <a href="/tech-manager" class="btn-outline">See Tech Manager</a>
        </div>
      </div>
      <div class="self-center overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={DEVICE_IMAGE} alt="The Devices inventory in WorshipMetrics: cards for every piece of AV gear with brand, model, and IP address, grouped by category" loading="lazy" decoding="async" class="w-full" />
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div class="self-center overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={patchDevicesList.src} alt={patchDevicesList.alt} loading="lazy" decoding="async" class="w-full" />
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Organize by type & room</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">See the system the way your team thinks about it.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Your audio team doesn&apos;t need to see the lighting rig. Your lighting operator doesn&apos;t need to scroll past the cameras. System Documentation lets you organize devices by type or by room so every person sees exactly what they need.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {capabilities.map(({ icon, title, body }) => (
            <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
              <FeatureIcon name={icon} />
              <p class="mt-4 text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">{title}</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Diagram: the label that makes support specific -->
  <section class="bg-white px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl border-t border-slate-200 pt-16">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Why the labels matter</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">One cable ID, from the map to the phone call.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Every connection you draw gets a permanent ID. Put that same ID on the physical cable, and troubleshooting stops being a scavenger hunt &mdash; because support can name the exact cable instead of describing a category of cable.
        </p>
      </div>
      <div class="mt-10 md:overflow-x-auto">
        <div class="md:min-w-[760px]">
          <PatchCableLabel />
        </div>
      </div>
      <div class="mt-14">
        <AppScreenshot shot={patchSignalMap} label="The map those IDs live on" />
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Printable documentation</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A source of truth you can hand to a volunteer.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          The wiring diagrams inside WorshipMetrics do quiet, important work — they&apos;re what Luminos and our remote support read when they help you. But documentation only changes Sunday when it reaches the real world. So the same live map prints: a clean System Wiring Diagram and a cable-by-cable Patch Sheet, generated on demand and stamped with the moment they were made.
        </p>
      </div>

      <div class="mt-12 grid gap-12 lg:grid-cols-2">
        <div>
          <h3 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Print today&apos;s system, not the one from the install.</h3>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            The binder the integrator left behind was accurate the day it was printed &mdash; and systems drift. A camera gets added, a switch gets swapped, and the paper quietly stops matching the rack. When the map lives in WorshipMetrics, the drawings stay current instead: change the system, print a fresh copy, and hand your team the truth.
          </p>
          <ul class="mt-8 space-y-3">
            {[
              "System Wiring Diagram as a single-page vector PDF, in integrator-proposal style",
              "Patch sheet in portrait or landscape, color or mono-laser black-and-white",
              "Your church logo and per-room sections on every sheet",
              "Cable IDs match the map, the physical labels, and every support call",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
            ))}
          </ul>
          <div class="mt-8">
            <a href="/tech-manager" class="btn-primary">Download Tech Manager</a>
          </div>
        </div>
        <div class="self-center overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
          <img src={DIAGRAM_LIFESTYLE} alt="Hands holding a clipboard with a freshly printed WorshipMetrics System Wiring Diagram in front of the equipment rack" loading="lazy" decoding="async" class="w-full" />
        </div>
      </div>

      <div class="mt-14">
        <AppScreenshot shot={printableWiringDiagram} label="One click from the Signal Map" />
      </div>
      <div class="mt-14">
        <AppScreenshot shot={printablePatchSheet} label="The patch sheet, cable by cable" />
      </div>
    </div>
  </section>

  <!-- Printed documentation in the real world -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Into the booth</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Paper your volunteers can trust.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          New team members learn a booth fastest with the system in their hands. Flip through the wiring diagrams by room or by system, print the patch sheet on the way in, and everyone works from the same up-to-date picture &mdash; the sheet in the booth, the map in the app, and the copy support sees on a call, all agreeing with each other.
        </p>
      </div>
      <figure class="mx-auto mt-10 max-w-6xl">
        <div class="overflow-hidden rounded-[2rem] border border-slate-200 shadow-lg">
          <img src={PATCH_SHEET_LIFESTYLE} alt="A volunteer holding a freshly printed WorshipMetrics patch sheet at the production desk, with the multiview, consoles, and patched rack behind it" loading="lazy" decoding="async" class="w-full" />
        </div>
        <figcaption class="mt-4 text-center text-sm leading-relaxed text-slate-500">
          Training night at the desk: the patch sheet on the clipboard was generated that morning, so what the paper says is what the rack does.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-indigo-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-indigo-100 bg-white p-8 shadow-sm sm:p-12">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Luminos AI integration</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The better you document, the smarter Luminos gets.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          System Documentation isn&apos;t just a pretty diagram — it&apos;s the knowledge base that powers Luminos AI. When something breaks on Sunday, Luminos already knows your signal chain, your device models, your room layout, and your connection paths. Troubleshooting starts in seconds instead of hours, and every system upgrade recommendation is based on your actual gear, not a generic checklist.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Sort through the wiring diagrams by room or by system, ask Luminos the best way to set up whatever&apos;s next &mdash; and when you&apos;d rather talk it through, 910-WORSHIP answers any time with the same map in view.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
          <a href="/luminos-ai-assistant" class="btn-primary">See Luminos AI</a>
          <a href="tel:+19109677447" class="btn-outline">Call 910-WORSHIP</a>
          <a href={`${APP_URL}/sign-up`} class="btn-outline" data-wm-track="cta_click" data-wm-track-label="system_docs_luminos_sign_up_free" data-wm-track-location="system_docs_luminos">Sign up free</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Document your system once. Keep it current forever.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Stop relying on memory and sticky notes. Build a living map of your AV system that your entire team can reference, print, and trust — included free in Tech Manager.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary" data-wm-track="cta_click" data-wm-track-label="system_docs_footer_sign_up_free" data-wm-track-location="system_docs_footer">Sign up free</a>
        <a href="/tech-manager" class="btn-outline">Download Tech Manager</a>
        <a href="/discovery-call" class="btn-outline">Book a demo</a>
      </div>
    </div>
  </section>
  <!-- Technical details -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical details</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200">
        {[
          ["Documentation surfaces", "Devices (inventory), Signal Map (canvas editor), and Patches (cable schedule) — identical on the cloud web app and the booth's desktop app"],
          ["Device library", "422 make/model entries across 114 manufacturers with nearly 2,000 factory port presets — updated live, with human-verified entries always distinguished from AI-researched ones"],
          ["Connector taxonomy", "76 physical connector types in 8 groups; SDI generations HD through 12G; link speeds 10 Mb to 100 Gb; MADI and Optocore fiber transports"],
          ["Signal model", "Switchable network signals (Dante, AES67, NDI, Art-Net, sACN) modeled separately from point-to-point links (AES50, Ultranet, dSNAKE, HDBaseT) — the map won't let a snake pretend to be Ethernet"],
          ["Cable identification", "Per-signal-type IDs (SDI-001, DANTE-002, NET-014), zero-padded and permanently stable; wireless links tracked as associations and kept off the cable sheets"],
          ["Port data model", "Every port carries connector type, direction, signal format, VLAN and IP configuration, PoE class and wattage, and per-NIC MAC addresses"],
          ["Network verification", "UniFi controller sync (API key or local admin) with port-precise topology, live PoE draw per port, and negotiated-versus-maximum link speed"],
          ["Wiring audits", "Seven continuous checks — duplicate cable, self-loop, direction conflict, unmapped signal, connector mismatch, port-less endpoint, duplicate room name — each jump-focusing its finding"],
          ["AI assistance", "On-demand device research with live web search (confidence-flagged) and schematic import from integrator PDFs and photos — with mandatory human review before anything writes"],
          ["Printable outputs", "Patch sheet in portrait or landscape, color or mono-laser, with church logo and per-room sections; wiring diagram as a single-page vector PDF"],
          ["AI grounding", "Support loads your live inventory — up to 200 devices with make, model, room, and status — plus the signal map with cable and port labels, in every chat and phone conversation"],
        ].map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <KBQuestions heading="Documentation questions churches actually ask." items={[
    { question: "Connecting a UniFi controller: port-precise network truth", href: "/kb/articles/connect-unifi-worshipmetrics/" },
    { question: "A cable labeling system that survives volunteer turnover", href: "/kb/articles/cable-labeling-system-that-survives/" },
    { question: "Can volunteers run the livestream when the tech director is away?", href: "/kb/articles/volunteers-run-livestream-without-tech-director/" },
    { question: "Which AV signals survive a network switch?", href: "/kb/articles/av-signals-that-survive-network-switch/" },
  ]} />
  <TechManagerCTA />
</Layout>
