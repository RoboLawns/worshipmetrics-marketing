---
import Layout from "../../layouts/Layout.astro";
import KBQuestions from "../../components/KBQuestions.astro";

const faqItems = [
  {
    question: "Why should I only use half my upload speed for streaming?",
    answer:
      "Upload capacity fluctuates — an encoder run at the ceiling has no headroom for the moments that need it, and the result is dropped frames and buffering. Half of your reliably measured Sunday-morning upload leaves room for reality.",
  },
  {
    question: "When should I run the speed test?",
    answer:
      "Sunday morning, shortly before the service, from the booth computer on its wired connection. That's when your congregation's devices, the neighborhood, and your ISP's real-world performance all show up at once. A Tuesday-afternoon number flatters your connection.",
  },
  {
    question: "Is 720p really okay for a church stream?",
    answer:
      "A stable 720p consistently beats a struggling 1080p. Viewers forgive softness; they don't forgive freezing. At typical viewing sizes — phones, tablets, a TV across the room — a clean 720p60 looks excellent.",
  },
  {
    question: "Should the encoder be set to CBR or VBR?",
    answer:
      "CBR (constant bitrate) for the live stream. Streaming platforms build their quality ladders assuming steady input, and a wandering bitrate produces buffering even when the average looks fine. Save VBR for local recordings.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<Layout
  title="Church Streaming Bitrate Calculator"
  description="Enter your Sunday-morning measured upload speed and get a safe target bitrate, resolution, and frame rate for your church livestream — based on the half-your-upload rule that survives real Sundays."
  canonical="/tools/church-streaming-bitrate-calculator"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow inline-flex items-center rounded-full border border-indigo-200 bg-white px-4 py-1 shadow-sm">Free tool</p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Church Streaming Bitrate Calculator</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">
        One rule survives real Sundays: <strong>stream at no more than half your reliably measured upload speed — measured on Sunday morning, not Tuesday afternoon.</strong> Enter your number and get settings with honest headroom.
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white px-4 pb-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-[0_24px_60px_rgba(15,23,42,0.08)] sm:p-10">
      <label for="upload" class="block text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">Your measured upload speed (Mbps)</label>
      <div class="mt-4 flex items-center gap-5">
        <input type="range" id="upload-slider" min="1" max="50" step="0.5" value="10" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-indigo-600" aria-label="Upload speed slider" />
        <input type="number" id="upload" min="0.5" max="1000" step="0.5" value="10" class="w-28 rounded-xl border border-slate-300 px-4 py-2.5 text-lg font-bold text-slate-900" />
      </div>
      <p class="mt-2 text-xs text-slate-500">Run the test from the booth computer, on its wired connection, on a Sunday morning under real load.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-5 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-indigo-600">Target bitrate</p>
          <p id="out-bitrate" class="mt-2 text-2xl font-extrabold text-slate-900">4,500 Kbps</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-indigo-600">Resolution &amp; FPS</p>
          <p id="out-resolution" class="mt-2 text-2xl font-extrabold text-slate-900">1080p30</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-indigo-600">Headroom kept</p>
          <p id="out-headroom" class="mt-2 text-2xl font-extrabold text-slate-900">55%</p>
        </div>
      </div>

      <p id="out-note" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm leading-relaxed text-slate-700"></p>

      <ul class="mt-6 space-y-2 text-sm leading-relaxed text-slate-600">
        <li>• Set the encoder to <strong>CBR</strong> for the stream output — steady input is what platforms want.</li>
        <li>• Put the encoder on <strong>wired Ethernet</strong>. WiFi carries the congregation's phones, not the stream.</li>
        <li>• A stable lower resolution beats a struggling higher one, every single Sunday.</li>
      </ul>
    </div>
  </section>

  <script>
    const slider = document.getElementById("upload-slider") as HTMLInputElement;
    const input = document.getElementById("upload") as HTMLInputElement;
    const outBitrate = document.getElementById("out-bitrate")!;
    const outResolution = document.getElementById("out-resolution")!;
    const outHeadroom = document.getElementById("out-headroom")!;
    const outNote = document.getElementById("out-note")!;

    type Tier = { cap: number; res: string; note: string };
    const tiers: Tier[] = [
      { cap: 1000, res: "480p30", note: "This connection is tight. A clean 480p with rock-solid audio serves your online congregation far better than a stuttering HD attempt — and it's worth reading the network guide below before upgrading your internet plan, since the fix is often traffic separation, not speed." },
      { cap: 2000, res: "720p30", note: "Comfortable 720p territory. Keep scenes simple, confirm CBR, and this stream will hold steady through greeting time." },
      { cap: 3500, res: "720p60", note: "Enough for smooth 720p60 — a great look for worship, with motion handled cleanly. You could push 1080p30 instead, but only if your encoder has CPU/GPU headroom to spare." },
      { cap: 6000, res: "1080p30", note: "Solid 1080p30 with honest headroom. This is the sweet spot for most church streams — sharp, stable, and forgiving when the building's network gets busy." },
      { cap: 9000, res: "1080p60", note: "Room for 1080p60 with headroom to spare. If your cameras and switcher run 60fps end to end, this is a broadcast-quality stream; if they run 30, stay at 1080p30 and bank the margin." },
    ];

    function update(fromSlider: boolean) {
      const raw = parseFloat(fromSlider ? slider.value : input.value);
      if (!isFinite(raw) || raw <= 0) return;
      if (fromSlider) input.value = slider.value;
      else slider.value = String(Math.min(50, Math.max(1, raw)));

      const uploadKbps = raw * 1000;
      const half = uploadKbps / 2;
      const tier = tiers.find((t) => half < t.cap * 1.15) ?? tiers[tiers.length - 1];
      const bitrate = Math.min(half, tier.cap);
      const headroom = Math.round((1 - bitrate / uploadKbps) * 100);

      outBitrate.textContent = `${Math.round(bitrate).toLocaleString()} Kbps`;
      outResolution.textContent = tier.res;
      outHeadroom.textContent = `${headroom}%`;
      outNote.textContent = tier.note;
    }

    slider.addEventListener("input", () => update(true));
    input.addEventListener("input", () => update(false));
    update(false);
  </script>

  <!-- Why the rule works -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Why half?</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The rule that survives real Sundays.</h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        Upload capacity isn't a constant — it's a Tuesday number and a Sunday number, and they can differ by half. At 9:55 the congregation's phones arrive, the neighborhood wakes up, and the connection you tested at 40 Mbps delivers 12. An encoder set to use everything has no room for that reality, and the result is dropped frames — the failure viewers feel most, and the heaviest penalty in the <a href="/kb/articles/reading-your-stream-health-score/" class="font-semibold text-indigo-600 hover:underline">stream health score</a>.
      </p>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        Streaming at half your measured Sunday upload keeps the encoder inside what the connection can actually carry — and if it still sags, WorshipMetrics' <a href="/kb/articles/tech-manager-self-healing-explained/" class="font-semibold text-indigo-600 hover:underline">self-healing</a> steps the resolution down to keep you live while the <a href="/live-streaming/" class="font-semibold text-indigo-600 hover:underline">health report</a> records exactly what happened, five seconds at a time.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Bitrate questions, answered.</h2>
      </div>
      <div class="mt-10 space-y-6">
        {faqItems.map(({ question, answer }) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-bold text-slate-900">{question}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <KBQuestions heading="Keep going: the streaming cluster." items={[
    { question: "Is our church WiFi good enough to livestream?", href: "/kb/articles/church-wifi-good-enough-to-livestream/" },
    { question: "Church encoder settings that survive Sunday", href: "/kb/articles/church-encoder-settings-that-survive-sunday/" },
    { question: "Why does our livestream stutter 40 minutes in?", href: "/kb/articles/livestream-stutters-40-minutes-in/" },
    { question: "Network infrastructure for church AV & streaming", href: "/kb/articles/church-network-av-streaming/" },
  ]} />
</Layout>
