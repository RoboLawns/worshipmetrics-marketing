---
import Layout from "../layouts/Layout.astro";
import FoundersStrip from "../components/FoundersStrip.astro";

const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/lifestyle/av-device-system-layout.jpg`;
const MONITORING_IMAGE = `${R2}/app-2026/lifestyle/system-health-monitoring.jpg`;
const BOOTH_IMAGE = "/images/lifestyle/church-production-booth-live.jpg";
const PARTNER_EMAIL = "mailto:paul@worshipmetrics.com?subject=WorshipMetrics%20Partner%20Program";

const partnerWins = [
  {
    title: "Every client system, one account",
    body: "Manage multiple organizations from a single partner login. Switch between client churches, see system health across all of them, and know which install needs attention before anyone picks up the phone.",
  },
  {
    title: "Eyes on the gear you installed",
    body: "The equipment you rack doesn't go dark when the van pulls away. Pulse watches every device 24/7, and alerts reach you and the client together — so a failing encoder is a Tuesday email, not a Sunday emergency.",
  },
  {
    title: "Installs that stick",
    body: "Documented systems get used. The Signal Map captures every device, port, and cable run of your install, volunteers step into defined serving roles they can actually learn — and adoption stops depending on one trained person staying.",
  },
  {
    title: "Support, with a team behind you",
    body: "Partners provide WorshipMetrics support as part of the program — with Luminos, Journey, and our production team backing you up. You stay the trusted face; we make sure you're never guessing at a config.",
  },
];

const forWho = [
  { who: "AV integrators", detail: "who design and install house-of-worship systems and want visibility after the handoff" },
  { who: "HOW consultants", detail: "who guide churches through technology decisions and stay accountable for the outcome" },
  { who: "Production companies", detail: "who run or support church services and need one view across every client" },
];

const lifecycle = [
  { step: "1", title: "Install & document", body: "Rack the gear, then let Tech Manager discover it — the Signal Map becomes the as-built documentation you hand the client, alive instead of in a binder." },
  { step: "2", title: "Monitor & maintain", body: "Every client system reports into your partner view. Firmware drift, failing devices, and stream problems surface early — service visits become planned, not panicked." },
  { step: "3", title: "Support & grow", body: "You field the call with the client's live system in front of you, our AI and team behind you — and the church that succeeds with its system calls you for the next project." },
];

const faqItems = [
  {
    question: "How do I join the partner program?",
    answer: "Email Paul directly at paul@worshipmetrics.com. Tell him about your business, the churches you serve, and the systems you typically install — he'll walk you through the program and get your partner account set up. No forms, no gatekeeping; you'll be talking to a co-founder.",
  },
  {
    question: "Do my clients keep ownership of their accounts?",
    answer: "Yes. Each church owns its own WorshipMetrics organization and its data. Your partner account gets delegated access to manage and support it — the church stays in control, and can see exactly what access their partner has.",
  },
  {
    question: "Can I provide the support for my clients?",
    answer: "That's the point of the program. Partners provide WorshipMetrics support to their clients as the trusted first line — with the platform's monitoring, AI, and our team behind you. Your clients call the people who installed their system; you answer with their live system on screen.",
  },
  {
    question: "What does it cost to be a partner?",
    answer: "Program details, pricing, and margins are conversations we'd rather have with you directly than publish as a table — every integrator's business is shaped differently. Email Paul and he'll lay it out plainly.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<Layout
  title="Partner Program — AV Integrators & Consultants"
  socialTitle="WorshipMetrics | The install shouldn't end at the door."
  description="The WorshipMetrics partner program for AV integrators and house-of-worship consultants: manage multiple client organizations, monitor the equipment you install, provide backed support, and see higher success and adoption on every install."
  canonical="/partners"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
      <div>
        <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-4 py-1 shadow-sm">Partner Program</p>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          The install shouldn&apos;t end at the door.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          For AV integrators and house-of-worship consultants who represent WorshipMetrics: manage every client organization from one account, keep eyes on the equipment you installed, and back your churches with support that can see their systems &mdash; so your installs succeed long after the truck leaves.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={PARTNER_EMAIL} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="partners_hero_email" data-wm-track-location="partners_hero">Email Paul about partnering</a>
          <a href="/discovery-call" class="btn-outline">Book a conversation</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">paul@worshipmetrics.com goes to Paul Richards, co-founder &mdash; not a partner portal queue.</p>
      </div>
      <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
        <img src={HERO_IMAGE} alt="An AV integrator reviewing a documented church system layout with racks and devices" loading="eager" decoding="async" class="aspect-[16/10] w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Why partner -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Why integrators partner with us</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Insight into every system you&apos;ve ever installed.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          The hardest part of house-of-worship work isn&apos;t the install &mdash; it&apos;s everything after: the un-documented changes, the volunteer turnover, the &ldquo;it stopped working&rdquo; calls with no detail. The partner program closes that gap.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {partnerWins.map(({ title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Monitoring visual -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
        <img src={MONITORING_IMAGE} alt="A technician monitoring church AV system health remotely with WorshipMetrics" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
      </div>
      <div>
        <p class="eyebrow">Higher success. Higher adoption.</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Clients who succeed call you for the next project.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          An install that gets used is your best marketing. When the system is documented in the Signal Map, watched by Pulse, and run by volunteers through panels they can actually operate, the church wins Sunday after Sunday &mdash; and remembers who set them up to win.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          And when something does drift &mdash; a failing device, a changed setting, a stream that degraded &mdash; you know first, with the detail to fix it remotely. Fewer truck rolls. Better margins. Stronger relationships.
        </p>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Who it&apos;s for</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Built for the people churches already trust.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {forWho.map(({ who, detail }) => (
          <div class="rounded-3xl border border-indigo-200 bg-indigo-50 p-8">
            <h3 class="text-lg font-bold text-slate-900">{who}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lifecycle -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">The partner lifecycle</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Install it. See it. Support it.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {lifecycle.map(({ step, title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">{step}</span>
            <h3 class="mt-5 text-xl font-bold text-slate-900">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-slate-500">
        The platform your clients run on: <a href="/tech-manager" class="font-semibold text-indigo-600 hover:text-indigo-800">Tech Manager</a> &middot; <a href="/av-monitoring" class="font-semibold text-indigo-600 hover:text-indigo-800">AV monitoring</a> &middot; <a href="/system-documentation" class="font-semibold text-indigo-600 hover:text-indigo-800">the Signal Map</a> &middot; <a href="/cloud-control" class="font-semibold text-indigo-600 hover:text-indigo-800">cloud control</a>
      </p>
    </div>
  </section>

  <!-- Booth visual + FAQ -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div>
        <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
          <img src={BOOTH_IMAGE} alt="A church operator running a WorshipMetrics-powered booth installed by an integration partner" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">Your install, running well &mdash; and you can see it from your office.</p>
      </div>
      <div>
        <p class="eyebrow">Partner questions</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The short version, answered.</h2>
        <div class="mt-8 space-y-4">
          {faqItems.map(({ question, answer }) => (
            <details class="group rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <summary class="cursor-pointer text-base font-semibold text-slate-900 marker:content-none">{question}</summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-indigo-600 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Let&apos;s talk about your churches.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-indigo-100 sm:text-lg">
        Email Paul about the partner program &mdash; who you serve, what you install, and where WorshipMetrics fits. You&apos;ll get a founder&apos;s answer, not an autoresponder.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={PARTNER_EMAIL} class="btn-primary" style="background:#fff;color:#4361ee;box-shadow:0 10px 30px rgba(15,23,42,0.18);" data-wm-track="cta_click" data-wm-track-label="partners_footer_email" data-wm-track-location="partners_footer">Email paul@worshipmetrics.com</a>
        <a href="tel:+19109677447" class="btn-outline" style="border-color:rgba(255,255,255,0.35);color:#fff;">Call 910-WORSHIP</a>
      </div>
    </div>
  </section>

  <!-- Who you'd be partnering with -->
  <FoundersStrip
    variant="light"
    eyebrow="Who you'd be partnering with"
    heading="Three founders who've spent their careers where you work."
    body="A pastor, an engineer, and an AV educator with twelve years of church booths behind him. We know the integrator's side of the counter — and we built the platform to make your installs succeed."
    linkLabel="Read our story"
  />
</Layout>
