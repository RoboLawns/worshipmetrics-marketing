---
import Layout from "../layouts/Layout.astro";
import IntegrationsHero from "../components/integrations/IntegrationsHero.astro";
import IntegrationsSearch from "../components/integrations/IntegrationsSearch.astro";
import IntegrationsGrid from "../components/integrations/IntegrationsGrid.astro";
import IntegrationsCTA from "../components/integrations/IntegrationsCTA.astro";
import { integrationCategories, integrationTotals } from "../data/integrations";

const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const OG_IMAGE = `${R2}/Tech%20Manager/WorshipMetrics%20Tech%20Manager%20Web-UI%20Panels.jpg`;
const HERO_IMAGE = `${R2}/homepage/1%20Worship%20Technology%20Assistance.jpg`;

const differentiators = [
  {
    num: "01",
    title: "Software comes first",
    body: "Tech Manager is free and gives your team documentation, remote management, and automation before you spend a dollar on hardware. We believe churches should be organized before they are upgraded.",
  },
  {
    num: "02",
    title: "Built for church budgets",
    body: "We know churches operate on constrained budgets. That's why we built a free tier that is genuinely useful and offer AV technical support starting at $100/hour — not the rates that lock smaller churches out.",
  },
  {
    num: "03",
    title: "We stay after the install",
    body: "Our platform is the operating system your team uses every Sunday, so we're still here long after the install. When something breaks, we pick up the phone — not a call center.",
  },
];

const territories = [
  { label: "Southeastern Pennsylvania", desc: "Philadelphia suburbs, Chester County, Montgomery County, and surrounding areas" },
  { label: "Northern Delaware", desc: "Wilmington, New Castle County, and nearby communities" },
  { label: "Eastern Shore Maryland", desc: "Cecil County, Kent County, and the Delmarva corridor" },
  { label: "McKinney, Texas", desc: "North Dallas corridor — our Texas-based team ready to serve customers in the region" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Integrations & AV Services",
  url: `${SITE_URL}/integrations`,
  description: "WorshipMetrics offers AV integration support, on-site installation, technical support, and a platform that works with the ProAV gear your church already owns.",
  image: OG_IMAGE,
};
---

<Layout
  robots="noindex,nofollow"
  title="Integrations &amp; AV Services"
  description="WorshipMetrics offers AV integration support, on-site installation, technical services, and a platform that works with the ProAV gear your church already owns."
  canonical="/integrations"
  ogImage={OG_IMAGE}
  structuredData={structuredData}
>
  <IntegrationsHero totalDevices={integrationTotals.totalDevices} totalCategories={integrationTotals.totalCategories} heroImage={HERO_IMAGE} />

  <!-- How we're different -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What makes us different</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A standard AV integrator sells you gear. We build the system around your team.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Most ProAV integration companies write a quote, install the equipment, and move on. WorshipMetrics puts your team&apos;s ability to run Sunday first, builds tools that make the booth manageable, and only recommends hardware when it actually serves the mission.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {differentiators.map(({ num, title, body }) => (
          <div class="card p-8">
            <p class="eyebrow">{num}</p>
            <h3 class="mt-3 text-lg font-bold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services & coverage -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Services &amp; coverage</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">AV support that shows up.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Whether you need remote troubleshooting, an on-site install, or someone to train your volunteers, we offer services that scale to your church&apos;s size and budget.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-800 bg-slate-950 p-8">
          <p class="eyebrow !text-indigo-300">AV technical support</p>
          <p class="mt-4 text-4xl font-extrabold tracking-tight text-white">$100<span class="text-base font-semibold text-slate-400">/hour</span></p>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">
            Remote and on-site technical support for your ProAV systems. Our team knows the gear because we built the platform that controls it.
          </p>
          <ul class="mt-6 space-y-2.5">
            {[
              "System troubleshooting and diagnostics",
              "Remote configuration and setup assistance",
              "Stream health and network diagnostics",
              "Volunteer training on your equipment",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-slate-200"><span class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-400"></span><span>{item}</span></li>
            ))}
          </ul>
        </div>
        <div class="card p-8">
          <p class="eyebrow">On-site installation</p>
          <h3 class="mt-4 text-2xl font-bold tracking-tight text-slate-900">Design, install, configure, train.</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Full-service AV installation for churches in our service territories. We design, install, configure, and train &mdash; then stay with you through the Sundays that follow.
          </p>
          <ul class="mt-6 space-y-2.5">
            {[
              "System design and equipment specification",
              "Professional installation and cable management",
              "Full system configuration and integration with Tech Manager",
              "Hands-on volunteer and staff training",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-slate-700"><span class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-14 text-center">
        <p class="eyebrow">Where we work</p>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
          Our primary team operates out of Southeastern Pennsylvania and serves the Mid-Atlantic region. We also have team members in McKinney, Texas who can assist customers in the Dallas&ndash;Fort Worth area and beyond. We&apos;re willing to travel for the right projects.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {territories.map(({ label, desc }) => (
            <div class="card p-5 text-center">
              <p class="text-sm font-bold text-slate-900">{label}</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-500">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Manager: the foundation -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
      <div>
        <p class="eyebrow">The foundation</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tech Manager makes your system manageable before you spend on anything else.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Tech Manager is the free desktop application at the center of everything we do. It documents your ProAV gear, maps your signal flow, monitors stream health, and gives your team a single surface for controlling the equipment that runs Sunday. Every integration service we offer builds on top of it.
        </p>
        <ul class="mt-8 space-y-3">
          {[
            "System documentation and device inventory so your team knows what you have and how it connects",
            "Remote management and control through Central Control's show automation platform",
            "Stream health monitoring, camera control, and automated macros that reduce live pressure on operators",
            "Always listening and building — real church feedback shapes what comes next",
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <div class="mt-8">
          <a href="/tech-manager" class="btn-outline">See Tech Manager &rarr;</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={OG_IMAGE} alt="Tech Manager control panels in WorshipMetrics" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Vendor catalog -->
  <section class="bg-slate-50 pt-16">
    <div class="mx-auto max-w-3xl px-4 pb-10 text-center sm:px-6">
      <p class="eyebrow">Supported gear</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Works with the gear <span class="title-accent">you already own.</span></h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600">
        WorshipMetrics integrates with over {integrationTotals.totalDevices} devices across {integrationTotals.totalCategories} categories of ProAV equipment through Central Control&apos;s show automation platform. If your church already invested in quality gear, we help you get more out of it.
      </p>
    </div>

    <IntegrationsSearch categories={integrationCategories} totalDevices={integrationTotals.totalDevices} />
    <IntegrationsGrid categories={integrationCategories} />
  </section>

  <IntegrationsCTA />

  <script is:inline>
    const search = document.getElementById('integrations-search');
    const pills = Array.from(document.querySelectorAll('#integrations-pills [data-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-integration-card]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const visibleCount = document.getElementById('integrations-visible-count');
    const emptyState = document.getElementById('integrations-empty-state');

    let activeFilter = 'all';

    const update = () => {
      const query = (search instanceof HTMLInputElement ? search.value : '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const category = card.getAttribute('data-category') || '';
        const haystack = card.getAttribute('data-search') || '';
        const matchesFilter = activeFilter === 'all' || category === activeFilter;
        const matchesQuery = !query || haystack.includes(query);
        const show = matchesFilter && matchesQuery;
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      sections.forEach((section) => {
        const category = section.getAttribute('data-category-section');
        const hasVisibleCards = cards.some((card) => card.getAttribute('data-category') === category && card.style.display !== 'none');
        section.style.display = hasVisibleCards ? '' : 'none';
      });

      if (visibleCount) visibleCount.textContent = String(visible);
      if (emptyState) emptyState.classList.toggle('visible', visible === 0);
    };

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeFilter = pill.getAttribute('data-filter') || 'all';
        pills.forEach((node) => node.classList.toggle('active', node === pill));
        update();
      });
    });

    if (search instanceof HTMLInputElement) {
      search.addEventListener('input', update);
    }

    update();
  </script>
</Layout>
