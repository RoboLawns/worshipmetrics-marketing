---
import Layout from "../layouts/Layout.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";
import AppScreenshot from "../components/AppScreenshot.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import { stageDisplay, scriptureBrowser } from "../data/appScreenshots";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-present-slides.jpg`;
const REHEARSAL_IMAGE = "/images/lifestyle/worship-rehearsal-chord-slides.jpg";
const BOOTH_IMAGE = "/images/lifestyle/church-scripture-operator-booth.jpg";

const freeFeatures = [
  {
    title: "A real slide editor",
    body: "Full 1920×1080 editing with layered items, per-church themes, shrink-to-fit text, and six lyric layouts from Centered Classic to Lower-Third. Not a template picker — an actual editor.",
  },
  {
    title: "Live video on your slides",
    body: "Capture cards and NDI cameras drop onto slides like any other media — so IMAG, picture-in-picture teaching, and camera-behind-lyrics looks are just another slide, not another system.",
  },
  {
    title: "Lyrics from your song library",
    body: "Songs carry their arrangements and keys, and the slides follow. Section labels — Verse, Chorus, Bridge — are colored so the operator can read the shape of the song.",
  },
  {
    title: "Scripture in six translations",
    body: "Type a reference, pick verses per slide, and the passage becomes clean slides — even appended to the live show mid-service. KJV, ASV, WEB, YLT, Darby, and BBE are included.",
  },
  {
    title: "Playlists built from the plan",
    body: "The service plan projects into a ready playlist — songs, announcements, countdowns, and media in the order Sunday actually runs. The plan changes Thursday? It re-syncs live, in seconds.",
  },
  {
    title: "A media bin that behaves",
    body: "Images and video with fit modes, crop, trim, fades, loop, and per-use audio gain — organized in folders, with a relink flow when files move.",
  },
  {
    title: "Data-driven overlays",
    body: "Lower thirds, messages, logo bugs, and timer overlays — and overlay fields can bind to a CSV, JSON, or XML source, so names and rosters update themselves row by row.",
  },
  {
    title: "Macros for big moments",
    body: "One click fires a named sequence: change the background, jump to a playlist, show an overlay, start audio, wait, clear — even fire the booth's control protocols.",
  },
  {
    title: "Timers, clocks & countdowns",
    body: "Countdown, count-up, and countdown-to-time with warning and overrun colors, plus timezone-aware clocks. The classic five-minutes-to-start screen, built in.",
  },
  {
    title: "Your church's brand",
    body: "Colors, fonts, and logo flow through themes — and 'Clear to Logo' is always one button away. Slides look like your church without a volunteer designing under pressure.",
  },
  {
    title: "Bring your existing library",
    body: "Import from ProPresenter 4 through 7, ChordPro, OpenLyrics, CCLI SongSelect, or plain pasted text. Your catalog comes with you.",
  },
  {
    title: "Unlimited users",
    body: "Every volunteer gets an account. No per-seat math, no deciding who is important enough to have a login.",
  },
];

const protocolItems = [
  "OSC over the network for lighting and media servers",
  "RossTalk for Ross production switchers",
  "MIDI — local devices or network MIDI",
  "HTTP requests for anything with an API",
  "OBS Studio via WebSocket, and Q-SYS via QRC",
  "Presets for vMix, Companion, Resolume, ProPresenter, X32/M32, QLab, and disguise",
];

const techSpecs = [
  ["Authoring canvas", "1920×1080 with layered media, slide, prop, and announcement layers rendered by one engine across editor, program, and stage"],
  ["Output resolutions", "1280×720, 1920×1080, 1920×1200, 4K UHD (3840×2160), portrait 1080×1920, or custom — with fit, fill, and stretch screen modes"],
  ["Live video inputs", "Capture cards and NDI sources placed on slides as live media for IMAG and picture-in-picture"],
  ["NDI & Network Display", "NDI program output with alpha via the Tech Manager desktop app; Network Display publishes to auto-discovered network screens over WebRTC (H.264, up to 60 fps)"],
  ["Media formats", "Images: JPG, PNG, WebP, GIF, AVIF, SVG, BMP · Video: MP4, WebM, MOV, M4V, MKV · up to 250 MB per video upload, with crop, trim, fade, loop, and gain per use"],
  ["Scripture", "KJV, ASV, WEB, YLT, Darby, and BBE included, with verses-per-slide, verse numbers, and five reference display modes"],
  ["Imports", "ProPresenter 4–7, ChordPro, OpenLyrics, CCLI SongSelect (.usr), and plain text"],
  ["Control protocols", "OSC, RossTalk, MIDI (device and network), HTTP, OBS WebSocket, and Q-SYS QRC — fired from slides or macros, relayed through Tech Manager in the booth"],
  ["Offline resilience", "Edits journal locally and reconcile automatically when the connection returns — a dropped network doesn't drop the service"],
  ["Runs in", "Any Chromium-based browser (Chrome, Edge); multi-monitor output uses the Window Management API"],
  ["With Assist ($49/mo)", "Multiple program and stage outputs across connected monitors — each with its own look, stage layout, resolution, and audio device — plus unlimited media storage"],
];

const growInto = [
  { title: "Multi-screen output", body: "Program and stage on separate displays, each with its own layout." },
  { title: "Stage display", body: "Current and next slide, section labels, notes, and the chord chart in the right key." },
  { title: "Unlimited media", body: "No storage caps on your video and image library." },
  { title: "24/7 AI support", body: "Luminos in the app and Journey on 910-WORSHIP, both seeing your live system." },
];

const faqItems = [
  {
    question: "Is the free church presentation software actually free?",
    answer: "Yes — free forever, not a trial. No credit card, no time limit, and unlimited users so your whole volunteer team can have accounts. The slide editor, lyrics, scripture, playlists, timers, and your church's brand are all included at no cost.",
  },
  {
    question: "What do I need to install?",
    answer: "Nothing. Present runs in the browser, so any reasonably modern computer in the booth can drive your screens. A Chromium-based browser is recommended for multi-monitor output. Tech Manager, our free desktop app, adds booth monitoring and AV documentation when you want it.",
  },
  {
    question: "Can I import my existing songs and slides?",
    answer: "Yes. Present imports ProPresenter 4 through 7 documents, ChordPro charts, OpenLyrics XML, CCLI SongSelect files, and plain pasted text. If your library lives somewhere else today, it can come with you.",
  },
  {
    question: "Is the free plan a stripped-down version of Present?",
    answer: "No — it's the same engine the paid plans run. Live video inputs on slides, data-driven overlays, macros, protocol triggers (OSC, RossTalk, MIDI, HTTP, OBS, Q-SYS), the full slide editor, and scripture-to-slides are all part of the free plan. The paid difference is room, not power: multi-screen output, stage display, and unlimited media storage come with Assist.",
  },
  {
    question: "What is not included in the free plan?",
    answer: "Multi-screen output, stage display, and unlimited media storage come with the Assist plan at $49 per month, alongside 24/7 AI support and the rest of the platform. The free plan is genuinely usable on its own — Assist is for churches that want more room and someone to call.",
  },
  {
    question: "Why give presentation software away?",
    answer: "Because a church that can put words on a screen shouldn't need a budget line to do it. Presentation is where most churches meet us, and we would rather earn the paid relationship later — when streaming, support, or a bigger media library actually becomes worth paying for.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "WorshipMetrics Present",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: `${SITE_URL}/free-church-presentation-software`,
    image: HERO_IMAGE,
    description: "Free church presentation software: a full 1080p slide editor, live video on slides, worship lyrics, scripture slides, data-driven overlays, macros, protocol triggers, playlists, and timers — free forever with unlimited users.",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: `${SITE_URL}/pricing`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Free Church Presentation Software"
  socialTitle="WorshipMetrics | Free worship presentation software."
  description="Free church presentation software for worship: a real slide editor, live video on slides, lyrics, scripture, overlays, macros, and OSC/MIDI/HTTP triggers — free forever, unlimited users, nothing to install."
  canonical="/free-church-presentation-software"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={BOOTH_IMAGE} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-b from-emerald-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
      <div>
        <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-4 py-1 shadow-sm !text-emerald-800">
          <img src="/images/nav/pillars/present.png" alt="" class="h-7 w-7 rounded-md" /> Free forever &middot; No credit card
        </p>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Free church presentation software.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          A full presentation engine, not a starter app: a real 1080p slide editor, live cameras on slides, lyrics that follow your arrangements, scripture in six translations, data-driven overlays, and macros that run the whole room &mdash; free forever, with unlimited users and nothing to install.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="free_present_hero_signup" data-wm-track-location="free_present_hero">Start free</a>
          <a href="/present" class="btn-outline">See everything Present does</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">No trial clock. No credit card. Your whole volunteer team gets accounts.</p>
      </div>
      <ImageCarousel
        eager
        slides={[
          { src: BOOTH_IMAGE, alt: "A booth operator running scripture slides live with free WorshipMetrics presentation software beside the mixer and multiview", kind: "lifestyle", label: "In the booth" },
          { src: HERO_IMAGE, alt: "Free church presentation software: slide grid, playlists, and backgrounds in WorshipMetrics Present" },
        ]}
      />
    </div>
  </section>

  <!-- What's free -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What you get for $0</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A full presentation engine. Not a demo, not a trial.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Plenty of church software is free until the moment it matters. This is the same engine paid plans run &mdash; live video on slides, data-bound overlays, macros, and all &mdash; and it stays free.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {freeFeatures.map(({ title, body }) => (
          <div class="card p-6">
            <p class="eyebrow">{title}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <div class="mt-14">
        <AppScreenshot shot={scriptureBrowser} label="The scripture browser — included free" />
      </div>
    </div>
  </section>

  <!-- Protocol triggers -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-white/10 bg-white/5 p-5 shadow-2xl sm:p-12">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">Slides that run the room</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">When the slide goes live, the room follows.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
            This is the part nobody expects from free software. Attach protocol actions to slides and playlists, and going live fires them across the network &mdash; lights shift for worship, the switcher takes the sermon camera, the stream overlay updates. One volunteer advancing slides quietly runs the whole moment.
          </p>
          <div class="mt-8">
            <a href="/present" class="btn-ghost-dark">See the full Present tour</a>
          </div>
        </div>
        <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-300">Speaks the booth&apos;s languages</p>
          <ul class="mt-6 space-y-3">
            {protocolItems.map((item) => (
              <li class="flex items-start gap-3 text-sm text-slate-200 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-400"></span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why free -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Why we give it away</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A church shouldn&apos;t need a budget line to put words on a screen.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Small congregations run the same Sunday as large ones &mdash; same songs, same scripture, same need for the words to be readable from the back row. The difference is usually budget, and presentation software is a strange place for that to be the deciding factor.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          So Present is free, permanently, with unlimited users. If your church later wants cloud streaming, 24/7 support, or a bigger media library, those are worth paying for. The words on the screen aren&apos;t.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row">
          <a href="/pricing" class="btn-outline">See what the paid plans add</a>
        </div>
      </div>
      <div>
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
          <img src={REHEARSAL_IMAGE} alt="A worship leader editing chord chart slides in the free WorshipMetrics slide editor from the stage at rehearsal" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">The slide editor at Thursday rehearsal &mdash; lyrics, chords, and backgrounds, edited right from the stage.</p>
      </div>
    </div>
  </section>

  <!-- Technical specs -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical specs</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          The free plan runs the same engine as the paid plans &mdash; here is what it&apos;s made of.
        </p>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200">
        {techSpecs.map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-6 max-w-4xl text-center text-sm text-slate-500">
        Everything above is in the free plan except the last row &mdash; multi-display output and unlimited media come with <a href="/pricing" class="font-semibold text-indigo-600 hover:text-indigo-800">Assist</a>, and free media storage has practical limits.
      </p>
    </div>
  </section>

  <!-- Grow into -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">When you&apos;re ready for more</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Room to grow, on the same platform.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Nothing here is a different app. When a church outgrows the free plan, the same slides, songs, and service plans carry straight over.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {growInto.map(({ title, body }) => (
          <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-6">
            <p class="eyebrow">{title}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <div class="mt-14">
        <AppScreenshot shot={stageDisplay} label="What Assist adds — the stage display editor" />
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-slate-500">
        And the rest of the platform is there when you need it &mdash; <a href="/services/" class="font-semibold text-indigo-600 hover:text-indigo-800">service planning</a>, <a href="/songs/" class="font-semibold text-indigo-600 hover:text-indigo-800">song library</a>, <a href="/live-streaming/" class="font-semibold text-indigo-600 hover:text-indigo-800">streaming</a>, and <a href="/av-monitoring/" class="font-semibold text-indigo-600 hover:text-indigo-800">AV monitoring that&apos;s also free forever</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Free church presentation software, answered.</h2>
      </div>
      <div class="mt-10 space-y-4">
        {faqItems.map(({ question, answer }) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6">
            <summary class="cursor-pointer text-base font-semibold text-slate-900 marker:content-none">{question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Put the words up this Sunday.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
        Sign up, import your songs, and build the first service plan. It takes an evening, and it costs nothing.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="free_present_footer_signup" data-wm-track-location="free_present_footer">Start free</a>
        <a href="/present" class="btn-ghost-dark text-base px-8 py-3.5">Explore Present</a>
      </div>
    </div>
  </section>

  <TechManagerCTA />
</Layout>
