---
import Layout from "../layouts/Layout.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-present-slides.jpg`;
const LIFESTYLE_IMAGE = `${R2}/app-2026/lifestyle/presentation.jpg`;

const freeFeatures = [
  {
    title: "A real slide editor",
    body: "Full 1920×1080 editing with layered items, text tools, and six lyric layouts. Not a template picker — an actual editor.",
  },
  {
    title: "Lyrics from your song library",
    body: "Songs carry their arrangements and keys, and the slides follow. Section labels — Verse, Chorus, Bridge — are colored so the operator can read the shape of the song.",
  },
  {
    title: "Scripture in six translations",
    body: "Type a reference, pick verses per slide, and the passage becomes clean slides. KJV, ASV, WEB, YLT, Darby, and BBE are included.",
  },
  {
    title: "Playlists built from the plan",
    body: "The service plan projects into a ready playlist — songs, announcements, countdowns, and media in the order Sunday actually runs.",
  },
  {
    title: "Timers and countdowns",
    body: "Pre-service countdowns, count-up, and countdown-to-time with warning and overrun colors. The classic five-minutes-to-start screen, built in.",
  },
  {
    title: "Your church's brand",
    body: "Colors, fonts, and logo flow through themes, so slides look like your church without a volunteer designing under pressure.",
  },
  {
    title: "Bring your existing library",
    body: "Import from ProPresenter 4 through 7, ChordPro, OpenLyrics, CCLI SongSelect, or plain pasted text. Your catalog comes with you.",
  },
  {
    title: "Unlimited users",
    body: "Every volunteer gets an account. No per-seat math, no deciding who is important enough to have a login.",
  },
];

const growInto = [
  { title: "Multi-screen output", body: "Program and stage on separate displays, each with its own layout." },
  { title: "Stage display", body: "Current and next slide, section labels, notes, and the chord chart in the right key." },
  { title: "Unlimited media", body: "No storage caps on your video and image library." },
  { title: "24/7 AI support", body: "Luminos in the app and Journey on 910-WORSHIP, both seeing your live system." },
];

const faqItems = [
  {
    question: "Is the free church presentation software actually free?",
    answer: "Yes — free forever, not a trial. No credit card, no time limit, and unlimited users so your whole volunteer team can have accounts. The slide editor, lyrics, scripture, playlists, timers, and your church's brand are all included at no cost.",
  },
  {
    question: "What do I need to install?",
    answer: "Nothing. Present runs in the browser, so any reasonably modern computer in the booth can drive your screens. A Chromium-based browser is recommended for multi-monitor output. Tech Manager, our free desktop app, adds booth monitoring and AV documentation when you want it.",
  },
  {
    question: "Can I import my existing songs and slides?",
    answer: "Yes. Present imports ProPresenter 4 through 7 documents, ChordPro charts, OpenLyrics XML, CCLI SongSelect files, and plain pasted text. If your library lives somewhere else today, it can come with you.",
  },
  {
    question: "What is not included in the free plan?",
    answer: "Multi-screen output, stage display, and unlimited media storage come with the Assist plan at $49 per month, alongside 24/7 AI support and the rest of the platform. The free plan is genuinely usable on its own — Assist is for churches that want more room and someone to call.",
  },
  {
    question: "Why give presentation software away?",
    answer: "Because a church that can put words on a screen shouldn't need a budget line to do it. Presentation is where most churches meet us, and we would rather earn the paid relationship later — when streaming, support, or a bigger media library actually becomes worth paying for.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "WorshipMetrics Present",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: `${SITE_URL}/free-church-presentation-software`,
    image: HERO_IMAGE,
    description: "Free church presentation software: slide editor, worship lyrics, scripture slides, playlists, timers, and your church's brand — free forever with unlimited users.",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: `${SITE_URL}/pricing`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Free Church Presentation Software"
  socialTitle="WorshipMetrics | Free worship presentation software."
  description="Free church presentation software for worship: slide editor, lyrics, scripture slides, playlists, timers, and your brand — free forever, unlimited users, nothing to install."
  canonical="/free-church-presentation-software"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO_IMAGE} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-b from-emerald-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
      <div>
        <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-4 py-1 shadow-sm !text-emerald-800">
          <img src="/images/nav/pillars/present.png" alt="" class="h-7 w-7 rounded-md" /> Free forever &middot; No credit card
        </p>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Free church presentation software.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Put the words on the screen without a budget line. A real slide editor, lyrics that follow your arrangements, scripture in six translations, playlists, and countdowns &mdash; free forever, with unlimited users and nothing to install.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="free_present_hero_signup" data-wm-track-location="free_present_hero">Start free</a>
          <a href="/present" class="btn-outline">See everything Present does</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">No trial clock. No credit card. Your whole volunteer team gets accounts.</p>
      </div>
      <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-950 shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
        <img src={HERO_IMAGE} alt="Free church presentation software: slide grid, playlists, and backgrounds in WorshipMetrics Present" loading="eager" decoding="async" class="aspect-video w-full object-contain" />
      </div>
    </div>
  </section>

  <!-- What's free -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What you get for $0</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Not a demo. Not a trial. The actual software.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Plenty of church software is free until the moment it matters. This is the presentation engine your team runs on Sunday, and it stays free.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {freeFeatures.map(({ title, body }) => (
          <div class="card p-6">
            <p class="eyebrow">{title}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why free -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Why we give it away</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A church shouldn&apos;t need a budget line to put words on a screen.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Small congregations run the same Sunday as large ones &mdash; same songs, same scripture, same need for the words to be readable from the back row. The difference is usually budget, and presentation software is a strange place for that to be the deciding factor.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          So Present is free, permanently, with unlimited users. If your church later wants cloud streaming, 24/7 support, or a bigger media library, those are worth paying for. The words on the screen aren&apos;t.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row">
          <a href="/pricing" class="btn-outline">See what the paid plans add</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={LIFESTYLE_IMAGE} alt="Volunteer running free church presentation software during a worship service" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Grow into -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">When you&apos;re ready for more</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Room to grow, on the same platform.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Nothing here is a different app. When a church outgrows the free plan, the same slides, songs, and service plans carry straight over.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {growInto.map(({ title, body }) => (
          <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-6">
            <p class="eyebrow">{title}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-slate-500">
        And the rest of the platform is there when you need it &mdash; <a href="/services/" class="font-semibold text-indigo-600 hover:text-indigo-800">service planning</a>, <a href="/songs/" class="font-semibold text-indigo-600 hover:text-indigo-800">song library</a>, <a href="/live-streaming/" class="font-semibold text-indigo-600 hover:text-indigo-800">streaming</a>, and <a href="/av-monitoring/" class="font-semibold text-indigo-600 hover:text-indigo-800">AV monitoring that&apos;s also free forever</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Free church presentation software, answered.</h2>
      </div>
      <div class="mt-10 space-y-4">
        {faqItems.map(({ question, answer }) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6">
            <summary class="cursor-pointer text-base font-semibold text-slate-900 marker:content-none">{question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Put the words up this Sunday.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
        Sign up, import your songs, and build the first service plan. It takes an evening, and it costs nothing.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="free_present_footer_signup" data-wm-track-location="free_present_footer">Start free</a>
        <a href="/present" class="btn-ghost-dark text-base px-8 py-3.5">Explore Present</a>
      </div>
    </div>
  </section>

  <TechManagerCTA />
</Layout>
