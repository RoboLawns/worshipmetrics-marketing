---
import Layout from "../layouts/Layout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";

const SITE_URL = "https://worshipmetrics.com";
const APP_URL = "https://app.worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const STREAM_HEALTH_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-live-stream.jpg`;
const STREAM_LIFESTYLE_IMAGE = `${R2}/app-2026/lifestyle/av-stream-connections.jpg`;

const destinations = [
  { name: "YouTube", desc: "Scheduled broadcasts, go live, end, and history — handled end to end." },
  { name: "Facebook", desc: "Simulcast to your page without touching a second encoder." },
  { name: "Your website", desc: "A clean player embed for your church site — no platform branding." },
  { name: "Custom RTMP", desc: "Any destination that takes a stream key. Point us at it once." },
  { name: "The Stream console", desc: "Encoders, connections, and scheduled events in one console — sync to vMix and go live in two clicks." },
];

const clipFeatures = [
  {
    title: "Chop clips live",
    body: "Mark moments during the service — the worship set, the sermon point, the baptism — and they're clips before the service ends.",
  },
  {
    title: "Trim from the recording",
    body: "Every service lands in your recordings library automatically. Trim the full service, cut the sermon, and hand highlights straight to Reels.",
  },
  {
    title: "Publish-ready by Monday",
    body: "Captioned, rendered, and formatted for the platforms your congregation actually scrolls. The sermon finds people who weren't in the room.",
  },
];

const faqs = [
  {
    question: "Do we have to change our encoder or software?",
    answer: "No. Point vMix, OBS, or any RTMP encoder at your WorshipMetrics ingest once. Everything downstream — destinations, recordings, clips, monitoring — happens on our side.",
  },
  {
    question: "What happens if the stream drops mid-service?",
    answer: "We're watching it live. The moment bitrate drops or the feed dies, you get an alert — and support is on it seven days a week, including Sunday morning. You find out from us, not from a text from someone watching at home.",
  },
  {
    question: "Can we still stream directly to YouTube?",
    answer: "Yes. WorshipMetrics manages your YouTube broadcasts end to end — scheduling, visibility, go-live, and history — while also fanning the same feed out everywhere else you want it.",
  },
  {
    question: "Where do the recordings live?",
    answer: "In your recordings library, automatically, after every stream. Trim them, clip them, or publish them — they're yours.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "WorshipMetrics Live Streaming",
    serviceType: "Church live streaming and re-streaming platform",
    provider: { "@type": "Organization", name: "WorshipMetrics", url: SITE_URL },
    description:
      "Send one feed to WorshipMetrics and stream to YouTube, Facebook, your website, and any custom destination — with automatic recordings, live clipping, stream health monitoring, and 7-day human support.",
    url: `${SITE_URL}/live-streaming`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Church Live Streaming — Connect Once, Stream Seamlessly"
  socialTitle="WorshipMetrics Live Streaming | Connect Once, Stream Seamlessly"
  description="WorshipMetrics is your church's streaming destination. Send one feed — we stream it to YouTube, Facebook, your website, and any custom destination, record it, clip it live, and watch it with you seven days a week."
  canonical="/live-streaming"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
        <img src="/images/nav/pillars/publish.png" alt="" class="h-7 w-7 rounded-md" /> Live streaming &middot; Re-streaming &middot; Recordings &middot; Clips
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Connect Once, Stream Seamlessly
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Send us one feed and your service reaches YouTube, Facebook, and your own website player &mdash; recorded, archived, and cut into Reels your team can share before Monday. WorshipMetrics allows you to know who&apos;s in the room, and reach who isn&apos;t.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="streaming_hero_sign_up_free" data-wm-track-location="streaming_hero">Start streaming free</a>
        <a href="/discovery-call" class="btn-outline">Book a call</a>
      </div>
    </div>
  </section>

  <!-- Destinations -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Re-streaming</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Stop juggling stream keys.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          One feed reaches everyone, everywhere. Add or drop a destination in a click &mdash; your encoder settings never change.
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {destinations.map(({ name, desc }) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-lg font-bold text-slate-900">{name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's inside — ranked -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What&apos;s inside</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Streaming that runs like the platforms twice the price.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {[
          {
            title: "Built on a global network",
            body: "Your encoder pushes one RTMPS or SRT feed to stream.worshipmetrics.com, and a worldwide delivery network handles the adaptive bitrate ladder, DVR, and playback. Resilient ingest, not a server in a closet.",
          },
          {
            title: "Lossless worship audio",
            body: "Stream and archive your service with CD-quality lossless FLAC audio alongside a universal AAC fallback in the same stream — because worship deserves better than squashed audio.",
          },
          {
            title: "One feed, ten destinations",
            body: "The cloud fans your single uplink out to up to ten destinations at once — YouTube, Facebook, your own embedded player, and any custom RTMP endpoint — without asking your encoder to do more work.",
          },
          {
            title: "YouTube & Facebook, end to end",
            body: "Broadcasts are created, scheduled, started, and ended for you — with reusable stream keys so vMix is configured exactly once, and settings chosen so a network blip can't permanently kill a broadcast. Facebook tokens renew themselves before they expire.",
          },
          {
            title: "Recordings that just happen",
            body: "Every service records automatically, stays playable even mid-recording, and lands in your archive exactly once. Recording is separate from the broadcast, so nothing about the archive can ever interrupt the live stream.",
          },
          {
            title: "Clip while it's live",
            body: "Cut 'the last 30 seconds' out of the stream while it's still running, or scrub finished recordings and cut frame-accurate clips without downloading multi-gigabyte files first.",
          },
          {
            title: "Reels that find the moments",
            body: "Transcription tuned for church language — an up-to-80-term vocabulary boost so 'propitiation' and your pastor's name transcribe correctly — then AI scores every candidate moment across ten categories and writes a hook caption for each.",
          },
          {
            title: "Branded renders, three formats",
            body: "Vertical, square, and widescreen at 30 fps with burned captions in four styles, six lower-third looks, your brand colors and logo, and intro/outro panels — publishable straight to YouTube.",
          },
          {
            title: "A scored report for every stream",
            body: "Telemetry samples every five seconds build a 0–100 health score per service, with per-issue recommendations. A 45-second grace window means one bad hiccup reads as a reconnect, not a new report.",
          },
          {
            title: "Online attendance fills itself in",
            body: "Concurrent viewers are sampled every minute; when the broadcast ends, peak and average roll into that day's service attendance automatically. Nobody transcribes YouTube numbers into a spreadsheet on Monday.",
          },
        ].map(({ title, body }) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-slate-500">
        Lossless audio is rare enough that we wrote a whole page on it: <a href="/lossless-audio-streaming" class="font-semibold text-indigo-600 hover:text-indigo-800">how lossless worship streaming works &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Watched live -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,0.98fr)_minmax(0,1.02fr)]">
      <div>
        <p class="eyebrow">Stream health</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Sunday has a pulse. We watch it.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Encoder load, dropped frames, bitrate history, per-event logs &mdash; live, on a dashboard, with alerts the moment anything drops. Your congregation should never know about a problem before you do.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          And when something does go wrong, you're not alone: call 910-WORSHIP any day of the week and a person who runs church production answers &mdash; with your system's live health data already in front of them.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/av-monitoring" class="btn-primary">See stream monitoring</a>
          <a href="tel:+19109677447" class="btn-outline">Call 910-WORSHIP</a>
        </div>
      </div>
      <ImageCarousel
        slides={[
          { src: STREAM_LIFESTYLE_IMAGE, alt: "Church booth streaming a service with WorshipMetrics", kind: "lifestyle" },
          { src: STREAM_HEALTH_IMAGE, alt: "Live Stream console with destinations, connections, and events in WorshipMetrics" },
        ]}
      />
    </div>
  </section>

  <!-- Recordings & clips -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Recordings &amp; clips</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Sunday doesn&apos;t end at noon.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {clipFeatures.map(({ title, body }, index) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">{index + 1}</span>
            <h3 class="mt-5 text-xl font-bold text-slate-900">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/solutions/worship-clips" class="btn-outline">See Reels</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Streaming questions, answered.</h2>
      </div>
      <div class="mt-10 space-y-6">
        {faqs.map(({ question, answer }) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-bold text-slate-900">{question}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-slate-50 p-10 text-center shadow-sm sm:p-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Your live stream, handled.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Point your encoder at WorshipMetrics this week and stop thinking about streaming infrastructure on Sunday morning.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="streaming_footer_sign_up_free" data-wm-track-location="streaming_footer">Start streaming free</a>
        <a href="/discovery-call" class="btn-outline text-sm">Book a call</a>
      </div>
    </div>
  </section>
  <!-- Technical details -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical details</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200">
        {[
          ["Ingest", "RTMPS and SRT (stream ID + passphrase) to stream.worshipmetrics.com — works with vMix, OBS, and any RTMP/SRT encoder"],
          ["Delivery", "HLS with an adaptive bitrate ladder to the embeddable player and your hosted watch page (4-second segments, auto-start when you go live)"],
          ["Lossless lane", "FLAC-in-fMP4 (CMAF) lossless audio plus an AAC-LC 256 kbps fallback in one manifest — CD-quality 16-bit/44.1 kHz stereo at roughly 0.8 Mbps"],
          ["Destinations", "Up to 10 simultaneous per channel: YouTube, Facebook Live, Twitch, and any custom RTMP/RTMPS endpoint"],
          ["Recordings", "Automatic per service, up to 4 hours / 8 GB each, playable even mid-recording — and fully separate from the broadcast, so archive limits can never stop a live stream"],
          ["Archive retention", "120 days included; extended one-year archive available as an add-on"],
          ["Clipping", "Live clips up to 10 minutes cut from the in-progress stream; frame-accurate VOD clips over ranged reads (no downloads); whole-service trims without re-encoding"],
          ["Reels transcription", "Speaker labels, auto chapters, and highlights with an up-to-80-term church vocabulary boost — or fully local transcription on Tech Manager so service media never leaves the booth"],
          ["Reels scoring", "Ten clip categories, a 0–100 shareability score, quality badges, and a hook caption per candidate clip"],
          ["Clip renders", "1080×1920, 1920×1080, and 1080×1080 at 30 fps — burned captions (4 styles), 6 lower-third looks, 5 font presets, brand color and logo, intro/outro panels, direct YouTube publishing"],
          ["Stream health", "5-second telemetry samples (bitrate, FPS, encoder load, dropped frames, CPU, RAM, disk) with a 45-second reconnect grace window and a scored report with per-issue recommendations"],
          ["Viewer analytics", "Per-minute concurrent viewer sampling; peak and average viewers roll into service attendance automatically when the broadcast ends"],
          ["Fair use", "20 stream-hours and 2,500 embedded viewer-hours per campus per month, with published flat overages and an alert at 80% — YouTube and Facebook viewers are never metered, and we never stop a live service over a quota"],
        ].map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TechManagerCTA />
</Layout>
