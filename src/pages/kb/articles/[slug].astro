---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export const prerender = true;

const calculateReadingTime = (text: string) => Math.max(3, Math.ceil(text.split(/\s+/).filter(Boolean).length / 220));

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime());
  const esIds = new Set((await getCollection('articlesEs')).map((a) => a.id));
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      article,
      prevArticle: index > 0 ? articles[index - 1] : undefined,
      nextArticle: index < articles.length - 1 ? articles[index + 1] : undefined,
      hasEs: esIds.has(article.id),
    },
  }));
}

const { article, prevArticle, nextArticle, hasEs } = Astro.props as {
  article: CollectionEntry<'articles'>;
  prevArticle?: CollectionEntry<'articles'>;
  nextArticle?: CollectionEntry<'articles'>;
  hasEs: boolean;
};

const SITE_URL = 'https://worshipmetrics.com';
const otherHref = hasEs ? `/es/kb/articles/${article.id}/` : null;
const alternates = hasEs
  ? [
      { hreflang: 'en', href: `${SITE_URL}/kb/articles/${article.id}/` },
      { hreflang: 'es', href: `${SITE_URL}/es/kb/articles/${article.id}/` },
      { hreflang: 'x-default', href: `${SITE_URL}/kb/articles/${article.id}/` },
    ]
  : [];

const { Content, headings } = await render(article);
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((candidate) => candidate.id !== article.id && candidate.data.category === article.data.category)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const readingTime = article.data.readingTime ?? calculateReadingTime(article.body);
---

<ArticleLayout
  article={article}
  headings={headings}
  prevArticle={prevArticle}
  nextArticle={nextArticle}
  relatedArticles={relatedArticles}
  readingTime={readingTime}
  alternates={alternates}
  otherHref={otherHref}
>
  <Content />
</ArticleLayout>
