---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import ArticleLayoutEs from '../../../../layouts/ArticleLayoutEs.astro';
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';

export const prerender = true;

const calculateReadingTime = (text: string) => Math.max(3, Math.ceil(text.split(/\s+/).filter(Boolean).length / 220));

// Generate an /es/ route for EVERY English article. Where a Spanish
// translation exists we render it; otherwise we fall back to the English
// content (its canonical still points at the English URL, so it is never a
// duplicate-content problem) — which lets Spanish articles link to /es/ freely.
export async function getStaticPaths() {
  const en = await getCollection('articles');
  const esIds = new Set((await getCollection('articlesEs')).map((a) => a.id));
  return en.map((article) => ({
    params: { slug: article.id },
    props: { slug: article.id, hasEs: esIds.has(article.id) },
  }));
}

const { slug, hasEs } = Astro.props as { slug: string; hasEs: boolean };
const SITE_URL = 'https://worshipmetrics.com';

const esArticle = hasEs ? ((await getEntry('articlesEs', slug)) as CollectionEntry<'articlesEs'>) : null;
const enArticle = (await getEntry('articles', slug)) as CollectionEntry<'articles'>;
const entry = esArticle ?? enArticle;
const { Content, headings } = await render(entry);
const readingTime = entry.data.readingTime ?? calculateReadingTime(entry.body);

const alternates = hasEs
  ? [
      { hreflang: 'en', href: `${SITE_URL}/kb/articles/${slug}/` },
      { hreflang: 'es', href: `${SITE_URL}/es/kb/articles/${slug}/` },
      { hreflang: 'x-default', href: `${SITE_URL}/kb/articles/${slug}/` },
    ]
  : [];
---

{hasEs && esArticle ? (
  <ArticleLayoutEs
    article={esArticle}
    headings={headings}
    readingTime={readingTime}
    alternates={alternates}
    otherHref={`/kb/articles/${slug}/`}
  >
    <Content />
  </ArticleLayoutEs>
) : (
  <ArticleLayout article={enArticle} headings={headings} relatedArticles={[]} readingTime={readingTime}>
    <Content />
  </ArticleLayout>
)}
