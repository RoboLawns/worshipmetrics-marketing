---
import Layout from "../layouts/Layout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-people-directory.jpg`;
const LIFESTYLE_IMAGE = `${R2}/app-2026/lifestyle/people-management.jpg`;
const SCHEDULE_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-my-schedule.jpg`;

const features = [
  {
    title: "One directory, your vocabulary",
    body: "Members, guests, and attenders — plus unlimited custom types your church defines. Every profile carries labeled contact methods, photo, birthday with auto-computed age, join date, anniversary, and campus.",
  },
  {
    title: "Households, not just rows",
    body: "People group into households with a designated head, shared address, and family visibility — and removing a household never removes its people. Follow-up reaches the right person, not just an address.",
  },
  {
    title: "CSV in, CSV out — safely",
    body: "A 16-field import wizard auto-maps your old system's headers, previews before writing, and handles duplicates your way: skip, update, or create — deduping on email, phone, or exact name. Full exports carry every field.",
  },
  {
    title: "Team Chat, built in",
    body: "Public channels that auto-join the whole org, invite-only private channels, and one-click DMs — with typing indicators, presence, reactions, pinning, file sharing, and polls. Live over WebSocket, everywhere.",
  },
  {
    title: "A serving lifecycle, not a signup sheet",
    body: "Assignments move through unfilled, invited, confirmed, declined, no-show, and completed. A decline instantly re-opens the vacancy and tells the team's leaders — not just whoever clicked invite.",
  },
  {
    title: "My Schedule, self-service",
    body: "Volunteers see their upcoming serves, respond inline or straight from the email — no login required — and manage their own unavailable dates, which leaders see as warnings at assign time, never hard blocks.",
  },
  {
    title: "Emails that close the loop",
    body: "Invites with accept/decline buttons, day-before reminders that can't double-send, cancellation notices, and unfilled-position nudges days before Sunday. The no-show loop closes itself.",
  },
  {
    title: "QR check-in that never duplicates",
    body: "A shareable check-in link and printable QR code for the lobby. Returning attenders match their existing record — by email, then phone, then name and birthday — while true first-timers land in the directory automatically.",
  },
  {
    title: "QR check-in that knows returning faces",
    body: "Print an org-wide QR code for the lobby and returning attenders are matched automatically — on email, then phone, then name and birthday — so first-timers land in the directory without a volunteer typing anything.",
  },
  {
    title: "Live everywhere, instantly",
    body: "Every edit reaches every open screen in about 50 milliseconds — web and desktop — with bulk archive/restore, filtered exports, and a duplicate detector that flags likely pairs for review.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WorshipMetrics People",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: `${SITE_URL}/people`,
  image: HERO_IMAGE,
  description: "Church people directory with members, guests, attenders, and custom types — households, CSV import and export, serving assignments with follow-up tracking, and unlimited users free.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${SITE_URL}/pricing`,
  },
};
---

<Layout
  title="Church People Directory & Member Management"
  socialTitle="WorshipMetrics People"
  description="Members, guests, and attenders in one directory — households, CSV import/export, serving assignments with follow-up tracking, and unlimited users free forever."
  canonical="/people"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO_IMAGE} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
      <div>
        <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><img src="/images/nav/pillars/people.png" alt="" class="h-9 w-9 rounded-lg" /> People</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          The people who make Sunday happen.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Members, guests, and volunteers in one directory &mdash; with serving schedules, team chat, and follow-up built in. Unlimited users on every plan, so the whole team lives in it, from the senior pastor to the newest camera operator.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`${APP_URL}/sign-up`} class="btn-primary" data-wm-track="cta_click" data-wm-track-label="people_hero_sign_up_free" data-wm-track-location="people_hero">Sign up free</a>
          <a href="/volunteers" class="btn-outline">See Volunteers</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">Unlimited users, free forever. Import your existing list by CSV in minutes.</p>
      </div>
      <ImageCarousel
        eager
        slides={[
          { src: LIFESTYLE_IMAGE, alt: "Church staff member managing the congregation directory with WorshipMetrics", kind: "lifestyle" },
          { src: HERO_IMAGE, alt: "Church people directory with statuses, types, and filters in WorshipMetrics" },
        ]}
      />
    </div>
  </section>

  <!-- Feature grid -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">What's included</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">People management that ministry actually uses.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {features.map(({ title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">{title}</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Serving assignments -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">From the directory to the schedule</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Every profile connects to how someone serves.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Open a profile and see the person, not just the record: contact details, household, and their serving assignments &mdash; confirmed, declined, or flagged for follow-up. Message anyone directly through Team Chat without leaving the page.
        </p>
        <ul class="mt-8 space-y-3">
          {[
            "Serving assignments with confirmed, declined, and follow-up statuses",
            "Volunteers accept or decline requests from My Schedule, with unavailable dates leaders can see",
            "One-tap message to any person through Team Chat",
            "Changes sync live across every device — no refresh, no stale lists",
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <div class="mt-8">
          <a href="/volunteers" class="btn-outline">See volunteer scheduling</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={SCHEDULE_IMAGE} alt="My Schedule serving requests and unavailable dates in WorshipMetrics" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Lifestyle band -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={LIFESTYLE_IMAGE} alt="Church staff member managing the congregation directory with WorshipMetrics" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Why it lives here</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The directory that already knows your Sunday.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Standalone church management software doesn&apos;t know who ran the sound board last week or which visitor showed up through a livestream. WorshipMetrics does &mdash; because People sits beside Plan, attendance, and the booth in one platform.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          A visitor becomes a regular, a regular becomes a volunteer, a volunteer becomes a leader &mdash; and the whole journey happens in one system your church already runs on Sunday morning.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/platform/attendance" class="btn-outline">See Attendance</a>
          <a href="/team-chat" class="btn-outline">See Team Chat</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Bring your whole congregation into one place.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Import your list by CSV, invite unlimited users, and give every ministry the same source of truth &mdash; free forever.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary" data-wm-track="cta_click" data-wm-track-label="people_footer_sign_up_free" data-wm-track-location="people_footer_cta">Sign up free</a>
        <a href="/discovery-call" class="btn-outline">Book a demo</a>
        <a href="/pricing" class="btn-outline">See pricing</a>
      </div>
    </div>
  </section>
  <!-- Technical details -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical details</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white">
        {[
          ["Directory model", "Built-in types Member / Guest / Attender plus unlimited custom types; Active/Inactive statuses; labeled multi-value contact methods (home, work, mobile × email, phone, address) and social handles"],
          ["Households", "Optional head-of-household, shared address and contact details, archive flag — removing a household never removes its people"],
          ["CSV import/export", "16-field vocabulary with alias auto-mapping and a preview step; duplicate strategies skip / update / create with dedup on email, phone, or exact name; full server-side export carries every field"],
          ["Serving lifecycle", "Six assignment statuses; tokenized email accept/decline that works without login; per-position needed counts; per-service-time coverage math"],
          ["Volunteer self-service", "My Schedule with inline responses and self-managed unavailable date ranges — surfaced to leaders as warnings, never hard blocks"],
          ["Scheduling emails", "Invites, day-before reminders on a 15-minute idempotent sweep, cancellation notices, decline alerts routed to team leaders, and unfilled-position nudges"],
          ["Team Chat transport", "WebSocket delivery with typing indicators and presence; REST fallback; org-scoped live updates so every open surface stays current"],
          ["Chat file sharing", "Private cloud storage with direct uploads, a 25 MB cap, a safe-format allowlist (images, video, audio, PDF, Office, text), and expiring signed download links"],
          ["Chat polls", "2–10 options, single or multiple choice, vote-change semantics, double-vote-proof by design"],
          ["Auth & team invites", "Role-carrying email invites with cryptographically random tokens and 7-day expiry; joining an existing church always requires an invite"],
          ["Public QR flows", "Org-wide check-in with print-ready QR codes, rate-limited server-side; returning-attender matching tiers: email, then phone, then name + birthday"],
          ["Campuses", "Each person record carries a campus, so multi-site churches keep their directory organized in one place"],
          ["Users & pricing", "Unlimited users and unlimited people on every plan, including Free — the whole volunteer team lives in it"],
        ].map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TechManagerCTA />
</Layout>
