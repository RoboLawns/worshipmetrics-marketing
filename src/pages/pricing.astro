---
import Layout from "../layouts/Layout.astro";
import ResearchCallout from "../components/ResearchCallout.astro";
import { buyingStats, researchCitation } from "../data/churchProductionResearch";
import PricingTwoAxis from "../components/diagrams/PricingTwoAxis.astro";
import FoundersStrip from "../components/FoundersStrip.astro";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const PANELS_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-production-dashboard.jpg`;

// AXIS 1 — THE PLATFORM
const platformPlans = [
  {
    name: "Free",
    price: "$0",
    suffix: "/mo forever",
    tag: "The pledge, free forever",
    badge: "No credit card",
    body: "AV monitoring, the Signal Map, the alerts, and social streaming are free forever. Unlimited users, so the whole volunteer team lives in it.",
    cta: "Get started free",
    href: `${APP_URL}/sign-up`,
    featured: false,
    items: [
      "24/7 AV monitoring, the living Signal Map, and instant alerts — free forever",
      "Social streaming to YouTube and Facebook — we handle the integrations, schedule your broadcasts, and fetch the stream keys, all in one place",
      "OBS, vMix, and Blackmagic ATEM switcher control — plus your PTZ cameras — local control in the booth, free",
      "Tech Manager booth app: production dashboard, camera presets, and self-healing included",
      "Reels free in Tech Manager — AI finds the moments and renders the clips right on the booth PC",
      "Unlimited users — the whole volunteer team lives in it",
      "Worship presentation free forever — slide editor, lyrics, scripture, playlists, and your brand",
      "Core planning and people tools too (practical limits on cloud storage and clips, 1 signage screen)",
      "A taste of the AI — smart help inside your alerts, plus one full help session free (unlimited AI support is what Assist adds)",
      "No trial clock, no credit card — free means free",
    ],
  },
  {
    name: "Assist",
    price: "$49",
    suffix: "/mo",
    tag: "Expert help on tap",
    body: "The full suite unlocked, with unlimited AI support that knows your exact system. For churches that stream elsewhere — or not at all — but want an expert on call.",
    cta: "Start with Assist",
    href: `${APP_URL}/sign-up`,
    featured: false,
    items: [
      "Everything in Free, with the practical limits removed",
      "Cloud control for OBS, vMix, and Blackmagic ATEM — eyes on preview and program, and full switcher control from anywhere",
      "Unlimited 24/7 AI support that knows your system — Luminos in the app, Journey on 910-WORSHIP, no session caps",
      "PCO sync, unlimited signage screens, and cloud Reels — AI clips from anywhere",
      "The full Present suite: multi-screen output, stage displays with transposed chord charts",
      "Full media and song libraries with per-key PDF chord charts, no storage caps",
      "Keep streaming wherever you stream today — Assist works alongside it",
    ],
  },
  {
    name: "Stream",
    price: "$99",
    suffix: "/mo per campus",
    tag: "Streaming, included",
    body: "Everything in Assist, plus premium cloud live streaming that runs like the dedicated platforms — for less than you pay today, with no encoder box to buy.",
    cta: "Start streaming",
    href: `${APP_URL}/sign-up`,
    featured: true,
    items: [
      "Everything in Assist, plus premium cloud live streaming",
      "Resilient SRT and RTMPS ingest straight from OBS or vMix — no encoder hardware to buy",
      "Dedicated infrastructure built to stay up — and a player and watch page where worship is never muted or flagged by a copyright bot",
      "Up to 10 simultaneous destinations: YouTube, Facebook, and an embeddable player with a hosted watch page",
      "Cloud DVR and archive, plus a scored stream-health report wired into your alerts",
      "Reels from any service in a click, plus online attendance analytics",
      "Each campus is its own $99 with its own included usage",
    ],
  },
];

// AXIS 2 — ENHANCED SUPPORT (add-on, stacks on any platform tier)
const supportAddons = [
  {
    name: "Care",
    price: "+$199",
    suffix: "/mo",
    body: "A real support pro on weekdays, a priority queue, and a monthly system review.",
  },
  {
    name: "Sunday Assurance",
    price: "+$499",
    suffix: "/mo",
    body: "A production pro on call every Sunday who can see your system remotely the moment you call, plus a pre-service check. Limited availability while we grow the team — ask us.",
  },
  {
    name: "Managed",
    price: "+$1,299",
    suffix: "/mo",
    body: "The fully-handled production partnership. Includes the Stream platform tier for every campus under management.",
    highlight: true,
  },
];

// WHAT REAL CHURCHES ACTUALLY BUY
const exampleStacks = [
  { church: "75-person church, volunteer-run", stack: "Assist", monthly: "$49", compare: "Figuring it out alone" },
  { church: "200-person church that already streams", stack: "Stream", monthly: "$99", compare: "Often less than they pay today — for streaming alone" },
  { church: "Growing church that cannot risk Sunday", stack: "Stream + Sunday Assurance", monthly: "$598", compare: "$1,500+/mo part-time hire" },
  { church: "Three-campus church, fully handled", stack: "Managed (3 campuses)", monthly: "$1,299", compare: "$3,300–5,800/mo full-time hire" },
];

// STREAM TIER — FAIR USE & OVERAGES
const fairUseRows = [
  { included: "Live stream hours (1080p, all destinations simultaneously)", allowance: "20 hours", overage: "Generous — a typical church never reaches it" },
  { included: "Viewer hours on the embedded player / watch page (YouTube and Facebook viewers are never metered)", allowance: "2,500 viewer-hours", overage: "Generous — a typical church never reaches it" },
  { included: "Cloud archive retention (recordings, DVR, clip sources)", allowance: "120 days", overage: "—" },
  { included: "Simultaneous destinations", allowance: "Up to 10", overage: "—" },
];

const comparisonRows = [
  ["Price", "$0 forever", "$49/mo", "$99/mo per campus"],
  ["24/7 AV monitoring, Signal Map & alerts", "Included", "Included", "Included"],
  ["Social streaming — YouTube & Facebook", "Included — integrations, scheduling & stream keys handled", "Included", "Included"],
  ["Switcher control — OBS, vMix, Blackmagic ATEM", "Local — free", "Local + cloud control", "Local + cloud control"],
  ["PTZ camera control", "Local", "Local + cloud", "Local + cloud"],
  ["Users", "Unlimited", "Unlimited", "Unlimited"],
  ["Planning, presentation & people", "Core (practical limits)", "Full", "Full"],
  ["Storage caps", "Practical limits", "None", "None"],
  ["Digital signage screens", "1", "Unlimited", "Unlimited"],
  ["Reels (AI clipping)", "Free — rendered locally in Tech Manager", "Cloud Reels — from anywhere", "Auto from every service"],
  ["PCO sync", "—", "Included", "Included"],
  ["Luminos + Journey AI support", "A taste — in alerts, plus 1 free session", "Unlimited", "Unlimited"],
  ["Premium cloud streaming — dedicated ingest, stays up, never flagged", "—", "—", "Included"],
  ["Multi-destination + hosted watch page", "—", "—", "Included"],
  ["Cloud DVR & archive", "—", "—", "120 days (extendable)"],
  ["Stream-health monitoring in alerts", "—", "—", "Included"],
  ["Online attendance analytics", "—", "—", "Included"],
  ["First help session", "Free", "Free", "Free"],
];

const faqItems = [
  { question: "Is the Free tier really free forever?", answer: "Yes. No credit card, no trial timer, no expiration. AV monitoring, the living Signal Map, and instant alerts are free forever — that is the pledge, and it never changes. The whole volunteer team can live in it with unlimited users." },
  { question: "What AI support is free, and what does Assist add?", answer: "Free gives you a real taste: Luminos-powered help inside your alerts, plus one full help session so your team can experience it end to end — in the app, no strings. Assist ($49/mo) removes the caps: unlimited 24/7 AI support with Luminos in the app and Journey on 910-WORSHIP, both looking at your live system, as often as your team needs it. If you'd lean on AI help more than once, Assist is the plan built for that." },
  { question: "Can I really stream on the Free plan?", answer: "Yes. Social streaming to YouTube and Facebook is included free: connect your accounts once and WorshipMetrics handles the platform integrations, schedules your broadcasts, and retrieves the stream keys — so your encoder is configured once and everything lives in one place. The Stream plan adds premium cloud streaming on top: dedicated ingest infrastructure built to stay up, up to 10 destinations, and an embeddable player and hosted watch page where worship is never muted or flagged by a copyright bot." },
  { question: "Is switcher control free?", answer: "Locally, yes — on every plan, including Free. Tech Manager controls OBS, vMix, and Blackmagic ATEM switchers, plus your PTZ cameras, from the booth at no cost. Assist and Stream add cloud control: the same full API control, plus live eyes on preview and program, from anywhere — so a trusted helper can monitor the service or assist with the switching remotely." },
  { question: "How do platform tiers and support add-ons combine?", answer: "Pick the platform tier that fits how your church runs Sunday — Free, Assist, or Stream. Then, if you want a person standing behind your team, add Care, Sunday Assurance, or Managed on top. Any tier combines with any add-on, and you can add or drop support anytime." },
  { question: "Why is Stream priced per campus?", answer: "Each campus gets its own encoder, its own Signal Map, its own stream, and its own included usage — so each campus is its own $99. It matches how multi-site churches already buy, without the per-site markup the expensive platforms charge. Network and denomination deals are handled inside Managed." },
  { question: "Do I need to buy a hardware encoder to stream?", answer: "No. The encoder is Tech Manager, the desktop app running on a PC your church already owns — a $0 replacement for the $1,500+ hardware box the expensive streaming platforms require." },
  { question: "What happens if I go over the Stream allowances?", answer: "We never stop a live service over a quota. If you blow through an allowance mid-stream, the stream keeps running and the overage shows up on the bill — never on the screen. Usage alerts fire at 80% of any allowance, and overage pricing is published, flat, and cheap." },
  { question: "Is Reels included, or is it extra?", answer: "Reels — our AI clipping tool, formerly Worship Clips — has a free local workflow inside Tech Manager on every tier. Using Reels in the cloud (access from anywhere, cloud archival, team collaboration) requires the Assist plan or higher, and Stream adds cloud recordings for every service, ready to clip." },
  { question: "Do you offer annual billing?", answer: "Yes. Billed monthly or annually, and annual billing includes 2 months free — you pay 10-month pricing for the year. The first help session is free on every tier." },
  { question: "Do you offer a nonprofit or multi-church discount?", answer: "Yes. Contact us and we will talk through the right fit for your ministry and budget. Multi-campus and denomination rollouts are handled directly inside Managed." },
  { question: "What happens to my data if I cancel?", answer: "Your data stays exportable. We will help you make sure your ministry can keep what it needs." },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "WorshipMetrics Pricing",
    url: `${SITE_URL}/pricing`,
    itemListElement: [
      { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Assist", price: "49", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Stream", price: "99", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Care (enhanced support)", price: "199", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Sunday Assurance (enhanced support)", price: "499", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Managed (enhanced support)", price: "1299", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Pricing — Church AV & Streaming Software"
  description="Streaming, monitoring, planning, presentation, and real support in one platform. Free forever monitoring, $49 Assist, $99 Stream per campus — plus human support that stacks on any tier."
  canonical="/pricing"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Pricing</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">Stream for less. Get everything else included.</h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Streaming that runs like the expensive platforms — for less than you pay today — and it brings monitoring, AI support, planning, presentation, signage, people, and clips with it. AV monitoring, the Signal Map, and the alerts stay free forever.
      </p>
      <div class="mx-auto mt-8 max-w-2xl rounded-2xl border border-indigo-200 bg-indigo-50 px-6 py-4">
        <p class="text-lg font-semibold text-indigo-900 sm:text-xl">&ldquo;$99 a month streams your services — and brings monitoring, planning, presentation, and support with it.&rdquo;</p>
      </div>
    </div>
  </section>

  <!-- Two axes explainer -->
  <section class="px-4 pt-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">How pricing works</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Pick a platform tier. Add the support you want.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        One choice is the software your team runs. The other is how much human help stands behind your Sundays. Any platform tier combines with any support add-on — and the free pledge never changes either way.
      </p>
    </div>
  </section>

  <!-- Diagram: the two choices -->
  <section class="px-4 pb-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl md:overflow-x-auto">
      <div class="md:min-w-[760px]">
        <PricingTwoAxis />
      </div>
    </div>
  </section>

  <!-- AXIS 1 — Platform -->
  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Step 1 — Pick your platform</p>
      <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Three ways to run the platform.</h3>
      <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-3">
        {platformPlans.map(({ name, price, suffix, tag, badge, body, cta, href, featured, items }) => (
          <div class:list={[
            "relative flex flex-col rounded-[1.75rem] border p-8 shadow-sm",
            featured ? "border-indigo-500 bg-indigo-600 shadow-lg shadow-indigo-200" : "border-slate-200 bg-white",
          ]}>
            {featured && <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-amber-400 px-4 py-0.5 text-xs font-bold uppercase tracking-wider text-slate-900">Most popular — pays for itself</span>}
            {badge && <span class:list={["mb-4 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em]", featured ? "bg-white/15 text-white" : "bg-indigo-50 text-indigo-700"]}>{badge}</span>}
            <div>
              <p class:list={["text-sm font-semibold uppercase tracking-[0.16em]", featured ? "text-indigo-200" : "text-indigo-600"]}>{tag}</p>
              <h4 class:list={["mt-3 text-2xl font-bold", featured ? "text-white" : "text-slate-900"]}>{name}</h4>
              <p class:list={["mt-4 text-4xl font-extrabold tracking-tight", featured ? "text-white" : "text-slate-900"]}>{price}<span class:list={["text-base font-medium", featured ? "text-indigo-200" : "text-slate-500"]}>{suffix}</span></p>
              <p class:list={["mt-4 text-sm leading-relaxed", featured ? "text-indigo-100" : "text-slate-600"]}>{body}</p>
            </div>
            <a href={href} class:list={["mt-8 block rounded-xl py-3 text-center text-sm font-semibold transition", featured ? "bg-white text-indigo-700 hover:bg-indigo-50" : "bg-indigo-600 text-white hover:bg-indigo-700"]}>{cta}</a>
            <ul class="mt-8 flex-1 space-y-3">
              {items.map((item) => (
                <li class="flex items-start gap-3 text-sm">
                  <svg class:list={["mt-0.5 h-4 w-4 flex-shrink-0", featured ? "text-indigo-300" : "text-indigo-500"]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span class:list={[featured ? "text-indigo-100" : "text-slate-600"]}>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-sm text-slate-500">Billed monthly or annually — annual billing includes 2 months free. The first help session is free on every tier.</p>
      <div class="mx-auto mt-8 max-w-3xl rounded-[1.75rem] border border-amber-200 bg-amber-50 p-6 text-center">
        <p class="text-base font-semibold text-slate-900">Want to gift WorshipMetrics to your church?</p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Many members cover their church&apos;s annual plan as a designated gift. It&apos;s simple, and because the gift goes to your church, it&apos;s typically tax-deductible. <a href="/gift" class="font-semibold text-indigo-600 hover:text-indigo-800" data-wm-track="cta_click" data-wm-track-label="pricing_gift_learn" data-wm-track-location="pricing_platform">See how it works &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- AXIS 2 — Enhanced support -->
  <section class="bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Step 2 — Add human support, if you want it</p>
      <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Support stacks on top of any platform tier.</h3>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Most weeks your team never opens a ticket: monitoring quietly clears about seventy of every hundred issues before anyone notices, and your plan&apos;s AI handles most of the rest &mdash; a taste of it on Free, unlimited from Assist up. These add-ons decide something different: how much <em>human</em> is standing by for your church. Attach one to whichever platform tier you run.
      </p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {supportAddons.map(({ name, price, suffix, body, highlight }) => (
          <div class:list={[
            "flex flex-col rounded-[1.5rem] border p-8 shadow-sm",
            highlight ? "border-indigo-300 bg-white ring-1 ring-indigo-200" : "border-slate-200 bg-white",
          ]}>
            <h4 class="text-xl font-bold text-slate-900">{name}</h4>
            <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900">{price}<span class="text-base font-medium text-slate-500">{suffix}</span></p>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/discovery-call" class="btn-primary">Talk through the right support level</a>
        <a href="/contact" class="btn-outline">Contact us about support</a>
      </div>
    </div>
  </section>

  <!-- What real churches actually buy -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">What real churches actually buy</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Every combination makes sense.</h2>
      </div>
      <div class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left">
            <tr>
              <th class="px-6 py-4 font-semibold text-slate-700">Church</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Stack</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Monthly</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Compare against</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            {exampleStacks.map(({ church, stack, monthly, compare }) => (
              <tr>
                <td class="px-6 py-4 font-semibold text-slate-900">{church}</td>
                <td class="px-6 py-4 text-slate-600">{stack}</td>
                <td class="px-6 py-4 font-bold text-indigo-600">{monthly}</td>
                <td class="px-6 py-4 text-slate-500">{compare}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Make what you own work -->
  <section class="bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Build on the rock</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Stop buying band-aid boxes. Make what you own work.</h2>
        <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
          When Sunday keeps breaking, the reflex is another purchase — a new switcher, another converter, one more box on the rack. But most Sunday problems aren&apos;t equipment problems. They&apos;re visibility, training, and support problems, and every new box quietly makes those worse. WorshipMetrics fixes the root cause on the equipment you already own.
        </p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">The band-aid cycle</p>
          <ul class="mt-5 space-y-3 text-sm text-slate-600">
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-slate-400"></span><span>Something fails on a Sunday, so the church buys another box — and the system grows a little more complex</span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-slate-400"></span><span>Every new box brings its own cables, configs, and quirks — one more thing only one volunteer understands</span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-slate-400"></span><span>The root cause — nobody can see the whole system, and nobody is supporting the team — never gets fixed</span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-slate-400"></span><span>Churches feel it: 38% now call system complexity a core operational challenge, up 15 points in two years&#8224;</span></li>
          </ul>
        </div>
        <div class="rounded-[1.75rem] border border-indigo-200 bg-indigo-600 p-8 text-white shadow-lg shadow-indigo-200">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-200">The solid foundation</p>
          <ul class="mt-5 space-y-3 text-sm text-indigo-50">
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>Your existing cameras, switcher, and console — <span class="font-semibold text-white">documented, monitored, and controlled in one place</span></span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>The encoder is Tech Manager on a PC you already own — <span class="font-semibold text-white">$0 of new hardware</span></span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>Root causes surface in the Signal Map and alerts — with AI and real people standing behind them</span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>Streaming, planning, presentation, and support built on that foundation — not bolted on beside it</span></li>
          </ul>
        </div>
      </div>
      <div class="mt-8 rounded-[1.75rem] border border-slate-200 bg-white p-8 text-center shadow-sm">
        <p class="text-lg font-semibold leading-relaxed text-slate-900 sm:text-xl">&ldquo;&hellip;a wise man, which built his house upon a rock.&rdquo;</p>
