---
import Layout from "../layouts/Layout.astro";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const PANELS_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-production-dashboard.jpg`;

// AXIS 1 — THE PLATFORM
const platformPlans = [
  {
    name: "Free",
    price: "$0",
    suffix: "/mo forever",
    tag: "The pledge, free forever",
    badge: "No credit card",
    body: "AV monitoring, the Signal Map, and the alerts are free forever. Unlimited users, so the whole volunteer team lives in it.",
    cta: "Get started free",
    href: `${APP_URL}/sign-up`,
    featured: false,
    items: [
      "24/7 AV monitoring, the living Signal Map, and instant alerts — free forever",
      "Control your PTZ cameras and switcher from anywhere in the world",
      "Tech Manager booth app: production dashboard, camera presets, and self-healing included",
      "Unlimited users — the whole volunteer team lives in it",
      "Core planning, presentation, and people tools (practical limits on storage, clips, 1 signage screen)",
      "AI support in your alerts, plus one full help session free",
      "No trial clock, no credit card — free means free",
    ],
  },
  {
    name: "Assist",
    price: "$49",
    suffix: "/mo",
    tag: "Expert help on tap",
    body: "The full suite unlocked, with unlimited AI support that knows your exact system. For churches that stream elsewhere — or not at all — but want an expert on call.",
    cta: "Start with Assist",
    href: `${APP_URL}/sign-up`,
    featured: false,
    items: [
      "Everything in Free, with the practical limits removed",
      "Unlimited 24/7 AI support that knows your system — Luminos in the app, Journey on 910-WORSHIP",
      "PCO sync, unlimited signage screens, and cloud Reels — AI clips from anywhere",
      "The full Present suite: multi-screen output, stage displays with transposed chord charts",
      "Full media and song libraries with per-key PDF chord charts, no storage caps",
      "Keep streaming wherever you stream today — Assist works alongside it",
    ],
  },
  {
    name: "Stream",
    price: "$99",
    suffix: "/mo per campus",
    tag: "Streaming, included",
    body: "Everything in Assist, plus cloud live streaming that runs like the expensive platforms — for less than you pay today, with no encoder box to buy.",
    cta: "Start streaming",
    href: `${APP_URL}/sign-up`,
    featured: true,
    items: [
      "Everything in Assist, plus cloud live streaming",
      "Resilient SRT and RTMPS ingest from the Tech Manager encoder — no $1,500 box",
      "Up to 10 simultaneous destinations: YouTube, Facebook, and an embeddable player with a hosted watch page",
      "Cloud DVR and archive, plus a scored stream-health report wired into your alerts",
      "Lossless CD-quality FLAC audio — streamed live and archived",
      "Reels cut automatically from every service and online attendance analytics",
      "Each campus is its own $99 with its own included usage",
    ],
  },
];

// AXIS 2 — ENHANCED SUPPORT (add-on, stacks on any platform tier)
const supportAddons = [
  {
    name: "Care",
    price: "+$199",
    suffix: "/mo",
    body: "A real support pro on weekdays, a priority queue, and a monthly system review.",
  },
  {
    name: "Sunday Assurance",
    price: "+$499",
    suffix: "/mo",
    body: "A production pro on call and watching every Sunday, guaranteed fast response, and a pre-service check.",
  },
  {
    name: "Managed",
    price: "+$1,299",
    suffix: "/mo",
    body: "The fully-handled production partnership. Includes the Stream platform tier for every campus under management.",
    highlight: true,
  },
];

// WHAT REAL CHURCHES ACTUALLY BUY
const exampleStacks = [
  { church: "75-person church, volunteer-run", stack: "Assist", monthly: "$49", compare: "Figuring it out alone" },
  { church: "200-person church that already streams", stack: "Stream", monthly: "$99", compare: "Often less than they pay today — for streaming alone" },
  { church: "Growing church that cannot risk Sunday", stack: "Stream + Sunday Assurance", monthly: "$598", compare: "$1,500+/mo part-time hire" },
  { church: "Three-campus church, fully handled", stack: "Managed (3 campuses)", monthly: "$1,299", compare: "$3,300–5,800/mo full-time hire" },
];

// STREAM TIER — FAIR USE & OVERAGES
const fairUseRows = [
  { included: "Live stream hours (1080p, all destinations simultaneously)", allowance: "20 hours", overage: "$2 per additional hour" },
  { included: "Viewer hours on the embedded player / watch page (YouTube and Facebook viewers are never metered)", allowance: "2,500 viewer-hours", overage: "$3 per additional 100 viewer-hours" },
  { included: "Cloud archive retention (recordings, DVR, clip sources)", allowance: "120 days", overage: "Extended archive (1 year): +$19/mo" },
  { included: "Simultaneous destinations", allowance: "Unlimited", overage: "—" },
];

const comparisonRows = [
  ["Price", "$0 forever", "$49/mo", "$99/mo per campus"],
  ["24/7 AV monitoring, Signal Map & alerts", "Included", "Included", "Included"],
  ["Remote PTZ camera & switcher control — from anywhere", "Included", "Included", "Included"],
  ["Users", "Unlimited", "Unlimited", "Unlimited"],
  ["Planning, presentation & people", "Core (practical limits)", "Full", "Full"],
  ["Storage caps", "Practical limits", "None", "None"],
  ["Digital signage screens", "1", "Unlimited", "Unlimited"],
  ["Reels (AI clipping)", "Local workflow in Tech Manager", "Cloud Reels", "Auto from every service"],
  ["PCO sync", "—", "Included", "Included"],
  ["Luminos + Journey AI support", "In alerts + 1 free session", "Unlimited", "Unlimited"],
  ["Cloud live streaming", "—", "—", "Included"],
  ["Multi-destination + hosted watch page", "—", "—", "Included"],
  ["Cloud DVR & archive", "—", "—", "120 days (extendable)"],
  ["Stream-health monitoring in alerts", "—", "—", "Included"],
  ["Online attendance analytics", "—", "—", "Included"],
  ["First help session", "Free", "Free", "Free"],
];

const faqItems = [
  { question: "Is the Free tier really free forever?", answer: "Yes. No credit card, no trial timer, no expiration. AV monitoring, the living Signal Map, and instant alerts are free forever — that is the pledge, and it never changes. The whole volunteer team can live in it with unlimited users." },
  { question: "How do platform tiers and support add-ons combine?", answer: "Pick the platform tier that fits how your church runs Sunday — Free, Assist, or Stream. Then, if you want a person standing behind your team, add Care, Sunday Assurance, or Managed on top. Any tier combines with any add-on, and you can add or drop support anytime." },
  { question: "Why is Stream priced per campus?", answer: "Each campus gets its own encoder, its own Signal Map, its own stream, and its own included usage — so each campus is its own $99. It matches how multi-site churches already buy, without the per-site markup the expensive platforms charge. Network and denomination deals are handled inside Managed." },
  { question: "Do I need to buy a hardware encoder to stream?", answer: "No. The encoder is Tech Manager, the desktop app running on a PC your church already owns — a $0 replacement for the $1,500+ hardware box the expensive streaming platforms require." },
  { question: "What happens if I go over the Stream allowances?", answer: "We never stop a live service over a quota. If you blow through an allowance mid-stream, the stream keeps running and the overage shows up on the bill — never on the screen. Usage alerts fire at 80% of any allowance, and overage pricing is published, flat, and cheap." },
  { question: "Is Reels included, or is it extra?", answer: "Reels — our AI clipping tool, formerly Worship Clips — has a free local workflow inside Tech Manager on every tier. Using Reels in the cloud (access from anywhere, cloud archival, team collaboration) requires the Assist plan or higher, and on Stream, Reels are cut automatically from every service." },
  { question: "Do you offer annual billing?", answer: "Yes. Billed monthly or annually, and annual billing includes 2 months free — you pay 10-month pricing for the year. The first help session is free on every tier." },
  { question: "Do you offer a nonprofit or multi-church discount?", answer: "Yes. Contact us and we will talk through the right fit for your ministry and budget. Multi-campus and denomination rollouts are handled directly inside Managed." },
  { question: "What happens to my data if I cancel?", answer: "Your data stays exportable. We will help you make sure your ministry can keep what it needs." },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "WorshipMetrics Pricing",
    url: `${SITE_URL}/pricing`,
    itemListElement: [
      { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Assist", price: "49", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Stream", price: "99", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Care (enhanced support)", price: "199", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Sunday Assurance (enhanced support)", price: "499", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
      { "@type": "Offer", name: "Managed (enhanced support)", price: "1299", priceCurrency: "USD", url: `${SITE_URL}/pricing` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Pricing — Church AV & Streaming Software"
  description="Streaming, monitoring, planning, presentation, and real support in one platform. Free forever monitoring, $49 Assist, $99 Stream per campus — plus human support that stacks on any tier."
  canonical="/pricing"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Pricing</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">Stream for less. Get everything else included.</h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Streaming that runs like the expensive platforms — for less than you pay today — and it brings monitoring, AI support, planning, presentation, signage, people, and clips with it. AV monitoring, the Signal Map, and the alerts stay free forever.
      </p>
      <div class="mx-auto mt-8 max-w-2xl rounded-2xl border border-indigo-200 bg-indigo-50 px-6 py-4">
        <p class="text-lg font-semibold text-indigo-900 sm:text-xl">&ldquo;$99 a month streams your services — and brings monitoring, planning, presentation, and support with it.&rdquo;</p>
      </div>
    </div>
  </section>

  <!-- Two axes explainer -->
  <section class="px-4 pt-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">How pricing works</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Pick a platform tier. Add the support you want.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        One choice is the software your team runs. The other is how much human help stands behind your Sundays. Any platform tier combines with any support add-on — and the free pledge never changes either way.
      </p>
    </div>
  </section>

  <!-- AXIS 1 — Platform -->
  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Step 1 — Pick your platform</p>
      <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Three ways to run the platform.</h3>
      <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-3">
        {platformPlans.map(({ name, price, suffix, tag, badge, body, cta, href, featured, items }) => (
          <div class:list={[
            "relative flex flex-col rounded-[1.75rem] border p-8 shadow-sm",
            featured ? "border-indigo-500 bg-indigo-600 shadow-lg shadow-indigo-200" : "border-slate-200 bg-white",
          ]}>
            {featured && <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-amber-400 px-4 py-0.5 text-xs font-bold uppercase tracking-wider text-slate-900">Most popular — pays for itself</span>}
            {badge && <span class:list={["mb-4 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em]", featured ? "bg-white/15 text-white" : "bg-indigo-50 text-indigo-700"]}>{badge}</span>}
            <div>
              <p class:list={["text-sm font-semibold uppercase tracking-[0.16em]", featured ? "text-indigo-200" : "text-indigo-600"]}>{tag}</p>
              <h4 class:list={["mt-3 text-2xl font-bold", featured ? "text-white" : "text-slate-900"]}>{name}</h4>
              <p class:list={["mt-4 text-4xl font-extrabold tracking-tight", featured ? "text-white" : "text-slate-900"]}>{price}<span class:list={["text-base font-medium", featured ? "text-indigo-200" : "text-slate-500"]}>{suffix}</span></p>
              <p class:list={["mt-4 text-sm leading-relaxed", featured ? "text-indigo-100" : "text-slate-600"]}>{body}</p>
            </div>
            <a href={href} class:list={["mt-8 block rounded-xl py-3 text-center text-sm font-semibold transition", featured ? "bg-white text-indigo-700 hover:bg-indigo-50" : "bg-indigo-600 text-white hover:bg-indigo-700"]}>{cta}</a>
            <ul class="mt-8 flex-1 space-y-3">
              {items.map((item) => (
                <li class="flex items-start gap-3 text-sm">
                  <svg class:list={["mt-0.5 h-4 w-4 flex-shrink-0", featured ? "text-indigo-300" : "text-indigo-500"]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span class:list={[featured ? "text-indigo-100" : "text-slate-600"]}>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-sm text-slate-500">Billed monthly or annually — annual billing includes 2 months free. The first help session is free on every tier.</p>
    </div>
  </section>

  <!-- AXIS 2 — Enhanced support -->
  <section class="bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Step 2 — Add human support, if you want it</p>
      <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Support stacks on top of any platform tier.</h3>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Most weeks your team never opens a ticket: monitoring quietly clears about seventy of every hundred issues before anyone notices, AI resolves most of the rest, and a real person steps in for the few that need hands. These add-ons decide how much human is standing by for your church — attach one to whichever platform tier you run.
      </p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {supportAddons.map(({ name, price, suffix, body, highlight }) => (
          <div class:list={[
            "flex flex-col rounded-[1.5rem] border p-8 shadow-sm",
            highlight ? "border-indigo-300 bg-white ring-1 ring-indigo-200" : "border-slate-200 bg-white",
          ]}>
            <h4 class="text-xl font-bold text-slate-900">{name}</h4>
            <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900">{price}<span class="text-base font-medium text-slate-500">{suffix}</span></p>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/discovery-call" class="btn-primary">Talk through the right support level</a>
        <a href="/contact" class="btn-outline">Contact us about support</a>
      </div>
    </div>
  </section>

  <!-- What real churches actually buy -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">What real churches actually buy</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Every combination makes sense.</h2>
      </div>
      <div class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left">
            <tr>
              <th class="px-6 py-4 font-semibold text-slate-700">Church</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Stack</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Monthly</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Compare against</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            {exampleStacks.map(({ church, stack, monthly, compare }) => (
              <tr>
                <td class="px-6 py-4 font-semibold text-slate-900">{church}</td>
                <td class="px-6 py-4 text-slate-600">{stack}</td>
                <td class="px-6 py-4 font-bold text-indigo-600">{monthly}</td>
                <td class="px-6 py-4 text-slate-500">{compare}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Streaming savings comparison -->
  <section class="bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">The streaming math</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Stream for less than you pay today — box included, because there is no box.</h2>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">What churches often piece together today</p>
          <ul class="mt-5 space-y-3 text-sm text-slate-600">
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-slate-400"></span><span>A dedicated streaming service: often ~$150&ndash;350+/mo, plus a $1,500+ hardware encoder</span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-slate-400"></span><span>Planning, presentation, and signage tools bought separately — with no support layer at all</span></li>
          </ul>
        </div>
        <div class="rounded-[1.75rem] border border-indigo-200 bg-indigo-600 p-8 text-white shadow-lg shadow-indigo-200">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-200">With WorshipMetrics</p>
          <ul class="mt-5 space-y-3 text-sm text-indigo-50">
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span><span class="font-semibold text-white">Stream: $99/mo per campus</span></span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>Encoder: Tech Manager on the PC you already own — <span class="font-semibold text-white">$0</span></span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>Planning, presentation, signage, people, and clips — included</span></li>
            <li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-indigo-300"></span><span>24/7 AI support that knows your system — included</span></li>
          </ul>
        </div>
      </div>
      <p class="mt-4 text-center text-xs text-slate-400">Typical market ranges as of mid-2026 — individual services vary.</p>
    </div>
  </section>

  <!-- Stream fair use & overages -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Stream tier — fair use &amp; overages</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Generous by default. Honest at the edges.</h2>
        <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
          Allowances are sized so a typical church — two services a week plus a midweek gathering — never sees an overage line in its life. Usage alerts fire at 80% of any allowance, and overage pricing is published, flat, and cheap.
        </p>
      </div>
      <div class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left">
            <tr>
              <th class="px-6 py-4 font-semibold text-slate-700">Included per campus, per month</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Allowance</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Overage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            {fairUseRows.map(({ included, allowance, overage }) => (
              <tr>
                <td class="px-6 py-4 font-semibold text-slate-900">{included}</td>
                <td class="px-6 py-4 text-slate-600">{allowance}</td>
                <td class="px-6 py-4 text-slate-600">{overage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-8 rounded-[1.75rem] border border-indigo-200 bg-indigo-50 p-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">A promise that matters on Sunday</p>
        <p class="mx-auto mt-3 max-w-3xl text-lg font-semibold leading-relaxed text-slate-900">
          We never stop a live service over a quota. If you blow through an allowance mid-stream, the stream keeps running and the overage shows up on the bill — never on the screen.
        </p>
      </div>

      <div class="mt-8 rounded-[1.75rem] border border-slate-800 bg-slate-950 p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">Only on Stream &middot; Rare anywhere</p>
            <h3 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">Lossless audio. Because worship is music.</h3>
            <p class="mt-4 text-base leading-relaxed text-slate-300">
              Stream includes something very few platforms in any industry offer: a CD-quality lossless FLAC audio track, delivered alongside a universal fallback in the same stream. The congregation at home hears what the room heard &mdash; and your archive keeps the lossless master for every future clip and re-edit.
            </p>
          </div>
          <div class="flex flex-col items-start gap-3 lg:items-end">
            <a href="/lossless-audio-streaming" class="btn-primary" data-wm-track="cta_click" data-wm-track-label="pricing_lossless_learn" data-wm-track-location="pricing_lossless">How lossless streaming works</a>
            <p class="text-sm text-slate-400">Included with Stream &mdash; no extra charge</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why support is part of the product -->
  <section class="bg-slate-50 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Why support is part of the product</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">910-WORSHIP. Seven days a week. A person answers.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            Every WorshipMetrics plan is backed by humans who run church production, seven days a week — including Sunday morning. The enhanced-support add-ons layer on real people who watch your Sunday, respond fast, and already know your system.
          </p>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            That means real channels: tickets, chat, and a phone line at <a href="tel:+19109677447" class="font-semibold text-indigo-600 hover:text-indigo-800">910-WORSHIP</a> when your team needs a real person.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            "Free gets a whole church into the same plan, watched around the clock, before it pays a dime.",
            "Assist unlocks the full suite and unlimited AI support — Luminos in the app, Journey on the phone.",
            "Stream turns Tech Manager into a cloud encoder and streams every campus for less than a single competitor bill.",
            "Care, Sunday Assurance, and Managed decide how much human stands behind Sunday when it counts.",
          ].map((item) => (
            <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5 text-sm leading-relaxed text-slate-600">{item}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Stream production visual -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
      <div class="grid items-center gap-0 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
        <div class="p-8 sm:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">The encoder you already own</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Tech Manager is the encoder — no $1,500 box on the rack.</h2>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">
            Stream runs on Tech Manager, the desktop app on a PC your church already owns. Resilient ingest, multi-destination delivery, cloud DVR, and stream-health alerts — capability that usually requires dedicated hardware, running as software on a computer you already have.
          </p>
          <div class="mt-6 space-y-3 text-sm text-slate-700">
            {[
              "One feed in — YouTube, Facebook, your embed, and a hosted watch page out.",
              "Stream-health monitoring wired straight into your alerts.",
              "Reels cut automatically from every service, ready before the parking lot empties.",
            ].map((item) => (
              <div class="flex items-start gap-3"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></div>
            ))}
          </div>
          <div class="mt-6">
            <a href="/live-streaming" class="btn-outline">See how streaming works</a>
          </div>
        </div>
        <div class="overflow-hidden border-l border-slate-200 bg-slate-50">
          <img src={PANELS_IMAGE} alt="Production dashboard with audio mix, video, and stream health in WorshipMetrics" loading="lazy" decoding="async" class="aspect-video h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Compare the platform tiers.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Enhanced support — Care, Sunday Assurance, and Managed — stacks on top of whichever tier you choose.
        </p>
      </div>
      <div class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left">
            <tr>
              <th class="px-6 py-4 font-semibold text-slate-700">Capability</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Free</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Assist</th>
              <th class="px-6 py-4 font-semibold text-slate-700">Stream</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            {comparisonRows.map(([feature, free, assist, stream]) => (
              <tr class:list={[feature === "Price" ? "bg-slate-50" : ""]}>
                <td class="px-6 py-4 font-semibold text-slate-900">{feature}</td>
                <td class="px-6 py-4 text-slate-600">{free}</td>
                <td class="px-6 py-4 text-slate-600">{assist}</td>
                <td class="px-6 py-4 text-slate-600">{stream}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">FAQ</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Common questions about WorshipMetrics pricing</h2>
      </div>
      <div class="mt-8 space-y-4">
        {faqItems.map(({ question, answer }) => (
          <details class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer list-none text-lg font-semibold text-slate-900">{question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-indigo-600 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Stream your services for less than you pay today.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-indigo-100 sm:text-lg">
        AV monitoring, the Signal Map, and the alerts are free forever. When you are ready to stream, the whole platform is already here — for less than most churches pay today, with real humans on call seven days a week.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary" style="background:#fff;color:#4361ee;box-shadow:0 10px 30px rgba(15,23,42,0.18);" data-wm-track="cta_click" data-wm-track-label="pricing_footer_get_started_free" data-wm-track-location="pricing_footer_cta">Get started free</a>
        <a href="/discovery-call" class="btn-outline" style="border-color:rgba(255,255,255,0.35);color:#fff;" data-wm-track="cta_click" data-wm-track-label="pricing_footer_book_demo" data-wm-track-location="pricing_footer_cta">Book a demo</a>
        <a href="/contact" class="btn-outline" style="border-color:rgba(255,255,255,0.35);color:#fff;">Talk to sales</a>
      </div>
    </div>
  </section>
</Layout>
