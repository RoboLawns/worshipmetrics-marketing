---
import Layout from "../../layouts/Layout.astro";
import KBQuestions from "../../components/KBQuestions.astro";
import ResearchCallout from "../../components/ResearchCallout.astro";
import { contentStats } from "../../data/churchProductionResearch";
import ImageCarousel from "../../components/ImageCarousel.astro";
import TechManagerCTA from "../../components/TechManagerCTA.astro";
import ReelsPipeline from "../../components/diagrams/ReelsPipeline.astro";
---

<Layout
  title="Reels — Church Sermon Clip Software"
  description="Reels turns your services into church social media clips for Instagram, YouTube Shorts, TikTok, and Facebook without manual video editing. We find the moments, you approve them."
  canonical="/solutions/worship-clips"
>
  <!-- Hero -->
  <section class="bg-white px-6 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-widest text-indigo-600">
        <img src="/images/nav/pillars/publish.png" alt="" class="h-9 w-9 rounded-lg" /> Reels
      </p>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Your message doesn't end when the service does.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 sm:text-xl">
        Reels turns Sunday's service into shareable clips — we find the moments, you approve them.
        Mobile-ready for Instagram, YouTube Shorts, TikTok, and Facebook, without video editing software.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://app.worshipmetrics.com/sign-up"
          class="rounded-lg bg-indigo-600 px-7 py-3 text-base font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition"
        >
          Start for free
        </a>
        <a href="/tech-manager" class="text-base font-semibold text-indigo-600 hover:text-indigo-700">
          Download Tech Manager (free) &rarr;
        </a>
      </div>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-slate-500">
        Formerly Worship Clips. Unlimited AI-assisted clips on Tech Manager, free — cloud Reels included with the Assist plan.
      </p>
    </div>
  </section>

  <!-- Product gallery + demo video -->
  <section class="bg-slate-50 px-6 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        See Reels in action
      </h2>
      <p class="mx-auto mt-4 max-w-3xl text-center text-base leading-relaxed text-slate-600">
        From clip creation and social formatting to team collaboration, this is how churches keep
        their message active all week.
      </p>

      <div class="mx-auto mt-10 max-w-5xl">
        <ImageCarousel
          slides={[
            { src: "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/app-2026/lifestyle/clipping-services.jpg", alt: "Church media volunteer creating Reels from Sunday's service", kind: "lifestyle" },
            { src: "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/app-2026/screenshots/worship-metrics-reels-editor.jpg", alt: "Reels trim editor with transcript, moment bands, and clip timeline", label: "Trim editor" },
            { src: "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/app-2026/screenshots/worship-metrics-reels-moments.jpg", alt: "AI-found moments tagged as sermon points, songs, and key moments in Reels", label: "AI moments" },
            { src: "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/app-2026/screenshots/worship-metrics-reels-library.jpg", alt: "Reels library organized by service with clips made and posted", label: "Library" },
            { src: "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main/app-2026/lifestyle/worship-metrics-reels.jpg", alt: "Sharing church Reels to social media", kind: "lifestyle", label: "Share it" },
          ]}
        />
      </div>

      <div class="mx-auto mt-12 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="aspect-video w-full">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/6o0Ggai8aGY"
            title="Reels demo video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-slate-200 bg-slate-50 px-6 py-12">
    <div class="mx-auto max-w-4xl">
      <dl class="grid grid-cols-1 gap-8 sm:grid-cols-3 text-center">
        <div>
          <dt class="text-4xl font-extrabold text-indigo-600">Unlimited clips</dt>
          <dd class="mt-2 text-sm font-medium text-slate-600">on Tech Manager, free</dd>
        </div>
        <div>
          <dt class="text-4xl font-extrabold text-indigo-600">AI-assisted</dt>
          <dd class="mt-2 text-sm font-medium text-slate-600">auto-identify sermon moments</dd>
        </div>
        <div>
          <dt class="text-4xl font-extrabold text-indigo-600">3 formats</dt>
          <dd class="mt-2 text-sm font-medium text-slate-600">vertical, square, and horizontal</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Diagram: the clip pipeline -->
  <section class="bg-white px-6 pt-20">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">From service to shareable</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">We find the moments. You keep the good ones.</h2>
      </div>
      <div class="mt-10 md:overflow-x-auto">
        <div class="md:min-w-[760px]">
          <ReelsPipeline />
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="px-6 py-20 bg-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl mb-12">
        How it works
      </h2>
      <ol class="relative border-l border-indigo-200 space-y-10 ml-4">
        <li class="pl-8">
          <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-bold">1</span>
          <h3 class="text-xl font-bold text-slate-900">Your service streams or records</h3>
          <p class="mt-2 text-slate-600">
            Connect your YouTube livestream or upload a video file. No special equipment required.
          </p>
        </li>
        <li class="pl-8">
          <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-bold">2</span>
          <h3 class="text-xl font-bold text-slate-900">Clips are created for you</h3>
          <p class="mt-2 text-slate-600">
            Sermons, scripture readings, and worship moments are identified and formatted for every
            major social platform.
          </p>
        </li>
        <li class="pl-8">
          <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-bold">3</span>
          <h3 class="text-xl font-bold text-slate-900">Publish and reach more people</h3>
          <p class="mt-2 text-slate-600">
            Clips publish directly to YouTube Shorts, Facebook, and TikTok &mdash; and render
            Instagram-ready for your team to post. People who weren't in the room see what they missed.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Why it matters -->
  <section class="bg-slate-50 px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl mb-12">
        Reach the people who weren't in the room.
      </h2>
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-3">Social-first formats</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Every clip is formatted for Reels, Shorts, and TikTok automatically. Vertical and
            horizontal, ready to post.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-3">No video editor needed</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            A single volunteer can run the full workflow in under an hour. No Final Cut, no
            Premiere.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-3">Extend your weekly reach</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Your Sunday message becomes content that works all week. People discover your church
            through a clip they never would have searched for.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="bg-white px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl mb-4">
        Free on Tech Manager. Cloud Reels with Assist.
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-base leading-relaxed text-slate-600">
        Reels is included free with Tech Manager — the desktop app that powers the booth. Create unlimited AI-assisted clips right from your local machine. To use Reels in the cloud from anywhere, you'll need the Assist plan — and on Stream, Reels are cut automatically from every service.
      </p>
      <div class="grid gap-8 sm:grid-cols-2">
        <div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-2">Free on Tech Manager</p>
          <p class="text-3xl font-extrabold text-slate-900 mb-1">$0<span class="text-base font-normal text-slate-500">/forever</span></p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Unlimited AI-assisted clips</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Social formatting (vertical, square, horizontal)</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Local clip library</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> No credit card required</li>
          </ul>
          <div class="mt-6">
            <a href="/tech-manager" class="inline-block rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">Download Tech Manager &rarr;</a>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 mb-2">Cloud Reels — Assist plan</p>
          <p class="text-lg font-semibold text-slate-900 mb-1">$49<span class="text-base font-normal text-slate-500">/month</span></p>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Access Reels from anywhere</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Cloud video archival</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Team collaboration on clips</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> Unlimited 24/7 AI support that knows your system</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-indigo-600 font-bold">&check;</span> On Stream: Reels cut automatically from every service</li>
          </ul>
          <div class="mt-6">
            <a href="/pricing" class="inline-block rounded-lg border border-indigo-200 bg-white px-6 py-2.5 text-sm font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50">See all plans &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Related media guides</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {[
          { href: "/sermon-clips-software", title: "Sermon clips software", body: "See the search-focused guide for churches evaluating sermon clipping tools." },
          { href: "/church-digital-signage-software", title: "Church digital signage software", body: "Connect social content and in-building communication inside one church media workflow." },
          { href: "/church-livestream-analytics", title: "Church livestream analytics", body: "See how video performance and online attendance reporting fit together." },
        ].map(({ href, title, body }) => (
          <a href={href} class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:bg-indigo-50/20">
            <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-indigo-600">Read guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-indigo-600 px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Unlimited AI-assisted clips, free in Tech Manager.
      </h2>
      <p class="mt-4 text-lg text-indigo-100">No video editing. No extra equipment. Just your message, reaching further — free forever on your booth computer, or anywhere in the cloud with Assist.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://app.worshipmetrics.com/sign-up"
          class="rounded-lg bg-white px-8 py-3 text-base font-semibold text-indigo-600 shadow-sm hover:bg-indigo-50 transition"
        >
          Start for free
        </a>
        <a href="/pricing" class="rounded-lg border border-indigo-300 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-indigo-500">
          See cloud plans
        </a>
      </div>
    </div>
  </section>
  <!-- Content creation went mainstream -->
  <ResearchCallout
    variant="slate"
    eyebrow="The biggest shift in the survey"
    heading="Short-form content stopped being optional."
    body="Two years ago, content creation for social and short-form video was a niche priority. Church Production Magazine calls its jump the single biggest mover in the entire dataset — a category transformation rather than a trend."
    stats={contentStats}
    footnote="The expectation moved faster than anyone's staffing did. Reels exists so the clips come out of the service you already produced, instead of becoming somebody's Monday."
  />

  <KBQuestions heading="Reels for every role in your church." items={[
    { question: "A social media volunteer's guide to Sunday Reels", href: "/kb/articles/social-media-volunteer-church-reels/" },
    { question: "No social media person? How to train a clips volunteer", href: "/kb/articles/train-church-video-clip-volunteer/" },
    { question: "Reaching the next generation: why your church needs short video", href: "/kb/articles/reach-young-people-short-video-church/" },
    { question: "Can sermon clips actually grow a church?", href: "/kb/articles/pastors-grow-church-with-reels/" },
    { question: "How AI finds your sermon moments: inside the Reels pipeline", href: "/kb/articles/how-ai-finds-sermon-moments/" },
    { question: "How do I get Sunday's sermon onto Instagram before Monday?", href: "/kb/articles/sunday-sermon-instagram-before-monday/" },
  ]} />
  <TechManagerCTA />
</Layout>
