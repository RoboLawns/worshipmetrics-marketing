---
import Layout from "../layouts/Layout.astro";

const APP_URL = "https://app.worshipmetrics.com";

const stack = [
  {
    tool: "Streaming provider",
    examples: "BoxCast, Resi, Restream",
    replaced: "One feed in — fan-out to YouTube, Facebook, your website, and custom RTMP, with automatic recordings and live clipping.",
    href: "/live-streaming",
  },
  {
    tool: "Planning software",
    examples: "Planning Center",
    replaced: "Order of service, songs, keys, chord charts, and live run-through with timers — the whole church on one page.",
    href: "/services",
  },
  {
    tool: "Volunteer scheduling",
    examples: "Planning Center, spreadsheets, group texts",
    replaced: "Teams, positions, invites, and a schedule that doesn't depend on one exhausted coordinator.",
    href: "/volunteers",
  },
  {
    tool: "Presentation software",
    examples: "ProPresenter",
    replaced: "Slides, lyrics, and stage display built from the same service plan — no re-typing the setlist.",
    href: "/features",
  },
  {
    tool: "Team chat",
    examples: "Slack, GroupMe, texting chains",
    replaced: "Channels, DMs, and mentions that live where the service plan and the booth already are.",
    href: "/team-chat",
  },
  {
    tool: "AV monitoring",
    examples: "Nothing — most churches fly blind",
    replaced: "Stream health, device status, and alerts the moment anything drops — before the congregation notices.",
    href: "/av-monitoring",
  },
  {
    tool: "System documentation",
    examples: "A binder nobody updates",
    replaced: "Living device inventory, signal map, and patch sheets that survive volunteer turnover.",
    href: "/system-documentation",
  },
  {
    tool: "A support contract",
    examples: "Nobody offers one",
    replaced: "910-WORSHIP, seven days a week — real humans who run church production, with your system data in front of them.",
    href: "/contact",
  },
];

const faqs = [
  {
    question: "Do we have to replace everything at once?",
    answer:
      "No. Most churches start with the stream — point your encoder at WorshipMetrics — and fold in planning, scheduling, and presentation over a few weeks as the team gets comfortable. Everything works standalone, and everything works better together.",
  },
  {
    question: "Can we keep tools we already love?",
    answer:
      "Yes. WorshipMetrics integrates with 60+ ProAV products and standard protocols, and nothing forces you to drop a tool your team depends on. The consolidation is there when you want it.",
  },
  {
    question: "What does this actually save?",
    answer:
      "Most churches running a modern service pay for four to six separate subscriptions — streaming, planning, presentation, chat — plus the hidden cost of nothing talking to anything. One WorshipMetrics subscription replaces the stack, and the free-forever core covers planning, scheduling, attendance, and monitoring before you pay anything.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Replace Your Church Tech Stack — One Platform, One Login, One Number"
  socialTitle="Replace the stack | WorshipMetrics"
  description="Most churches pay for streaming, planning, presentation, and chat separately — and nothing talks to anything. WorshipMetrics replaces the stack: one subscription, one login, one number to call, 7 days a week."
  canonical="/replace-your-stack"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow inline-flex rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
        Replace the stack
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        One subscription. One login. One number to call.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Most churches run Sunday on four to six subscriptions that don&apos;t talk to each other &mdash; and when something breaks, none of them answers the phone. WorshipMetrics replaces the stack.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="stack_hero_sign_up_free" data-wm-track-location="stack_hero">Sign up free</a>
        <a href="/pricing" class="btn-outline">Compare plans</a>
      </div>
    </div>
  </section>

  <!-- The stack, replaced -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What you can stop paying for</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Eight line items. One platform.</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {stack.map(({ tool, examples, replaced, href }) => (
          <a href={href} class="rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:border-indigo-300 hover:bg-white hover:shadow-md">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-lg font-bold text-slate-900">{tool}</h3>
              <span class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Included</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">{examples}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{replaced}</p>
          </a>
        ))}
      </div>
      <p class="mt-4 text-center text-xs text-slate-400">All trademarks belong to their respective owners.</p>
    </div>
  </section>

  <!-- Detailed comparisons -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Head to head</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Comparing a specific tool?</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {[
          { name: "vs BoxCast", desc: "Church streaming veteran — see what one platform adds around the stream.", href: "/vs/boxcast" },
          { name: "vs Resi", desc: "Resilient delivery without proprietary hardware or enterprise pricing.", href: "/vs/resi" },
          { name: "vs Restream", desc: "General-purpose fan-out vs a platform built for Sunday.", href: "/vs/restream" },
        ].map(({ name, desc, href }) => (
          <a href={href} class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md">
            <h3 class="text-lg font-bold text-slate-900">WorshipMetrics {name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{desc}</p>
            <p class="mt-3 text-sm font-semibold text-indigo-600">Read the comparison &rarr;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Consolidation questions, answered.</h2>
      </div>
      <div class="mt-10 space-y-6">
        {faqs.map(({ question, answer }) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-lg font-bold text-slate-900">{question}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-white p-10 text-center shadow-sm sm:p-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Your live stream, handled. And the stack with it.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Start free — no credit card — and consolidate at whatever pace your team is comfortable with.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="stack_footer_sign_up_free" data-wm-track-location="stack_footer">Sign up free</a>
        <a href="/discovery-call" class="btn-outline text-sm">Book a call</a>
      </div>
    </div>
  </section>
</Layout>
