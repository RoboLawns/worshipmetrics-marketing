---
import Layout from "../layouts/Layout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";

const SITE_URL = "https://worshipmetrics.com";
const APP_URL = "https://app.worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/lifestyle/tech-manager-hero-v2.jpg`;
const SUPPORT_IMAGE = `${R2}/homepage/Worship%20Metrics%20Church%20AV%20Tech%20Support.jpg`;
const SCHEDULE_SHOT = `${R2}/app-2026/screenshots/worship-metrics-my-schedule.jpg`;
const VOLUNTEER_PANEL_IMAGE = `${R2}/Tech%20Manager/WorshipMetrics%20Tech%20Manager%20Web-UI%20Panels.jpg`;

const pillars = [
  {
    key: "present",
    label: "Present",
    icon: "/images/nav/pillars/present.png",
    title: "Modern Presentation, Accessible Everywhere",
    body: "Free forever, and genuinely capable: lyrics, scripture, slides, and stage display built straight from the service plan, not retyped on Saturday night. A full slide editor, a media library with motion backgrounds, timers, and lower thirds, running on the screens you already own. Available 100% in the cloud, so you can make quick changes, and give your team access when and where they want to work.",
    href: "/present",
    linkLabel: "See Present",
    slides: [
      { src: `${R2}/app-2026/lifestyle/presentation.jpg`, alt: "Volunteer running lyrics and slides with WorshipMetrics Present", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-present-slides.jpg`, alt: "Present slide grid with playlists, backgrounds library, and live program output" },
    ],
  },
  {
    key: "produce",
    label: "Produce",
    icon: "/images/nav/pillars/produce.png",
    title: "Run the booth from one window.",
    body: "Tech Manager turns the production computer into mission control: audio meters, video and presentation preview, camera control, and stream health side by side. Volunteers see one calm dashboard instead of five scattered apps. We support OBS, vMix, Blackmagic and NDI to make your production run smoothly.",
    href: "/tech-manager",
    linkLabel: "See Tech Manager",
    slides: [
      { src: `${R2}/app-2026/lifestyle/team-collaboration.jpg`, alt: "Church production team working together in the booth", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-production-dashboard.jpg`, alt: "Production dashboard with audio mix, video, and stream health in WorshipMetrics" },
    ],
  },
  {
    key: "plan",
    label: "Plan",
    icon: "/images/nav/pillars/plan.png",
    title: "Technology to Simplify Worship.",
    body: "Build the order of service, pick the songs in the right key, and schedule the team — in one plan everyone can see. Copy last week forward, make the real changes, and walk into Sunday with the whole church on the same page.",
    href: "/services",
    linkLabel: "See Services",
    slides: [
      { src: `${R2}/app-2026/lifestyle/services-overview.jpg`, alt: "Church team planning Sunday together with WorshipMetrics", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-services-planning.jpg`, alt: "Services planning dashboard with attendance and upcoming services" },
    ],
  },
  {
    key: "publish",
    label: "Publish",
    icon: "/images/nav/pillars/publish.png",
    title: "Connect Once, Stream Seamlessly",
    body: "Send us one feed and your service reaches YouTube, Facebook, and your own website player — recorded, archived, and cut into Reels your team can share before Monday. WorshipMetrics allows you to know who's in the room, and reach who isn't.",
    href: "/live-streaming",
    linkLabel: "See Live Streaming",
    slides: [
      { src: `${R2}/app-2026/lifestyle/av-stream-connections.jpg`, alt: "Church booth streaming a service with WorshipMetrics", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-live-stream.jpg`, alt: "Live Stream console with destinations, connections, and events" },
    ],
  },
  {
    key: "pulse",
    label: "Pulse",
    icon: "/images/nav/pillars/pulse.png",
    title: "Professional AV Monitoring.",
    body: "Pulse monitors every machine, device, and stream 24/7 — free forever. Alerts reach you the moment something drifts, often before anyone in the room notices. It's the reason our support can immediately help you with detailed advice to get to the bottom of any issue.",
    href: "/av-monitoring",
    linkLabel: "See Pulse",
    slides: [
      { src: `${R2}/app-2026/lifestyle/system-health-monitoring.jpg`, alt: "Church tech director monitoring system health with WorshipMetrics", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-pulse-system-health.jpg`, alt: "Pulse system health dashboard monitoring every machine" },
    ],
  },
  {
    key: "patch",
    label: "Patch",
    icon: "/images/nav/pillars/patch.png",
    title: "Every cable, mapped. Every fix, faster.",
    body: "The Signal Map documents your whole system — devices, ports, and labeled cable runs. Knowledge stops living in one volunteer's head, new team members find their way around in minutes, and support can point to the exact cable.",
    href: "/system-documentation",
    linkLabel: "See System Documentation",
    slides: [
      { src: `${R2}/app-2026/lifestyle/device-map.jpg`, alt: "Church tech director reviewing the AV signal map", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-signal-map.jpg`, alt: "Signal Map with labeled cable runs in WorshipMetrics" },
    ],
  },
  {
    key: "people",
    label: "People",
    icon: "/images/nav/pillars/people.png",
    title: "The people who make Sunday happen.",
    body: "Members, guests, and volunteers in one directory — with serving schedules, team chat, and follow-up built in. Unlimited users on every plan, so the whole team lives in it, from the senior pastor to the newest camera operator.",
    href: "/people",
    linkLabel: "See People",
    slides: [
      { src: `${R2}/app-2026/lifestyle/people-management.jpg`, alt: "Church staff member managing the congregation directory", kind: "lifestyle" },
      { src: `${R2}/app-2026/screenshots/worship-metrics-people-directory.jpg`, alt: "Church people directory with statuses, types, and filters" },
    ],
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WorshipMetrics",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Windows, Mac",
  url: SITE_URL,
  image: `${R2}/app-2026/lifestyle/tech-manager-hero-v2.jpg`,
  slogan: "Wired for Worship.",
  description: "WorshipMetrics is the church platform that plans your service, runs the booth, streams your message, and monitors your AV — with tech support that already knows your system.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${SITE_URL}/pricing`,
  },
};
---

<Layout
  title="Worship Presentation & Church AV Software"
  socialTitle="WorshipMetrics | Wired for Worship."
  description="Worship presentation, live streaming, and AV monitoring in one platform. Plan the service, run the booth, stream the message — with tech support that already knows your system."
  canonical="/"
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO_IMAGE} />
  </Fragment>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
      <div>
        <p class="eyebrow inline-flex items-center gap-2.5 rounded-full border border-indigo-200 bg-indigo-50 py-1 pl-1 pr-4 shadow-sm">
          <img src="/images/app-icon.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
          The church AV &amp; worship platform
        </p>
        <h1 class="mt-6 text-5xl font-extrabold tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
          Wired for Worship.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Every wire, every screen, every Sunday. Let&apos;s make your AV bullet-proof and provide opportunities for young people to serve your mission more effectively. WorshipMetrics is the platform that helps you plan your service, run the booth, stream your message, and monitor your AV &mdash; with tech support that already knows your system.
        </p>
        <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row">
          <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="home_hero_get_started" data-wm-track-location="home_hero">Get started free</a>
          <a href="tel:+19109677447" class="btn-outline text-base px-8 py-3.5">Call 910-WORSHIP</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">AV monitoring, the Signal Map, and alerts are free forever. No credit card.</p>
      </div>
      <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
        <img src={HERO_IMAGE} alt="Two young volunteers running the church livestream and booth from tablets during worship" loading="eager" decoding="async" fetchpriority="high" class="w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- The seven pillars -->
  {pillars.map(({ key, label, icon, title, body, href, linkLabel, slides }, index) => (
    <section class={`px-4 py-20 sm:px-6 lg:px-8 ${index % 2 === 0 ? "bg-white" : "bg-slate-50"}`}>
      <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
        <div class={index % 2 === 1 ? "lg:order-last" : ""}>
          <p class="eyebrow flex items-center gap-2"><img src={icon} alt="" class="h-10 w-10 rounded-xl" /> {label}</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{title}</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">{body}</p>
          <div class="mt-8">
            <a href={href} class="btn-outline" data-wm-track="cta_click" data-wm-track-label={`home_pillar_${key}`} data-wm-track-location="home_pillars">{linkLabel} &rarr;</a>
          </div>
        </div>
        <ImageCarousel eager={index === 0} slides={slides} />
      </div>
    </section>
  ))}

  <!-- AV Club / youth serving -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.98fr)_minmax(0,1.02fr)]">
      <div>
        <p class="eyebrow">Build a ministry, not just a production team</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Your AV booth could be where young people find their place.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Churches need volunteers. Young people need meaningful next steps and real responsibility. With defined serving positions, simple schedules, and controls a student can actually reach, WorshipMetrics helps you invite them into Sunday without throwing them into the deep end &mdash; so the AV Club becomes a ministry, not a staffing fix.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/av-club" class="btn-primary" data-wm-track="cta_click" data-wm-track-label="home_avclub" data-wm-track-location="home_avclub">See the AV Club</a>
          <a href="/volunteers" class="btn-outline">See Volunteers</a>
        </div>
      </div>
      <ImageCarousel
        slides={[
          { src: SCHEDULE_SHOT, alt: "My Schedule with serving requests a volunteer can accept or decline", label: "My Schedule" },
          { src: VOLUNTEER_PANEL_IMAGE, alt: "Volunteer-friendly production controls in WorshipMetrics", label: "Booth controls" },
        ]}
      />
    </div>
  </section>

  <!-- Support: AI-first, human-backed -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center">
        <div>
          <p class="eyebrow">Support &middot; AI-first, human-backed &middot; 24/7</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tech support that already knows your system.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            Our first tier of support is an advanced AI connected to your booth. Once Tech Manager is running, Luminos in the app and Journey on 910-WORSHIP see your AV system in real time &mdash; every device, connection, and stream &mdash; so chat and phone support are detailed, specific, and available 24/7.
          </p>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            Complex AV systems are exactly where this shines: with your system design in WorshipMetrics, the AI gives volunteers precise, checkable steps &mdash; and that same live context makes our real human team faster when they step in. A free onboarding call gets your system documented so support is this good from day one.
          </p>
          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a href="tel:+19109677447" class="btn-primary">Call 910-WORSHIP</a>
            <a href="/phone-support" class="btn-outline">How our support works</a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Want more human? <a href="/pricing" class="font-semibold text-indigo-600 hover:text-indigo-800">Care, Sunday Assurance, and Managed stack on any plan &rarr;</a>
          </p>
        </div>
        <div>
          <div class="mb-4 overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-sm">
            <img src={SUPPORT_IMAGE} alt="Church AV tech support — help that already knows your system" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            {[
              { title: "Call", body: "Journey answers 910-WORSHIP any hour with your live system in view — a real person is patched in when it matters." },
              { title: "Chat", body: "Luminos in the app sees the same live system. Ask it anything, from a flashing alert to a setup question." },
              { title: "Ticket", body: "Escalations open a case automatically — with the AI's diagnosis attached, so nothing gets re-explained." },
            ].map(({ title, body }) => (
              <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5">
                <p class="eyebrow">{title}</p>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-indigo-200 bg-indigo-50 p-8 text-center shadow-sm sm:p-10">
      <p class="eyebrow">Simple pricing</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Free forever to start. $49 for the full suite. $99 to stream.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        AV monitoring, the Signal Map, and alerts are free forever &mdash; with unlimited users. Assist unlocks the whole platform with 24/7 AI support, and Stream adds cloud live streaming for less than most churches pay today. Human support plans stack on top whenever you want them.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/pricing" class="btn-primary" data-wm-track="cta_click" data-wm-track-label="home_pricing_teaser" data-wm-track-location="home_pricing">See pricing</a>
        <a href={`${APP_URL}/sign-up`} class="btn-outline">Get started free</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Get your church wired for worship.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
        Plan the service, run the booth, stream the message, and let us watch the wires &mdash; with real help one phone call away, any time.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="home_footer_get_started" data-wm-track-location="home_footer">Get started free</a>
        <a href="tel:+19109677447" class="btn-ghost-dark">Call 910-WORSHIP</a>
      </div>
    </div>
  </section>
</Layout>
