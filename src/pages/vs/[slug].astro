---
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [
    { params: { slug: "boxcast" } },
    { params: { slug: "resi" } },
    { params: { slug: "restream" } },
  ];
}

const SITE_URL = "https://worshipmetrics.com";
const APP_URL = "https://app.worshipmetrics.com";
const { slug } = Astro.params;

// Cell values: true = included, false = not offered, or a short string for nuance.
const competitors = {
  boxcast: {
    name: "BoxCast",
    title: "BoxCast Alternative for Churches",
    metaDescription:
      "Comparing WorshipMetrics vs BoxCast? Both stream your service everywhere. WorshipMetrics adds service planning, volunteer scheduling, presentation, AV monitoring, and 7-day human support — one platform instead of a stack.",
    heroLine:
      "BoxCast is a respected church streaming platform. If streaming is the only thing you need handled, it's a fine choice. WorshipMetrics handles the stream and everything around it.",
    shines:
      "BoxCast has served church streaming for years: reliable broadcasts, multi-destination streaming, an embeddable player, and TV apps. If your church only needs a pipe from the booth to the internet, BoxCast does that job.",
    different:
      "Sunday isn't just a stream — it's a plan, a volunteer team, slides, a booth, and a pile of gear that all have to work at 9am. WorshipMetrics is the only platform where the stream, the plan, the people, and the monitoring live in one login, backed by humans seven days a week.",
    matrix: {
      "Streaming destination with multi-platform fan-out": true,
      "Automatic recordings library": true,
      "Website embed player": true,
      "Live clipping during the service": "Limited",
      "AI sermon clips for social": false,
      "Service planning & order of service": false,
      "Volunteer scheduling & team chat": false,
      "Presentation, lyrics & stage display": false,
      "AV device monitoring & alerts": false,
      "System documentation & signal map": false,
      "Switcher & PTZ camera control": false,
      "Built specifically for churches": true,
      "Free-forever tier": false,
    },
    faqs: [
      {
        question: "Can WorshipMetrics do what BoxCast does?",
        answer:
          "Yes — point your encoder at WorshipMetrics and we fan the stream out to YouTube, Facebook, your website embed, and any custom RTMP destination, with automatic recordings after every service.",
      },
      {
        question: "What does WorshipMetrics add that BoxCast doesn't?",
        answer:
          "Everything around the stream: service planning, volunteer scheduling, presentation and stage display, switcher and camera control, AV device monitoring with alerts, system documentation, AI sermon clips, and phone support from real church production people seven days a week.",
      },
      {
        question: "How hard is it to switch from BoxCast?",
        answer:
          "One encoder setting. Point vMix, OBS, or your hardware encoder at your WorshipMetrics ingest, re-add your destinations in a click each, and your next service streams through WorshipMetrics.",
      },
    ],
  },
  resi: {
    name: "Resi",
    title: "Resi Alternative for Churches",
    metaDescription:
      "Comparing WorshipMetrics vs Resi? Resi focuses on resilient streaming delivery. WorshipMetrics streams everywhere and adds planning, volunteers, presentation, AV monitoring, and 7-day human support in one platform.",
    heroLine:
      "Resi is known for resilient streaming delivery, often paired with its own encoder hardware. WorshipMetrics takes a different bet: the whole Sunday workflow in one platform, with humans watching your stream alongside you.",
    shines:
      "Resi built its reputation on stream resiliency — buffered delivery designed to ride out network hiccups, plus multisite delivery features, typically at an enterprise price point with dedicated encoder hardware.",
    different:
      "Most churches don't need proprietary hardware — they need the stream handled and the chaos around it organized. WorshipMetrics works with the encoder you already own, fans your feed out everywhere, records and clips it, and wraps the whole service — plan, people, presentation, gear — in one platform with 7-day human support.",
    matrix: {
      "Streaming destination with multi-platform fan-out": true,
      "Works with your existing encoder (vMix, OBS, RTMP)": "Hardware-first",
      "Automatic recordings library": true,
      "Live clipping during the service": false,
      "AI sermon clips for social": false,
      "Service planning & order of service": false,
      "Volunteer scheduling & team chat": false,
      "Presentation, lyrics & stage display": false,
      "AV device monitoring & alerts": false,
      "System documentation & signal map": false,
      "Switcher & PTZ camera control": false,
      "Built specifically for churches": true,
      "Free-forever tier": false,
    },
    faqs: [
      {
        question: "Do I need special hardware to stream with WorshipMetrics?",
        answer:
          "No. WorshipMetrics takes a standard RTMP feed from vMix, OBS, or any hardware encoder you already own. There's nothing proprietary to buy.",
      },
      {
        question: "What about stream reliability?",
        answer:
          "We monitor your stream's health in real time — encoder load, dropped frames, bitrate history — and alert you the moment anything degrades. And unlike a dashboard alone, there's a human at 910-WORSHIP seven days a week who already has your system data in front of them.",
      },
      {
        question: "Is WorshipMetrics cheaper than Resi?",
        answer:
          "WorshipMetrics has a free-forever core and affordable pro plans with support included, and there's no required hardware purchase. Compare current pricing on our pricing page and Resi's site.",
      },
    ],
  },
  restream: {
    name: "Restream",
    title: "Restream Alternative for Churches",
    metaDescription:
      "Comparing WorshipMetrics vs Restream? Both fan one feed out to many destinations. WorshipMetrics is built for churches — with service planning, volunteers, presentation, AV monitoring, and humans on call 7 days a week.",
    heroLine:
      "Restream is a solid general-purpose multistreaming tool. But your church isn't a general-purpose streamer — and Sunday needs more than fan-out.",
    shines:
      "Restream does one thing well for a broad market: take one feed and push it to many platforms, with a browser studio and chat aggregation. For a solo creator, that's often enough.",
    different:
      "A church service has a plan, a volunteer team, lyrics on screens, a booth full of gear, and a congregation that notices when any of it fails. WorshipMetrics does the fan-out and the rest of Sunday: planning, scheduling, presentation, monitoring, recordings, sermon clips — with real humans who run church production answering the phone seven days a week.",
    matrix: {
      "Streaming destination with multi-platform fan-out": true,
      "Automatic recordings library": true,
      "Live clipping during the service": "Limited",
      "AI sermon clips for social": false,
      "Service planning & order of service": false,
      "Volunteer scheduling & team chat": false,
      "Presentation, lyrics & stage display": false,
      "AV device monitoring & alerts": false,
      "System documentation & signal map": false,
      "Switcher & PTZ camera control": false,
      "Phone support from church production techs": false,
      "Built specifically for churches": false,
      "Free-forever tier": true,
    },
    faqs: [
      {
        question: "We already use Restream for fan-out. Why switch?",
        answer:
          "You'd keep the fan-out and gain the rest: automatic recordings, sermon clips, service planning, volunteer scheduling, presentation, AV monitoring with alerts, and phone support from people who run church production — replacing several subscriptions with one.",
      },
      {
        question: "Does WorshipMetrics stream to the same destinations?",
        answer:
          "YouTube, Facebook, your website embed, and any custom RTMP destination. One feed in, everywhere out.",
      },
      {
        question: "Is there a free tier?",
        answer:
          "Yes — WorshipMetrics has a free-forever core with no credit card required, including planning, scheduling, attendance, monitoring, and more.",
      },
    ],
  },
};

const comp = competitors[slug];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: comp.faqs.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];

const cellLabel = (value) => (value === true ? "Included" : value === false ? "—" : value);
---

<Layout
  title={`${comp.title} — WorshipMetrics vs ${comp.name}`}
  socialTitle={`WorshipMetrics vs ${comp.name} | Your live stream, handled.`}
  description={comp.metaDescription}
  canonical={`/vs/${slug}`}
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow inline-flex rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
        Comparison &middot; Updated July 2026
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        WorshipMetrics vs {comp.name}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        {comp.heroLine}
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label={`vs_${slug}_hero_sign_up_free`} data-wm-track-location={`vs_${slug}_hero`}>Sign up free</a>
        <a href="/live-streaming" class="btn-outline">See how streaming works</a>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="w-full min-w-[36rem] border-collapse text-left">
          <thead>
            <tr class="bg-slate-50">
              <th class="px-6 py-4 text-sm font-semibold text-slate-900">What Sunday needs</th>
              <th class="px-6 py-4 text-sm font-bold text-indigo-600">WorshipMetrics</th>
              <th class="px-6 py-4 text-sm font-semibold text-slate-600">{comp.name}</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(comp.matrix).map(([feature, value]) => (
              <tr class="border-t border-slate-200">
                <td class="px-6 py-3.5 text-sm text-slate-700">{feature}</td>
                <td class="px-6 py-3.5 text-sm font-semibold text-indigo-600">Included</td>
                <td class="px-6 py-3.5 text-sm text-slate-500">{cellLabel(value)}</td>
              </tr>
            ))}
            <tr class="border-t border-slate-200 bg-indigo-50/50">
              <td class="px-6 py-3.5 text-sm font-semibold text-slate-900">Human support, 7 days a week, from church production techs</td>
              <td class="px-6 py-3.5 text-sm font-semibold text-indigo-600">910-WORSHIP</td>
              <td class="px-6 py-3.5 text-sm text-slate-500">Check their plans</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-slate-400">
        Comparison reflects publicly available information about {comp.name} as of July 2026 and may not capture recent changes or every plan tier. Verify details with the vendor. All trademarks belong to their respective owners.
      </p>
    </div>
  </section>

  <!-- Fair shake + differentiator -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-2">
      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
        <p class="eyebrow">Where {comp.name} shines</p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">{comp.shines}</p>
      </div>
      <div class="rounded-[1.75rem] border border-indigo-200 bg-indigo-50 p-8 shadow-sm">
        <p class="eyebrow">Where WorshipMetrics is different</p>
        <p class="mt-4 text-base leading-relaxed text-slate-700 sm:text-lg">{comp.different}</p>
      </div>
    </div>
  </section>

  <!-- Switching -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Switching</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Switch in one encoder setting.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {[
          { title: "Point your encoder at us", body: "vMix, OBS, or any RTMP encoder — swap the ingest URL and key once. That's the whole migration." },
          { title: "Re-add your destinations", body: "YouTube, Facebook, your website embed, custom RTMP — each one is a click, and your feed fans out from there." },
          { title: "Bring the team along", body: "Import your people via CSV, build this week's plan, and Sunday runs through one platform — with 910-WORSHIP behind it." },
        ].map(({ title, body }, index) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">{index + 1}</span>
            <h3 class="mt-5 text-xl font-bold text-slate-900">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">WorshipMetrics vs {comp.name}, answered.</h2>
      </div>
      <div class="mt-10 space-y-6">
        {comp.faqs.map(({ question, answer }) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-bold text-slate-900">{question}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-slate-50 p-10 text-center shadow-sm sm:p-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Your live stream, handled.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Start free, point your encoder at WorshipMetrics, and see what Sunday feels like when one platform carries it.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label={`vs_${slug}_footer_sign_up_free`} data-wm-track-location={`vs_${slug}_footer`}>Sign up free</a>
        <a href="/discovery-call" class="btn-outline text-sm">Book a call</a>
      </div>
    </div>
  </section>
</Layout>
