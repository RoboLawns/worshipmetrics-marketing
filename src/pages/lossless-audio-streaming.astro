---
import Layout from "../layouts/Layout.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-stream-health.jpg`;
const LIFESTYLE_IMAGE = `${R2}/app-2026/lifestyle/stream-health.jpg`;

const steps = [
  {
    step: "1",
    title: "Your booth sends full-quality audio",
    body: "The encoder pushes an SRT feed to stream.worshipmetrics.com carrying your video alongside uncompressed PCM audio — the same quality your console puts out, before any lossy encode touches it.",
  },
  {
    step: "2",
    title: "The cloud packages two renditions in one stream",
    body: "We package a lossless FLAC track and a high-quality AAC fallback into a single CMAF manifest. One stream, two audio qualities — no second encoder, no separate feed to babysit.",
  },
  {
    step: "3",
    title: "Every listener gets the best their device can play",
    body: "Devices that decode FLAC receive bit-perfect audio; everything else falls back to 256 kbps AAC automatically. Nobody configures anything — the player negotiates it.",
  },
];

const faqItems = [
  {
    question: "What is lossless audio streaming?",
    answer: "Most live streams compress audio with lossy codecs that permanently discard detail — usually fine for speech, but audible on music: cymbals smear, congregational singing turns to mush, dynamics flatten. Lossless streaming delivers the audio bit-for-bit identical to what left your mixing console, using FLAC compression that shrinks the data without discarding any of it.",
  },
  {
    question: "Do viewers need special equipment to hear it?",
    answer: "No. The lossless FLAC track and a high-quality AAC fallback travel in the same stream. Devices and browsers that can decode FLAC get lossless automatically; everything else plays the 256 kbps AAC rendition — still excellent — with no setup on the viewer's end.",
  },
  {
    question: "Does lossless streaming cost extra?",
    answer: "It's included in the Stream plan at $99 per month per campus, alongside multi-destination delivery, cloud DVR and archive, Reels, and stream health monitoring.",
  },
  {
    question: "How much bandwidth does lossless audio use?",
    answer: "Less than you'd guess: CD-quality FLAC — 16-bit, 44.1 kHz stereo — runs roughly 0.8 Mbps. That's a fraction of the video's bandwidth, which is why lossless audio is practical on an ordinary church internet connection.",
  },
  {
    question: "Do YouTube and Facebook viewers hear lossless audio?",
    answer: "No platform we restream to accepts lossless audio — YouTube and Facebook re-encode everything with their own codecs. Lossless applies to your embedded player, your hosted watch page, and your archive. That archive matters most: your recordings keep the lossless master, so every clip and future re-edit starts from full quality.",
  },
  {
    question: "Why does a church need lossless audio?",
    answer: "Because worship is music. A sermon survives compression; a worship set is where lossy audio does real damage. The people worshiping from home — the homebound, the traveling, the not-yet-walked-in — deserve to hear the same worship the room heard. And your archive becomes a master recording of your church's worship, not a compressed copy of it.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "WorshipMetrics Lossless Audio Streaming",
    serviceType: "Lossless FLAC live streaming for churches",
    provider: { "@type": "Organization", name: "WorshipMetrics", url: SITE_URL },
    description: "Live stream worship with CD-quality lossless FLAC audio alongside a universal AAC fallback in one stream — included with the WorshipMetrics Stream plan.",
    url: `${SITE_URL}/lossless-audio-streaming`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<Layout
  title="Lossless Audio Live Streaming for Churches — CD-Quality FLAC Worship Streams"
  socialTitle="WorshipMetrics | Lossless worship streaming."
  description="Stream your worship with CD-quality lossless FLAC audio — alongside a universal AAC fallback in the same stream. How it works, why it matters for music-driven services, and why your archive deserves a master, not a copy."
  canonical="/lossless-audio-streaming"
  ogImage={LIFESTYLE_IMAGE}
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
        <img src="/images/nav/pillars/publish.png" alt="" class="h-5 w-5 rounded" /> Publish &middot; Lossless audio
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Worship, streamed without losing a note.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Almost every live stream compresses the life out of worship audio. WorshipMetrics streams a CD-quality lossless FLAC track alongside a universal fallback &mdash; in one stream &mdash; so the congregation at home hears what the room heard.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="lossless_hero_start" data-wm-track-location="lossless_hero">Start streaming</a>
        <a href="/pricing" class="btn-outline">Included with Stream — $99/mo</a>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A sermon survives compression. A worship set doesn&apos;t.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Lossy audio codecs permanently discard detail to save bandwidth. On speech you rarely notice. On music you do: cymbals smear into hiss, congregational singing turns muddy, and the dynamics your worship team works so hard for get flattened on the way out the door.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Lossless FLAC changes the deal: the audio that reaches the listener is bit-for-bit identical to what left your console. The homebound member worshiping from a living room hears the same worship the sanctuary heard &mdash; and that&apos;s the point.
        </p>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Very few streaming platforms in any industry offer this. We built it because worship is the one broadcast where the music <em>is</em> the message.
        </p>
      </div>
      <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
        <img src={LIFESTYLE_IMAGE} alt="Church tech team reviewing a lossless worship stream" loading="eager" decoding="async" class="aspect-video w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">How it works</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">One stream. Two audio qualities. Zero viewer setup.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map(({ step, title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">{step}</span>
            <h3 class="mt-5 text-xl font-bold text-slate-900">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-slate-500">
        The numbers, for the skeptics: CD-quality FLAC (16-bit / 44.1 kHz stereo) runs roughly 0.8 Mbps &mdash; a fraction of your video bandwidth. Lossless is not a bandwidth problem; it just needed someone to build it.
      </p>
    </div>
  </section>

  <!-- Archive angle -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-indigo-200 bg-indigo-50 p-8 shadow-sm sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
        <div>
          <p class="eyebrow">Your archive becomes a master</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Every recording keeps the lossless track.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            Restream destinations re-encode whatever they receive &mdash; that&apos;s out of anyone&apos;s hands. But your own player, your watch page, and above all your <em>archive</em> keep the lossless master. Every Reel you cut, every anniversary montage, every future re-edit starts from full quality instead of a copy of a copy.
          </p>
          <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row">
            <a href="/live-streaming" class="btn-primary">See live streaming</a>
            <a href="/kb/articles/lossless-flac-live-streaming-worship/" class="btn-outline">The deep technical dive</a>
          </div>
        </div>
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
          <img src={HERO_IMAGE} alt="Stream health report for a lossless worship stream in WorshipMetrics" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Technical details -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical details</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white">
        {[
          ["Ingest", "SRT (stream ID + passphrase) to stream.worshipmetrics.com, carrying H.264 video with uncompressed PCM audio"],
          ["Lossless codec", "FLAC, 16-bit / 44.1 kHz stereo — bit-perfect CD quality at roughly 0.7–0.9 Mbps"],
          ["Packaging", "FLAC-in-fMP4 (CMAF) alongside an AAC-LC 256 kbps fallback rendition in a single HLS manifest"],
          ["Playback", "Devices that decode FLAC get lossless automatically; all others receive the AAC rendition — no viewer configuration"],
          ["Where lossless applies", "Your embedded player, your hosted watch page, and your recording archive; restream platforms (YouTube, Facebook) re-encode with their own codecs"],
          ["Archive", "Recordings retain the lossless track — clips and re-edits start from the master, within your archive retention window"],
          ["Availability", "Included with the Stream plan ($99/mo per campus) — no additional charge, no separate audio product"],
        ].map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Lossless streaming, answered.</h2>
      </div>
      <div class="mt-10 space-y-4">
        {faqItems.map(({ question, answer }) => (
          <details class="group rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <summary class="cursor-pointer text-base font-semibold text-slate-900 marker:content-none">{question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Give the congregation at home the whole song.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
        Lossless audio, ten destinations, DVR, Reels, and a scored health report for every service &mdash; all in the Stream plan.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="lossless_footer_start" data-wm-track-location="lossless_footer">Start streaming</a>
        <a href="/pricing" class="rounded-xl border border-white/25 px-8 py-3.5 text-base font-semibold text-white transition hover:border-indigo-300 hover:text-indigo-200">See pricing</a>
      </div>
    </div>
  </section>

  <TechManagerCTA />
</Layout>
