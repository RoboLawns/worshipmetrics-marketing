---
import Layout from "../layouts/Layout.astro";

const SITE_URL = "https://worshipmetrics.com";
const APP_URL = "https://app.worshipmetrics.com";

const features = [
  {
    title: "Slides from the service plan",
    body: "Songs, lyrics, and announcements flow straight from the plan your team already built in Services. No re-typing the setlist into a second program on Saturday night.",
  },
  {
    title: "Lyrics that follow the arrangement",
    body: "Verses, choruses, and bridges follow the arrangement and key the worship leader picked — change the plan, and the slides change with it.",
  },
  {
    title: "Stage display for the platform",
    body: "A separate stage output with editable layouts gives the band and vocalists lyrics, timers, and cues — without mirroring the audience screen.",
  },
  {
    title: "Backgrounds and layers",
    body: "Media backgrounds, text layers, and clean layouts that a volunteer can run confidently after one walkthrough.",
  },
  {
    title: "One operator, or a team",
    body: "Present runs from the booth alongside Tech Manager, and slides advance with a click — simple enough for a first-time volunteer on a busy Sunday.",
  },
  {
    title: "Connected to the rest of Sunday",
    body: "Because Present lives in the same platform as planning, streaming, and monitoring, the lyrics operator sees the same plan as the stream operator and the band.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WorshipMetrics Present",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Windows, Mac",
  url: `${SITE_URL}/present`,
  description: "Church presentation software built from the service plan: slides, lyrics, backgrounds, and stage display in the same platform as streaming, planning, and monitoring.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${SITE_URL}/pricing`,
  },
};
---

<Layout
  title="Church Presentation Software — Slides, Lyrics & Stage Display"
  socialTitle="WorshipMetrics Present | Lyrics up. Stage covered."
  description="Slides, lyrics, backgrounds, and stage display built straight from the service plan — in the same platform that streams, monitors, and supports your Sunday."
  canonical="/present"
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow inline-flex rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
        Present &middot; Slides &middot; Lyrics &middot; Stage display
      </p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Lyrics up. Stage covered.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Present builds slides, lyrics, and the stage display straight from the service plan your team already made &mdash; in the same platform that streams your service and watches the booth.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="present_hero_sign_up_free" data-wm-track-location="present_hero">Sign up free</a>
        <a href="/services" class="btn-outline">See service planning</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What Present does</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The plan is the presentation.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Every other presentation tool starts from a blank deck. Present starts from the service your team already planned.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {features.map(({ title, body }) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-lg font-bold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ProPresenter positioning -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10 text-center">
      <p class="eyebrow">Already on ProPresenter?</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Keep it, or replace it. Your call.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        If your team loves its current presentation software, WorshipMetrics works alongside it &mdash; the plan, stream, and monitoring still connect. When you&apos;re ready to stop re-typing the setlist into a second program, Present is here.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/why-worship-metrics" class="btn-outline">See how we compare</a>
        <a href="/kb/articles/propresenter-7-advanced-setup/" class="btn-outline">ProPresenter guides in our KB</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-slate-50 p-10 text-center shadow-sm sm:p-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Plan it. Present it. Stream it. Handled.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        One platform carries the whole service &mdash; from the plan to the screens to the stream.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="present_footer_sign_up_free" data-wm-track-location="present_footer">Sign up free</a>
        <a href="/live-streaming" class="btn-outline text-sm">See live streaming</a>
      </div>
    </div>
  </section>
</Layout>
