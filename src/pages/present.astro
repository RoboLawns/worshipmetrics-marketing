---
import Layout from "../layouts/Layout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import PresentLayerStack from "../components/diagrams/PresentLayerStack.astro";
import PresentOutputRouting from "../components/diagrams/PresentOutputRouting.astro";
import PresentStageDisplay from "../components/diagrams/PresentStageDisplay.astro";
import PresentTriggerFan from "../components/diagrams/PresentTriggerFan.astro";
import PresentScriptureStrip from "../components/diagrams/PresentScriptureStrip.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";

const SITE_URL = "https://worshipmetrics.com";
const APP_URL = "https://app.worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-present-slides.jpg`;
const LIFESTYLE_IMAGE = `${R2}/app-2026/lifestyle/presentation.jpg`;

const features = [
  {
    title: "A real slide editor",
    body: "Full 1920×1080 editing with layered items, per-church themes, shrink-to-fit text, and six lyric layouts from Centered Classic to Lower-Third. Section labels carry identity colors — Verse, Chorus, Bridge — so the operator always knows where the song is going.",
  },
  {
    title: "Live video on your slides",
    body: "Capture cards and NDI cameras drop onto slides like any other media — so IMAG, picture-in-picture teaching, and camera-behind-lyrics looks are just another slide, not another system.",
  },
  {
    title: "Scripture to slides in seconds",
    body: "Type a reference and the passage becomes clean slides — six translations included (KJV, ASV, WEB, YLT, Darby, BBE), with verses-per-slide and reference display options. Save it, or append it to the live show mid-service.",
  },
  {
    title: "A media bin that behaves",
    body: "Images and video with fit modes, crop, trim, fades, loop, and per-use audio gain. Up to 250 MB per video upload, organized in folders, with a relink flow when files move.",
  },
  {
    title: "Data-driven overlays",
    body: "Lower thirds, messages, logo bugs, and timer overlays — and overlay fields can bind to a CSV, JSON, or XML source, so names and rosters update themselves row by row.",
  },
  {
    title: "Macros for big moments",
    body: "One click fires a named sequence: change the background, jump to a playlist, show an overlay, start audio, wait, clear — even fire the booth's control protocols. Complex transitions become a single button.",
  },
  {
    title: "Playlists synced to the plan",
    body: "The service plan projects straight into a Present playlist — songs, announcements, countdowns, and media in order, with presentations auto-built from the plan. Arrangements and keys stay in lockstep with the Songs library.",
  },
  {
    title: "Timers, clocks & countdowns",
    body: "Countdown, count-up, and countdown-to-time with warning and overrun colors, plus timezone-aware clocks. Pre-service countdowns and sermon timers, built in.",
  },
  {
    title: "Your brand, everywhere",
    body: "Church brand colors, fonts, and logo flow through templates and themes — and 'Clear to Logo' is always one button away. Every slide looks like your church without a volunteer designing under pressure.",
  },
];

const protocolItems = [
  "OSC over the network for lighting and media servers",
  "RossTalk for Ross production switchers",
  "MIDI — local devices or network MIDI",
  "HTTP requests for anything with an API",
  "OBS Studio via WebSocket, and Q-SYS via QRC",
  "Presets for vMix, Companion, Resolume, ProPresenter, X32/M32, QLab, and disguise",
];

const importItems = [
  "ProPresenter 4–7 (.pro4, .pro5, .pro6, and .pro)",
  "ChordPro charts (.cho, .crd, .chopro)",
  "OpenLyrics and OpenSong libraries",
  "CCLI SongSelect files (.usr)",
  "Plain text — paste and go",
  "The WorshipMetrics Songs library — already connected",
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WorshipMetrics Present",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Windows, Mac",
  url: `${SITE_URL}/present`,
  image: HERO_IMAGE,
  description: "Church presentation software built from the service plan: a full slide editor, scripture-to-slides, media bin, timers, overlays, macros, stage display, second-screen output from the browser, and OSC/RossTalk/HTTP/MIDI triggers.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${SITE_URL}/pricing`,
  },
};
---

<Layout
  title="Worship Presentation Software for Churches"
  socialTitle="WorshipMetrics Present | Modern Presentation, Accessible Everywhere"
  description="Worship presentation software that runs in the browser: slide editor, scripture-to-slides, lyrics, stage display, media, timers, and multi-screen output — built from your service plan."
  canonical="/present"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO_IMAGE} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
      <div>
        <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1 shadow-sm">
          <img src="/images/nav/pillars/present.png" alt="" class="h-7 w-7 rounded-md" /> Present &middot; Slides &middot; Lyrics &middot; Stage display
        </p>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Modern Presentation, Accessible Everywhere
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Lyrics, scripture, slides, and stage display &mdash; built straight from the service plan, not retyped on Saturday night. A full slide editor, a media library with motion backgrounds, timers, and lower thirds, running on the screens you already own. Available 100% in the cloud, so you can make quick changes, and give your team access when and where they want to work.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="present_hero_sign_up_free" data-wm-track-location="present_hero">Sign up free</a>
          <a href="/services" class="btn-outline">See service planning</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">Core presentation is free forever. The full suite unlocks with Assist.</p>
      </div>
      <ImageCarousel
        eager
        slides={[
          { src: LIFESTYLE_IMAGE, alt: "Volunteer running lyrics and slides with WorshipMetrics Present", kind: "lifestyle" },
          { src: HERO_IMAGE, alt: "Present slide grid with playlists, backgrounds library, and live program output in WorshipMetrics" },
        ]}
      />
    </div>
  </section>

  <!-- Plan → Present -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Plan &rarr; Present</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The plan is the presentation.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Every other presentation tool starts from a blank deck and a volunteer re-typing the setlist on Saturday night. Present projects the service plan into a ready playlist &mdash; songs in the right key and arrangement, announcements, and media, in order.
        </p>
        <ul class="mt-8 space-y-3">
          {[
            "The service plan becomes a playlist automatically — no re-typing",
            "The plan changes on Thursday? The playlist re-syncs live, in seconds",
            "Operator tweaks during the service are preserved, not overwritten",
            "Lyrics follow the arrangement and key the worship leader picked in Songs",
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <div class="mt-8">
          <a href="/songs" class="btn-outline">See the Songs library</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={LIFESTYLE_IMAGE} alt="Volunteer running lyrics and slides with WorshipMetrics Present" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Feature grid -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What Present does</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A full presentation engine, not a slide viewer.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {features.map(({ title, body }) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Diagram: scripture in three steps -->
  <section class="bg-white px-4 pt-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Scripture</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A reference in. Slides out.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          No copying from a Bible site, no reformatting someone else&apos;s line breaks. Type the passage, pick how it should break, and it&apos;s on screen &mdash; or saved to your library for next time.
        </p>
      </div>
      <div class="mt-10 overflow-x-auto">
        <div class="min-w-[760px]">
          <PresentScriptureStrip />
        </div>
      </div>
    </div>
  </section>

  <!-- Diagram: the layer stack -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">How a slide is built</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Four layers, painted in order.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Present doesn&apos;t flatten your service into pictures. Every frame is composed live from four independent layers &mdash; so the background can change without touching the lyrics, and an announcement can appear over anything without rebuilding a slide.
        </p>
      </div>
      <div class="mt-12 overflow-x-auto">
        <div class="min-w-[720px]">
          <PresentLayerStack />
        </div>
      </div>
    </div>
  </section>

  <!-- Diagram: one plan, every screen -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">One plan, every screen</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">The same service, told differently on each screen.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          One browser tab drives them all. The projector gets the full picture, the platform gets the words and chords, the lobby gets announcements, and the booth gets a clean key &mdash; each output painting only the layers it should.
        </p>
      </div>
      <div class="mt-12 overflow-x-auto">
        <div class="min-w-[720px]">
          <PresentOutputRouting />
        </div>
      </div>
    </div>
  </section>

  <!-- Outputs: audience + stage -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Program &amp; stage outputs</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Two screens. One click. No capture card.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Pick a monitor and Present opens a borderless, fullscreen output on it &mdash; straight from the browser. The projector gets the program feed; the platform gets a stage display with lyrics, timers, and cues on its own layout. Fade to black, logo, and clear are one button each.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {[
          { title: "Program out", body: "The audience screen: slides, lyrics, media, and overlays, fullscreen on any connected display or projector — each output with its own look and resolution." },
          { title: "Stage out", body: "The confidence monitor: current and next lyrics, notes, live timers, song key — even the chord chart, transposed to the key you're playing in. Its own editable layout, never a mirror." },
          { title: "Browser, booth, or network", body: "Web output needs no install — pick the screen and go. Tech Manager adds NDI output in the booth, and Network Display sends video to remote screens over WebRTC." },
        ].map(({ title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">{title}</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">{body}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 border-t border-slate-200 pt-16">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">What the platform sees</p>
          <h3 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">The stage display, labeled.</h3>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            The confidence monitor is its own layout with its own job: keep the band in the song, in the right key, and on time &mdash; without ever showing them the projector&apos;s picture.
          </p>
        </div>
        <div class="mt-10 overflow-x-auto">
          <div class="min-w-[720px]">
            <PresentStageDisplay />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Protocol triggers -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-2xl sm:p-12">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">Slides that run the room</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">When the slide goes live, the room follows.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
            Attach protocol actions to slides and playlists, and going live fires them across the network &mdash; lights shift for worship, the switcher takes the sermon camera, the stream overlay updates. One volunteer advancing slides quietly runs the whole moment.
          </p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-300">Speaks the booth's languages</p>
          <ul class="mt-6 space-y-3">
            {protocolItems.map((item) => (
              <li class="flex items-start gap-3 text-sm text-slate-200 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-400"></span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-14 border-t border-white/10 pt-14">
        <div class="mx-auto max-w-3xl text-center">
          <h3 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">One click. Five things happen.</h3>
          <p class="mt-4 text-base leading-relaxed text-slate-300">
            A macro is a named sequence attached to a slide. Fire it and the room moves together &mdash; while the volunteer keeps their eyes on the words.
          </p>
        </div>
        <div class="mt-10 overflow-x-auto">
          <div class="min-w-[700px]">
            <PresentTriggerFan />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ProPresenter positioning + import -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl grid gap-8 lg:grid-cols-2">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
        <p class="eyebrow">Already on ProPresenter?</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Keep it, or replace it. Your call.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600">
          If your team loves its current presentation software, WorshipMetrics works alongside it &mdash; the plan, stream, and monitoring still connect. When you&apos;re ready to stop re-typing the setlist into a second program, Present is here.
        </p>
        <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row">
          <a href="/why-worship-metrics" class="btn-outline">See how we compare</a>
          <a href="/kb/articles/propresenter-7-advanced-setup/" class="btn-outline">ProPresenter guides in our KB</a>
        </div>
      </div>
      <div class="rounded-[2rem] border border-indigo-200 bg-indigo-50 p-8 shadow-sm sm:p-10">
        <p class="eyebrow">Bring your library</p>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Import what you&apos;ve already built.</h2>
        <ul class="mt-6 space-y-3">
          {importItems.map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-slate-500">Years of song files and presentations come with you — not left behind.</p>
      </div>
    </div>
  </section>

  <!-- Technical details -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical details</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200">
        {[
          ["Authoring canvas", "1920×1080 with layered media, slide, prop, and announcement layers rendered by one engine across editor, program, and stage"],
          ["Output resolutions", "1280×720, 1920×1080, 1920×1200, 4K UHD (3840×2160), portrait 1080×1920, or custom — with fit, fill, and stretch screen modes"],
          ["Multi-display output", "Multiple program and stage outputs across connected monitors — each with its own look, stage layout, resolution, and audio device"],
          ["Live video inputs", "Capture cards and NDI sources placed on slides as live media for IMAG and picture-in-picture"],
          ["NDI & Network Display", "NDI program output with alpha via the Tech Manager desktop app; Network Display publishes to auto-discovered network screens over WebRTC (H.264, up to 60 fps)"],
          ["Media formats", "Images: JPG, PNG, WebP, GIF, AVIF, SVG, BMP · Video: MP4, WebM, MOV, M4V, MKV · up to 250 MB per video upload, with crop, trim, fade, loop, and gain per use"],
          ["Scripture", "KJV, ASV, WEB, YLT, Darby, and BBE included, with verses-per-slide, verse numbers, and five reference display modes"],
          ["Imports", "ProPresenter 4–7, ChordPro, OpenLyrics, OpenSong, CCLI SongSelect (.usr), and plain text"],
          ["Control protocols", "OSC, RossTalk, MIDI (device and network), HTTP, OBS WebSocket, and Q-SYS QRC — fired from slides or macros, relayed through Tech Manager in the booth"],
          ["Offline resilience", "Edits journal locally and reconcile automatically when the connection returns — a dropped network doesn't drop the service"],
          ["Runs in", "Any Chromium-based browser (Chrome, Edge); multi-monitor output uses the Window Management API"],
        ].map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-[2rem] border border-slate-200 bg-slate-50 p-10 text-center shadow-sm sm:p-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Plan it. Present it. Stream it. Handled.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        One platform carries the whole service &mdash; from the plan to the screens to the stream.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary text-base px-8 py-3.5" data-wm-track="cta_click" data-wm-track-label="present_footer_sign_up_free" data-wm-track-location="present_footer">Sign up free</a>
        <a href="/live-streaming" class="btn-outline text-sm">See live streaming</a>
      </div>
    </div>
  </section>
  <TechManagerCTA />
</Layout>
