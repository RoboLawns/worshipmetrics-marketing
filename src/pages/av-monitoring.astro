---
import Layout from "../layouts/Layout.astro";
import CloudConnectivity from "../components/diagrams/CloudConnectivity.astro";
import PulseNotifications from "../components/diagrams/PulseNotifications.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import TechManagerCTA from "../components/TechManagerCTA.astro";
import PulseEscalation from "../components/diagrams/PulseEscalation.astro";

const APP_URL = "https://app.worshipmetrics.com";
const SITE_URL = "https://worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const HERO_IMAGE = `${R2}/app-2026/screenshots/worship-metrics-pulse-system-health.jpg`;
const MONITOR_IMAGE = `${R2}/app-2026/lifestyle/system-health-monitoring.jpg`;

const features = [
  {
    title: "Full-machine telemetry",
    body: "Every booth PC reports CPU load and temperature, RAM, every disk with its model, GPU and driver version, every display with resolution and refresh rate, audio endpoints with volume and mute state, USB peripherals, and WiFi signal strength.",
  },
  {
    title: "Heartbeats every 15 seconds",
    body: "A light telemetry beat lands every 15 seconds and a full snapshot every minute, so the fleet view is seconds-fresh. A machine earns its offline badge after 90 seconds without one.",
  },
  {
    title: "Monitoring that needs no watcher",
    body: "A server-side fleet watcher scans continuously whether or not anyone has a page open. An outage alerts exactly once per incident — and a dropped connection is caught in about a minute.",
  },
  {
    title: "Red lines that don't cry wolf",
    body: "CPU at 90%, RAM at 90%, disk under 5% free, or CPU at 95°C trips a critical alert. Recovery requires genuinely cooling off, and re-alerts are capped — a flapping machine sends one email, not forty.",
  },
  {
    title: "Stream drop alerts",
    body: "Heartbeats carry bitrate versus target, dropped frames, encoder load, and fps — plus network latency, jitter, and packet loss, and audio silence and clipping detection. If the stream dies mid-service, the alert beats the congregation's text messages.",
  },
  {
    title: "AV gear health, multi-witnessed",
    body: "Cameras, consoles, and switchers flagged for monitoring only alarm when every telemetry machine on the network agrees they're unreachable — one booth's bad network path can never page your whole team falsely.",
  },
  {
    title: "Alerts that reach your phone",
    body: "Real OS notifications by web push — including iPhones with the home-screen app — with email as the guaranteed channel, optional SMS text alerts for the people who live by their texts, and an in-app feed that never misses. You choose channels per person, per alert type.",
  },
  {
    title: "The machine's timeline",
    body: "USB plugged and unplugged, displays changed, software and drivers installed or updated, network up and down, sustained CPU spikes, and every remote action — merged into one filterable per-machine history.",
  },
  {
    title: "Pulse Insights",
    body: "Pattern detection across the whole org surfaces what no single event shows: packet loss over 20%, latency running twice a device's own baseline, the same alert flapping four times in a day, machines gone quiet.",
  },
  {
    title: "Service Metrics & attendance",
    body: "Each week's plan pairs with its recap: in-room attendance from a seat-map counter with reusable templates or a camera auto-count, and online viewers rolled in automatically from the stream.",
  },
];

const observabilityItems = [
  "Real-time stream bitrate, resolution, and frame drop monitoring",
  "Device connectivity status for cameras, switchers, and encoders",
  "Historical health data so you can spot patterns across Sundays",
  "Alerts when stream quality degrades below thresholds you set",
  "A device catalog of 422 ProAV models with factory port maps for monitoring setup",
  "A live Alerts feed — device offline, resource criticals, stream drops — with full history",
  "Service Metrics that tie system health to each individual service",
  "One dashboard that replaces the pile of separate monitoring tools",
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WorshipMetrics AV Monitoring",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, Windows, Mac",
  url: `${SITE_URL}/av-monitoring`,
  image: HERO_IMAGE,
  description: "Real-time stream health monitoring, system status dashboards, and booth observability built into WorshipMetrics. Know your AV system is healthy before the service starts.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: `${SITE_URL}/pricing`,
  },
};
---

<Layout
  title="Church AV Monitoring & Stream Health"
  socialTitle="WorshipMetrics AV Monitoring & Stream Health — Diagnose"
  description="Real-time stream health monitoring, system status dashboards, and booth observability built into WorshipMetrics. Know your AV system is healthy before the service starts."
  canonical="/av-monitoring"
  ogImage={HERO_IMAGE}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO_IMAGE} />
  </Fragment>

  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
      <div>
        <p class="eyebrow flex items-center gap-2"><img src="/images/nav/pillars/pulse.png" alt="" class="h-9 w-9 rounded-lg" /> Pulse</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Professional AV Monitoring.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Pulse monitors every machine, device, and stream 24/7 &mdash; free forever. Alerts reach you the moment something drifts, often before anyone in the room notices. It&apos;s the reason our support can immediately help you with detailed advice to get to the bottom of any issue.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={`${APP_URL}/sign-up`} class="btn-primary" data-wm-track="cta_click" data-wm-track-label="av_monitoring_hero_get_started_free" data-wm-track-location="av_monitoring_hero">Get started free</a>
          <a href="/tech-manager" class="btn-outline">See Tech Manager</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">Stream health monitoring is included in Tech Manager.</p>
      </div>

      <ImageCarousel
        eager
        slides={[
          { src: MONITOR_IMAGE, alt: "Church tech director monitoring system health with WorshipMetrics", kind: "lifestyle" },
          { src: HERO_IMAGE, alt: "Pulse system health dashboard monitoring every machine in WorshipMetrics" },
        ]}
      />
    </div>
  </section>

  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">What it monitors</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">One dashboard for everything that keeps your service running.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          AV Monitoring gives you visibility into your livestream, your connected devices, and your overall system health. The same tool that runs the service also watches it.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {features.map(({ title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">{title}</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Booth observability</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Stop checking each piece of gear individually.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Most church AV teams verify their setup by walking around the booth and checking each device one at a time. AV Monitoring surfaces the status of every connected camera, switcher, encoder, and integration in a single dashboard that updates in real time.
        </p>
        <ul class="mt-8 space-y-3">
          {observabilityItems.map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/tech-manager" class="btn-primary">Download Tech Manager</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={MONITOR_IMAGE} alt="System monitoring and control panels in WorshipMetrics" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Diagram: where a hundred issues go -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Where the problems go</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Most issues never reach a human. That&apos;s the point.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Monitoring isn&apos;t there to give your team more alerts to read &mdash; it&apos;s there to make most problems disappear before Sunday, and to hand the rest to someone who already knows what happened.
        </p>
      </div>
      <div class="mt-12 md:overflow-x-auto">
        <div class="md:min-w-[760px]">
          <PulseEscalation />
        </div>
      </div>
    </div>
  </section>

  <!-- Pulse feeds support -->
  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-indigo-200 bg-indigo-50 p-8 shadow-sm sm:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">When Pulse sees it, support already knows</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Monitoring and tech support are one system.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
            Everything Pulse watches flows straight into support. Call 910-WORSHIP or open a chat, and the AI is already looking at the same live telemetry your dashboard shows &mdash; every device, every alert, and the health history leading up to the problem. No re-explaining, no starting from scratch.
          </p>
        </div>
        <div class="flex flex-col items-start gap-4 lg:items-end">
          <a href="/phone-support" class="btn-primary">How our support works</a>
          <a href="tel:+19109677447" class="btn-outline">Call 910-WORSHIP</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img src={HERO_IMAGE} alt="Stream quality monitoring in WorshipMetrics" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">Prove your AV is serving the mission</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Data that helps you make the case for better gear.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          When you can show leadership that your stream dropped three times last month and attendance dipped on those same Sundays, the conversation changes. AV Monitoring gives you the data to justify upgrades, plan installs, and prove that your AV investment is serving the mission.
        </p>
        <ul class="mt-8 space-y-3">
          {[
            "Historical stream health data across weeks and months",
            "Correlate technical issues with attendance and engagement trends",
            "Build a data-backed case for equipment upgrades and system improvements",
            "Show your leadership what your team is managing every Sunday",
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 sm:text-base"><span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-indigo-500"></span><span>{item}</span></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="/pilot-program" class="btn-primary">Start your pilot</a>
          <a href="/your-av-partner" class="btn-outline">See AV Partner services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">How it works</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Three ways to keep eyes on your system.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {[
          {
            title: "Real-time",
            body: "Watch stream bitrate, frame drops, and device status during the service. Red flags surface before they become visible problems.",
          },
          {
            title: "Pre-service",
            body: "Run a health check before the room fills up. Confirm every camera, encoder, and integration is connected and reporting.",
          },
          {
            title: "Historical",
            body: "Review stream performance across Sundays. Spot patterns, correlate issues with attendance dips, and plan maintenance windows.",
          },
        ].map(({ title, body }) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-600">{title}</p>
            <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-2xl sm:p-12">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">Attendance + stream health together</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">See how your stream quality actually affects who shows up.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
          Most churches track attendance and stream quality in two completely separate tools. WorshipMetrics brings them together so you can see the real relationship between technical quality and online engagement.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
          <a href="/platform/attendance" class="btn-primary">See Attendance</a>
          <a href={`${APP_URL}/sign-up`} class="btn-outline" style="border-color:rgba(255,255,255,0.16);color:#fff;">Get started free</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Know before they text you.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Stop finding out about stream problems from the people watching at home. Monitor your system health, protect your online reach, and walk into Monday with real data about how Sunday actually went.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary" data-wm-track="cta_click" data-wm-track-label="av_monitoring_footer_get_started_free" data-wm-track-location="av_monitoring_footer_cta">Get started free</a>
        <a href="/discovery-call" class="btn-outline" data-wm-track="cta_click" data-wm-track-label="av_monitoring_footer_book_call" data-wm-track-location="av_monitoring_footer_cta">Book a demo</a>
        <a href="/pilot-program" class="btn-outline">Start your pilot</a>
      </div>
    </div>
  </section>
  <!-- Technical details -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Technical details</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">For the person who reads the spec sheet.</h2>
      </div>
      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white">
        {[
          ["Telemetry cadence", "Light heartbeat every 15 s over an encrypted WebSocket (HTTPS fallback), full hardware snapshot every 60 s, adaptive on-machine polling between beats"],
          ["Offline thresholds", "Online badge flips after 90 s (three missed beats); alert email after 5 minutes of silence; a dropped connection is caught in ~60 s; signage screens alert at 30 minutes"],
          ["Resource red lines", "CPU ≥ 90%, RAM ≥ 90%, disk ≤ 5% free, CPU temp ≥ 95°C — with hysteresis recovery (85% / 85% / 8% / 92°C) and a 30-minute re-alert cooldown per machine"],
          ["Alert types", "Device offline, AV device offline, resource critical, audio state, and livestream drop — three severities across six filterable areas (Hardware, System, Stream, Audio, Network, Other)"],
          ["Delivery channels", "Email (guaranteed), optional SMS text alerts, web push notifications — including iOS 16.4+ home-screen app — in-app feed, desktop toast, and live page updates"],
          ["Machine telemetry", "CPU load/temp/clocks, RAM, per-disk storage with drive model, GPU and driver version, displays (resolution, refresh, HDR, rotation), audio endpoints, USB peripherals, network adapters and WiFi signal"],
          ["Stream telemetry", "Bitrate vs target, dropped-frame %, encoder load, fps, scene, resolution, reconnect count — plus upload/download, latency, jitter, packet loss, and audio silence/clipping flags"],
          ["AV device health", "Multi-observer rollup with online / degraded / stale / offline / unknown states — offline requires every fresh observer to agree, so one bad network path never false-alarms"],
          ["Anti-spam mechanics", "One alert per outage by atomic claim, re-armed on recovery; hysteresis margins, per-machine cooldowns, and fan-out caps keep a flapping device to a single page"],
          ["Software inventory", "Hourly software and driver collection from the system registry, with graphics-driver currency checked daily"],
          ["History retention", "Alert history 90 days, device metrics 30 days, observations and timeline non-events 7 days"],
          ["Attendance counting", "Seat-map counter with reusable templates (sections, rows, member-assignable seats) and camera auto-count from RTSP or webcam — schedulable, or triggered remotely from the web"],
        ].map(([term, detail], index) => (
          <div class={`grid gap-1 px-6 py-4 sm:grid-cols-[minmax(0,0.32fr)_minmax(0,0.68fr)] sm:gap-6 ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
            <p class="text-sm font-semibold text-slate-900">{term}</p>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Notifications -->
  <section class="bg-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Notifications</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Saturday night, your phone already knows.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Pulse doesn&apos;t wait to be checked. A pre-flight check-in lands every Saturday evening &mdash; &ldquo;everything looks right for Sunday&rdquo; &mdash; and if a device goes quiet overnight, the message says so and suggests coming in early. Email is included on every plan; add SMS text alerts for the people who live by their texts.
        </p>
      </div>
      <div class="mt-10 md:overflow-x-auto">
        <div class="md:min-w-[760px]">
          <PulseNotifications />
        </div>
      </div>
    </div>
  </section>

  <!-- Cloud connectivity -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Connected through the cloud</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Watched from anywhere. Fixed from anywhere.</h2>
      </div>
      <div class="mt-10 md:overflow-x-auto">
        <div class="md:min-w-[760px]">
          <CloudConnectivity
            users={[
              { device: "phone", role: "The tech director", action: "Gets the alert first", where: "Anywhere" },
              { device: "laptop", role: "The volunteer", action: "Checks the Signal Map", where: "From home" },
              { device: "laptop", role: "Journey & our team", action: "Sees your system on a call", where: "910-WORSHIP" },
            ]}
            churchTitle="Every device"
            churchLines={["Machines, streams, and cables", "watched 24/7 — free forever."]}
            footnote="Most issues clear before anyone in the room notices — that is the point of a connected system."
            ariaJob="watch the AV system from anywhere"
          />
        </div>
      </div>
    </div>
  </section>

  <TechManagerCTA />
</Layout>
