---
import Layout from "../layouts/Layout.astro";
import FoundersStrip from "../components/FoundersStrip.astro";

const APP_URL = "https://app.worshipmetrics.com";
const R2 = "https://pub-a4845709a76642e7943bcb8b80677531.r2.dev/main";
const CLUB_IMAGE = `${R2}/app-2026/lifestyle/team-collaboration.jpg`;
const OG_IMAGE = "/images/av-club/reels-clipping-specialist.jpg";

// The roles the platform makes real — each one a place to serve.
const roles = [
  {
    title: "Reels & social clips",
    body: "Finds Sunday's best moments and has them shared before Monday — the role social-native students are already good at.",
    img: "/images/av-club/reels-clipping-specialist.jpg",
    alt: "A student reviewing AI-suggested worship clips in WorshipMetrics Reels at the booth",
    href: "/solutions/worship-clips",
  },
  {
    title: "Stream operator",
    body: "Starts the broadcast, watches stream health, and gets the service to everyone who couldn't be in the room.",
    img: "/images/av-club/stream-operator.jpg",
    alt: "A volunteer managing the live stream in WorshipMetrics",
    href: "/live-streaming",
  },
  {
    title: "Service director",
    body: "Runs the plan and keeps the whole team moving together — the coordination role every Sunday needs.",
    img: "/images/av-club/service-director.jpg",
    alt: "A service director following the run-of-show in WorshipMetrics",
    href: "/services",
  },
  {
    title: "PTZ camera operator",
    body: "Frames the shot with a joystick, a gamepad, or a click — real responsibility a fourteen-year-old can be handed.",
    img: "/images/av-club/camera-operator.jpg",
    alt: "A young camera operator controlling PTZ cameras in WorshipMetrics",
    href: "/tech-manager",
  },
  {
    title: "Lyrics operator",
    body: "Keeps the words on the screen and the congregation singing — the classic first job in the booth.",
    img: "/images/av-club/lyrics-operator.jpg",
    alt: "A volunteer running worship lyrics in WorshipMetrics Present",
    href: "/church-lyrics-software",
  },
  {
    title: "Audio engineer",
    body: "Mixes the room and the stream with meters everyone can read — and a system that's finally documented.",
    img: "/images/av-club/audio-engineer.jpg",
    alt: "A volunteer audio engineer mixing a service with WorshipMetrics beside the console",
    href: "/av-team",
  },
  {
    title: "Lighting operator",
    body: "Shifts the room for worship and the word — slides can even fire the lighting cues themselves.",
    img: "/images/av-club/lighting-operator.jpg",
    alt: "A volunteer lighting operator during a worship service",
    href: "/present",
  },
  {
    title: "Video switcher operator",
    body: "Cuts between cameras and takes the moment live — with local control free, and a trusted helper able to watch from anywhere.",
    img: "/images/lifestyle/church-production-booth-live.jpg",
    alt: "A booth operator switching a live service with WorshipMetrics beside OBS",
    href: "/cloud-control",
  },
];
---

<Layout
  title="Why We Built WorshipMetrics"
  socialTitle="WorshipMetrics | Why we built this."
  description="The inspiration behind WorshipMetrics: too many dysfunctional AV systems, too many burned-out volunteers, and a generation that was never invited into the booth. A letter from co-founder Paul Richards."
  canonical="/why-we-built-this"
  ogImage={OG_IMAGE}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-50 via-white to-white px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-4 py-1 shadow-sm">The inspiration</p>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Why we built WorshipMetrics.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Every product page on this site describes <em>what</em> the platform does. This page is the reason it exists &mdash; in the words of the person who spent twelve years watching the problem from the back of the room.
      </p>
    </div>
  </section>

  <!-- The letter -->
  <section class="bg-white px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-12">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600">A letter from Paul</p>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-slate-700">
        <p>
          Too many times, I have stood in the back of a sanctuary and watched a dysfunctional AV system fight the very people trying to serve through it. Cables nobody could trace. Software nobody was trained on. One faithful volunteer holding all of it together, quietly burning out, because they didn&apos;t have the tools to organize what they&apos;d inherited &mdash; and no way to hand any of it to someone else.
        </p>
        <p>
          And too many times, I have seen the same church&apos;s youth ministry and AV team living in separate worlds &mdash; a booth that needed hands, and a generation full of them, never introduced to each other.
        </p>
        <p>
          We created WorshipMetrics, in part, to close that gap: to make opportunities to serve that are <strong>functional</strong> &mdash; that actually work on Sunday &mdash; and that give people real-world skills and real joy, instead of volunteer burnout. Serving on the AV team should be fun and exciting, even for a small, growing team. <em>Especially</em> for a small, growing team.
        </p>
        <p>
          That takes a foundation. When everything is connected &mdash; the plan, the songs, the slides, the cameras, the stream, the system itself &mdash; a small team can suddenly offer real roles: social media clipping, stream management, team coordination, PTZ camera operator, lyrics manager, slide presentation, song management, video switching. Every one of those is a place where somebody can stand on a Sunday morning and matter.
        </p>
        <p>
          Some of our customers have taken it further and created <strong>AV broadcast clubs</strong> inside their churches &mdash; engaging their youth and bringing them into church through technology that can be managed and steered toward good. I think that&apos;s one of the biggest opportunities in front of the church today: giving the next generation of our leaders a positive way to serve their community, in a language that makes sense to them.
        </p>
        <p>
          That&apos;s the inspiration. The platform is how we&apos;re building it.
        </p>
      </div>
      <div class="mt-10 border-t border-slate-200 pt-8">
        <p class="text-lg text-slate-700">Sincerely,</p>
        <p class="mt-2 text-2xl font-bold text-slate-900">Paul Richards</p>
        <p class="mt-1 text-sm text-slate-500">Co-founder &middot; Educator &amp; Onboarding Lead &middot; still answering <a href="tel:+19109677447" class="font-semibold text-indigo-600 hover:text-indigo-800">910-WORSHIP</a> himself</p>
      </div>
    </div>
  </section>

  <!-- The roles -->
  <section class="bg-slate-50 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">What that looks like in practice</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">A booth full of first jobs.</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          When the tools are connected and roles are real, one overloaded position becomes many places to serve &mdash; each one small enough to learn in a week and meaningful enough to come back for.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {roles.map(({ title, body, img, alt, href }) => (
          <a href={href} class="group flex flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md">
            <img src={img} alt={alt} loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-base font-bold text-slate-900">{title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{body}</p>
              <p class="mt-3 text-sm font-semibold text-indigo-600 group-hover:text-indigo-800">Learn more &rarr;</p>
            </div>
          </a>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-slate-500">
        Roles run on <a href="/av-team" class="font-semibold text-indigo-600 hover:text-indigo-800">role-based AV team panels</a> &mdash; each volunteer sees only the controls their job needs, so they&apos;re useful on their first Sunday, not their fifth.
      </p>
    </div>
  </section>

  <!-- AV broadcast clubs -->
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-300">The bigger opportunity</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Some churches turn the booth into a club.</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
            An AV broadcast club is a youth ministry that happens to produce a service. Students learn cameras, switching, audio, streaming, and clipping &mdash; real skills that follow them into school and work &mdash; while the church gains a team that actually wants to be there.
          </p>
          <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
            Technology is going to shape the next generation either way. Inside the church, it can be managed, mentored, and steered toward good &mdash; and the students who hover near the booth become the leaders who run it.
          </p>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap">
            <a href="/av-club" class="btn-primary" data-wm-track="cta_click" data-wm-track-label="why_page_avclub" data-wm-track-location="why_page">See the AV Club</a>
            <a href="/volunteers" class="btn-ghost-dark">See Volunteers</a>
            <a href="/av-team" class="btn-ghost-dark">See the AV team panels</a>
          </div>
        </div>
        <div class="overflow-hidden rounded-[1.75rem] border border-white/10 shadow-2xl">
          <img src={CLUB_IMAGE} alt="A church AV team of adults and students working a service together" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- The rest of the story -->
  <FoundersStrip
    variant="light"
    eyebrow="The rest of the story"
    heading="This page is the why. The story has the how."
    body="Forty years of Sundays between three friends — a pastor, an engineer, and an AV educator — and the road that led them home. If this page resonated, the full story is worth the read."
    linkLabel="Read our story"
  />

  <!-- Final CTA -->
  <section class="bg-indigo-600 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Give somebody a place to stand on Sunday.</h2>
      <p class="mx-auto mt-4 max-w-3xl text-base leading-relaxed text-indigo-100 sm:text-lg">
        Start free, define the first roles, and watch what happens when serving is functional, fun, and shared. If you want to talk it through first, call &mdash; you&apos;ll get Paul.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
        <a href={`${APP_URL}/sign-up`} class="btn-primary" style="background:#fff;color:#4361ee;box-shadow:0 10px 30px rgba(15,23,42,0.18);" data-wm-track="cta_click" data-wm-track-label="why_page_start_free" data-wm-track-location="why_page_footer">Get started free</a>
        <a href="tel:+19109677447" class="btn-outline" style="border-color:rgba(255,255,255,0.35);color:#fff;">Call 910-WORSHIP</a>
      </div>
    </div>
  </section>
</Layout>
