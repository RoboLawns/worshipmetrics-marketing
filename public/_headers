/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://static.cloudflareinsights.com; script-src-elem 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://static.cloudflareinsights.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://static.cloudflareinsights.com https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://calendar.app.google https:; media-src 'self' blob: https:; worker-src 'self' blob:;

# SEP-1649 MCP server card (agent discovery). CORS-open because the document is
# public by definition and browser-hosted agents read it cross-origin. Static
# twin of the dynamic card on app.worshipmetrics.com (WorshipMetricscom
# server/mcp-routes.ts, WM-858) — the endpoint inside points there, where the
# actual MCP server runs.
/.well-known/mcp/server-card.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Agent Skills discovery (cloudflare/agent-skills-discovery-rfc v0.2.0): the
# index lists the skills this site publishes with a SHA-256 digest of each
# artifact's exact bytes; /skills/ holds the artifacts (kept -text in
# .gitattributes so checkouts never alter the digested bytes). CORS-open and
# cached like the other discovery documents above.
/.well-known/agent-skills/index.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/skills/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
